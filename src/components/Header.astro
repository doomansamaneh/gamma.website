---
import { navigation } from "../data/navigation";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="صفحه اصلی دومان سامانه">
      <span class="brand-mark" aria-hidden="true">د</span>
      <span>دومان سامانه</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span class="sr-only">باز کردن منو</span>
      <span aria-hidden="true">منو</span>
    </button>

    <nav id="site-navigation" aria-label="ناوبری اصلی">
      <ul class="main-menu">
        {
          navigation.map((item) => (
            <li
              class:list={{ "has-children": item.children }}
              data-menu-item={item.children ? item.label : undefined}
            >
              {item.children ? (
                <>
                  <button
                    class="menu-trigger"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`${item.label}-submenu`}
                  >
                    {item.label}
                    <span class="chevron" aria-hidden="true" />
                  </button>
                  <div
                    class:list={{
                      submenu: true,
                      "products-menu": item.label === "محصولات",
                    }}
                    id={`${item.label}-submenu`}
                    hidden
                  >
                    {item.label === "محصولات" && (
                      <p class="submenu-heading">محصولات دومان سامانه</p>
                    )}
                    <ul>
                      {item.children.map((child) => (
                        <li>
                          <a href={child.href}>
                            {item.label === "محصولات" && (
                              <span
                                class="product-image-placeholder"
                                aria-hidden="true"
                              >
                                تصویر
                              </span>
                            )}
                            <span class="submenu-copy">
                              <span class="submenu-title">{child.label}</span>
                              {child.description && (
                                <span class="submenu-description">
                                  {child.description}
                                </span>
                              )}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          ))
        }
        <li>
          <a class="button button--accent" href="/contact/demo/">درخواست دمو</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 0.0625rem solid var(--color-line);
    background: rgba(247, 248, 246, 0.94);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: white;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-menu > li {
    position: relative;
  }

  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .menu-trigger:hover {
    color: var(--color-ink);
  }

  .chevron {
    width: 0.45rem;
    height: 0.45rem;
    border-inline-end: 0.1rem solid currentColor;
    border-block-end: 0.1rem solid currentColor;
    transform: rotate(45deg) translateY(-0.1rem);
    transition: transform var(--transition-fast);
  }

  .has-children[data-open="true"] .chevron {
    transform: rotate(225deg) translate(-0.1rem, -0.1rem);
  }

  .submenu {
    position: absolute;
    inset-block-start: 2.5rem;
    inset-inline-start: 50%;
    min-width: 22rem;
    padding: 1rem;
    border: 0.0625rem solid var(--color-line);
    background: var(--color-surface);
    box-shadow: none;
  }

  .submenu[hidden] {
    display: none;
  }

  .products-menu {
    position: fixed;
    inset-block-start: 4.75rem;
    inset-inline: 1rem;
    width: min(64rem, calc(100vw - 2rem));
    margin-inline: auto;
    transform: none;
  }

  .submenu-heading {
    margin-block: 0 1rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .products-menu ul {
    display: grid;
    gap: 0;
  }

  .submenu li {
    min-width: 0;
  }

  .submenu a {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    gap: 1rem;
    padding-block: 0.85rem;
    border-block-end: 0.0625rem solid var(--color-line);
    text-align: start;
  }

  .products-menu li:last-child a {
    border-block-end: 0;
  }

  .submenu a:hover {
    color: var(--color-ink);
  }

  .product-image-placeholder {
    display: grid;
    width: 5.5rem;
    height: 3.5rem;
    flex: 0 0 5.5rem;
    place-items: center;
    border: 0.0625rem dashed var(--color-line);
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .submenu-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.2rem;
    text-align: start;
  }

  .submenu-title {
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 800;
    text-align: start;
  }

  .submenu-description {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.7;
    text-align: start;
  }

  .submenu:not(.products-menu) {
    inset-inline-start: 0;
    width: 24rem;
  }

  .submenu:not(.products-menu) ul {
    display: grid;
    gap: 0.25rem;
  }

  .submenu:not(.products-menu) a {
    min-height: 0;
    padding-block: 0.7rem;
  }

  nav a {
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-ink);
  }

  nav .button {
    color: white;
  }

  .menu-toggle,
  .sr-only {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .menu-toggle {
      display: inline-flex;
      min-height: 2.75rem;
      padding: 0.5rem 0.75rem;
      border: 0.0625rem solid var(--color-line);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-ink);
      font: inherit;
      font-size: 0.875rem;
      font-weight: 700;
    }

    nav {
      display: none;
      position: absolute;
      inset: 4.75rem 0 auto;
      padding: 1rem;
      border-bottom: 0.0625rem solid var(--color-line);
      background: var(--color-paper);
    }

    nav[data-open="true"] {
      display: block;
    }

    nav ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0.25rem;
      margin-inline: auto;
      max-width: var(--container-width);
    }

    .main-menu > li {
      position: static;
    }

    .submenu,
    .submenu:not(.products-menu),
    .products-menu {
      position: static;
      width: auto;
      min-width: 0;
      transform: none;
      padding: 0 0.75rem 0.5rem;
      border: 0;
      box-shadow: none;
    }

    .main-menu > li > a,
    .menu-trigger {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem;
    }

    .products-menu ul {
      display: grid;
      grid-template-columns: 1fr;
    }

    .submenu a {
      min-height: 0;
    }

    .product-image-placeholder {
      width: 4.5rem;
      flex-basis: 4.5rem;
    }

    nav a {
      display: block;
      padding: 0.75rem;
    }

    nav .button {
      text-align: center;
    }
  }

  @media (min-width: 48rem) {
    .site-header {
      position: relative;
      z-index: 1;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const navigation = document.querySelector<HTMLElement>("#site-navigation");
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menuItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-menu-item]"),
  );

  const setActiveMenu = (activeItem: HTMLElement | null) => {
    menuItems.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".menu-trigger");
      const submenu = item.querySelector<HTMLElement>(".submenu");
      const isActive = item === activeItem;
      item.dataset.open = String(isActive);
      trigger?.setAttribute("aria-expanded", String(isActive));
      if (submenu) submenu.hidden = !isActive;
    });
  };

  menuItems.forEach((item) => {
    item
      .querySelector<HTMLButtonElement>(".menu-trigger")
      ?.addEventListener("click", () => {
        setActiveMenu(item.dataset.open === "true" ? null : item);
      });
  });

  menuToggle?.addEventListener("click", () => {
    const isOpen = navigation?.dataset.open === "true";
    navigation?.setAttribute("data-open", String(!isOpen));
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    if (isOpen) setActiveMenu(null);
  });

  document.addEventListener("click", (event) => {
    if (!header?.contains(event.target as Node)) setActiveMenu(null);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setActiveMenu(null);
      navigation?.setAttribute("data-open", "false");
      menuToggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>
