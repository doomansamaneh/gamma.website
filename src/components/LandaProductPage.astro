---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductLogo from "./brand/ProductLogo.astro";
import SectionHeading from "./common/SectionHeading.astro";

const capabilityGroups = [
  {
    title: "حسابداری آنلاین",
    items: [
      "ایجاد خودکار سرفصل‌ها و اسناد حسابداری",
      "ترازنامه، تراز آزمایشی و صورت سود و زیان",
      "مرور حساب‌ها و گزارش دفتر روزنامه و کل",
      "گزارش‌های مالی لحظه‌ای و قابل چاپ",
    ],
  },
  {
    title: "خرید و فروش آنلاین",
    items: [
      "ایجاد پیش فاکتور و تبدیل به فاکتور",
      "ارسال فاکتور برای مشتری",
      "مشاهده مانده فاکتورها",
      "گزارش خرید و فروش و کالاهای پرفروش",
    ],
  },
  {
    title: "دریافت و پرداخت",
    items: [
      "ثبت سریع دریافت‌ها و پرداخت‌ها",
      "اتصال دریافت و پرداخت به فاکتورها",
      "انتقال وجه بین بانک‌ها و صندوق‌ها",
      "ثبت هزینه‌های جاری و تشکیلاتی",
    ],
  },
  {
    title: "گزارش‌های مدیریتی و عملیاتی",
    items: [
      "داشبورد و پیشخوان مدیریتی",
      "صورت سود و زیان و مقایسه با سال قبل",
      "نسبت‌های مالی مانند نسبت جاری",
      "گزارش فروش، هزینه، دریافت و پرداخت",
    ],
  },
  {
    title: "حقوق و دستمزد آنلاین",
    items: [
      "تعریف و مدیریت پرسنل",
      "ثبت سند حقوق و دستمزد",
      "دریافت فایل بیمه و مالیات حقوق",
      "ایجاد فیش حقوقی",
    ],
  },
  {
    title: "سامانه مودیان",
    items: [
      "ارسال فاکتور به سامانه مودیان",
      "برگشت از فروش و اصلاح فاکتورها",
      "ارسال الگوی پیمانکاری",
    ],
  },
  {
    title: "فروشگاه اینترنتی و API",
    items: [
      "ثبت سفارش‌های فروشگاه اینترنتی",
      "همگام‌سازی کالاها، خدمات و مشتریان",
    ],
  },
  {
    title: "اطلاعات پایه حسابداری",
    items: [
      "تعریف کالا و گروه کالا",
      "تعریف صندوق و حساب‌های بانکی",
      "مدیریت اشخاص و مخاطبان",
      "تعریف و اصلاح حساب‌های کل و معین",
    ],
  },
];

const benefits = [
  {
    title: "آنلاین و ابری",
    text: "دسترسی به حسابداری و امور مالی از طریق مرورگر و دستگاه‌های مختلف.",
  },
  {
    title: "ساده و سریع",
    text: "تمرکز بر ساده‌سازی عملیات روزمره حسابداری و مالی.",
  },
  {
    title: "همیشه در دسترس",
    text: "مدیریت حسابداری و امور مالی از هر مکان و با هر دستگاه، بدون نصب نرم افزار.",
  },
  {
    title: "مناسب کسب و کارهای کوچک و متوسط",
    text: "راهکاری برای کسب و کارهایی که به مدیریت ساده و یکپارچه امور مالی نیاز دارند.",
  },
];
---

<BaseLayout
  title="نرم افزار حسابداری آنلاین لاندا | دومان سامانه"
  description="لاندا، نرم افزار حسابداری آنلاین و ابری برای کسب و کارهای کوچک و متوسط؛ ساده، سریع و در دسترس از طریق مرورگر و دستگاه‌های مختلف."
>
  <main>
    <section class="landa-hero">
      <div class="container landa-hero-grid">
        <div class="landa-hero-content">
          <a class="breadcrumb" href="/products/">محصولات / لاندا</a>
          <h1>لاندا؛ حسابداری آنلاین برای کسب و کارهای کوچک و متوسط</h1>
          <p class="hero-copy">
            لاندا یک نرم افزار حسابداری آنلاین و ابری است که مدیریت حسابداری و
            امور مالی کسب و کار را ساده، سریع و در دسترس می‌کند.
          </p>
          <div class="actions">
            <a
              class="button button--accent"
              href="https://landa-sme.ir/"
              target="_blank"
              rel="noopener noreferrer">ورود به سایت لاندا ↗</a
            >
            <a class="text-link" href="#capabilities"
              >آشنایی با امکانات <span aria-hidden="true">←</span></a
            >
          </div>
        </div>

        <div
          class="landa-hero-visual"
          aria-label="نمایی از نرم افزار حسابداری لاندا"
        >
          <div class="visual-rule" aria-hidden="true"></div>
          <ProductLogo product="landa" class="landa-logo" />
          <img
            src="https://landa-sme.ir/images/front/homepage-img-1.png"
            alt="نمایی از محیط نرم افزار حسابداری آنلاین لاندا"
            width="800"
            height="520"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="content-section introduction" aria-labelledby="intro-title">
      <div class="container narrow-content">
        <SectionHeading
          id="intro-title"
          title="حسابداری ساده‌تر برای کسب و کارهای کوچک و متوسط"
        />
        <p>
          لاندا حسابداری و مدیریت مالی را به‌صورت آنلاین و ابری ارائه می‌کند.
          کسب و کارها می‌توانند امور مالی خود را بدون نصب نرم افزار حسابداری
          سنتی و از طریق مرورگر مدیریت کنند.
        </p>
      </div>
    </section>

    <section class="content-section benefits" aria-labelledby="benefits-title">
      <div class="container">
        <SectionHeading
          id="benefits-title"
          title="مدیریت مالی در دسترس و ساده"
        />
        <div class="benefits-grid">
          {
            benefits.map((benefit) => (
              <article class="benefit-item">
                <h3>{benefit.title}</h3>
                <p>{benefit.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="content-section capabilities"
      id="capabilities"
      aria-labelledby="capabilities-title"
    >
      <div class="container">
        <SectionHeading
          id="capabilities-title"
          title="امکانات و قابلیت‌ها"
          description="ابزارهای مورد نیاز برای حسابداری و مدیریت مالی کسب و کار، در یک سامانه آنلاین."
        />
        <div class="capability-grid">
          {
            capabilityGroups.map((group) => (
              <article class="capability-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="content-section why-landa" aria-labelledby="why-title">
      <div class="container narrow-content">
        <SectionHeading
          id="why-title"
          title="یک راهکار آنلاین برای مدیریت امور مالی"
        />
        <p>
          لاندا برای کسب و کارهای کوچک و متوسط طراحی شده است تا فروش، خرید،
          هزینه، دریافت، پرداخت و سود کسب و کار را ساده‌تر مدیریت کنند. دسترسی
          ابری و بدون نیاز به نصب، امکان استفاده از حسابداری را در هر زمان و از
          هر مکان فراهم می‌کند.
        </p>
      </div>
    </section>

    <section
      class="content-section product-experience"
      aria-labelledby="experience-title"
    >
      <div class="container experience-grid">
        <div class="experience-copy">
          <SectionHeading
            id="experience-title"
            title="حسابداری ابری، بدون پیچیدگی‌های حسابداری سنتی"
          />
          <p>
            با لاندا می‌توانید حسابداری و امور مالی کسب و کار خود را هر زمان، از
            هر مکان و با هر دستگاه مدیریت کنید.
          </p>
        </div>
        <figure>
          <img
            src="https://landa-sme.ir/images/front/homepage-img-1.png"
            alt="داشبورد نرم افزار حسابداری آنلاین لاندا"
            width="800"
            height="520"
            loading="lazy"
          />
          <figcaption>نمایی از محیط نرم افزار حسابداری آنلاین لاندا</figcaption>
        </figure>
      </div>
    </section>

    <section class="content-section audience" aria-labelledby="audience-title">
      <div class="container narrow-content">
        <SectionHeading
          id="audience-title"
          title="لاندا برای چه کسب و کارهایی مناسب است؟"
        />
        <p>
          لاندا برای کسب و کارهای کوچک و متوسطی مناسب است که می‌خواهند حسابداری
          آنلاین و ابری داشته باشند و فروش، خرید، هزینه، دریافت، پرداخت، گزارش و
          صورتحساب الکترونیکی خود را مدیریت کنند.
        </p>
      </div>
    </section>

    <!-- <section
      class="content-section company-relation"
      aria-labelledby="relation-title"
    >
      <div class="container narrow-content">
        <SectionHeading
          id="relation-title"
          title="لاندا یکی از محصولات دومان سامانه است"
        />
        <p>
          لاندا یکی از محصولات دومان سامانه است که با تمرکز بر حسابداری و مدیریت
          مالی کسب و کارهای کوچک و متوسط توسعه یافته است.
        </p>
        <a class="text-link" href="/company/about/">آشنایی با دومان سامانه ←</a>
      </div>
    </section> -->

    <section
      class="content-section product-experience"
      aria-labelledby="landa-cta-title"
    >
      <div class="container narrow-content">
        <h2 id="landa-cta-title">لاندا را بیشتر بشناسید</h2>
        <p>
          برای مشاهده امکانات، ثبت نام و تجربه رایگان نرم افزار حسابداری آنلاین
          لاندا به سایت رسمی محصول مراجعه کنید.
        </p>
        <a
          class="button button--accent"
          href="https://landa-sme.ir/"
          target="_blank"
          rel="noopener noreferrer">ورود به سایت لاندا ↗</a
        >
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .landa-hero,
  .landa-cta {
    background: var(--hero-product-background);
    color: var(--color-white);
  }

  .landa-hero {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .landa-hero-grid,
  .experience-grid {
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .landa-hero-content {
    min-width: 0;
  }

  .breadcrumb,
  .text-link {
    color: var(--color-secondary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .breadcrumb {
    display: inline-block;
    margin-block-end: var(--space-lg);
    color: var(--color-accent-soft);
  }

  .landa-hero .text-link,
  .landa-cta .text-link {
    color: var(--color-accent-soft);
  }

  h1 {
    max-width: 18ch;
    margin-block-end: var(--space-md);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    line-height: 1.25;
  }

  .hero-copy {
    max-width: 38rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .landa-hero-visual {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-md);
    min-width: 0;
  }

  .visual-rule {
    width: 4rem;
    height: 0.2rem;
    background: var(--color-brand);
  }

  .landa-logo {
    max-width: 12rem;
    max-height: 3rem;
  }

  :global(.product-logo-fallback.landa-logo) {
    color: var(--color-white);
    font-size: 1.75rem;
  }

  .landa-hero-visual > p {
    margin: 0;
    color: var(--color-text-on-dark);
  }

  .landa-hero-visual > img,
  figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 0.0625rem solid rgba(255, 255, 255, 0.18);
    background: var(--color-white);
  }

  .content-section {
    padding-block: var(--space-xl);
  }

  .introduction,
  .why-landa,
  .audience,
  .company-relation {
    background: var(--color-paper);
  }

  .benefits,
  .capabilities,
  .product-experience {
    background: var(--color-surface);
  }

  .narrow-content {
    max-width: 52rem;
  }

  .content-section > .container > p,
  .narrow-content > p,
  .experience-copy > p {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 2;
  }

  .benefits-grid,
  .capability-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .benefit-item {
    padding-block-start: var(--space-md);
    border-block-start: 0.2rem solid var(--color-brand);
  }

  .benefit-item h3,
  .capability-group h3 {
    margin-block-end: var(--space-sm);
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  .benefit-item p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .capability-group {
    padding: var(--space-md);
    border: 0.0625rem solid var(--color-border);
    border-block-start: 0.2rem solid var(--color-primary);
    border-block-start-width: 0.2rem;
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .capability-group ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability-group li {
    position: relative;
    padding-inline-start: 1.25rem;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .capability-group li::before {
    position: absolute;
    inset-inline-start: 0;
    top: 0.75rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-brand);
    content: "";
  }

  .product-experience {
    padding-block: var(--space-xl);
  }

  .experience-copy {
    min-width: 0;
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-block-start: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
  }

  .company-relation .text-link {
    display: inline-block;
    margin-block-start: var(--space-md);
  }

  .landa-cta {
    padding-block: var(--space-xl);
  }

  .landa-cta h2 {
    margin-block-end: var(--space-sm);
    color: var(--color-white);
    font-size: var(--font-size-h2);
  }

  .landa-cta p {
    max-width: 40rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
  }

  @media (min-width: 48rem) {
    .content-section :global(.section-heading h2) {
      max-width: none;
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      white-space: nowrap;
    }

    .landa-hero-grid,
    .experience-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .benefits-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .landa-hero-visual {
      margin-block-start: var(--space-md);
    }
  }
</style>
