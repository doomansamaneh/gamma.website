---
interface Props {
  product: string;
  class?: string;
  compact?: boolean;
}

const { product, class: className = "", compact = false } = Astro.props;

const logoMap: Record<string, { label: string; src: string }> = {
  gammaitsm: {
    label: "GammaItsm",
    src: "/images/products/gamma-itsm/logo.png",
  },
};

const logo = logoMap[product];
const labelMap: Record<string, string> = {
  gammaitsm: "GammaItsm",
  "zed-eam": "ZED EAM",
  landa: "Landa",
  "gamma-kernel": "Gamma.Kernel",
};
const label = labelMap[product] ?? product;
---

{
  logo ? (
    <img
      class:list={[
        "product-logo",
        { "product-logo--compact": compact },
        className,
      ]}
      src={logo.src}
      alt={logo.label}
      width="220"
      height="72"
      loading="eager"
    />
  ) : (
    <span class:list={["product-logo-fallback", className]}>{label}</span>
  )
}

<style>
  .product-logo {
    display: block;
    width: auto;
    max-width: 11.25rem;
    max-height: 3.5rem;
    object-fit: contain;
  }

  .product-logo--compact {
    max-height: 2.75rem;
  }

  .product-logo-fallback {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--color-brand-dark);
    font-size: 1.125rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0;
  }
</style>
