---
interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = "", compact = false } = Astro.props;
---

<img
  class:list={["company-logo", { "company-logo--compact": compact }, className]}
  src="/images/brand/logo.png"
  alt="Doman Samaneh"
  width="220"
  height="56"
  loading="eager"
/>

<style>
  .company-logo {
    display: block;
    width: auto;
    max-width: 13.75rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .company-logo--compact {
    height: 2.125rem;
  }
</style>
