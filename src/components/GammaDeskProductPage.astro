---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gammaDeskCapabilityGroups } from "../data/gammadesk";
---

<BaseLayout
  title="GammaDesk | مدیریت خدمات فناوری اطلاعات"
  description="GammaDesk، سامانه مدیریت خدمات فناوری اطلاعات برای سازمان‌ها، محصول دومان سامانه."
>
  <section class="product-hero" id="overview">
    <div class="container hero-grid">
      <div>
        <a class="breadcrumb" href="/products/">محصولات / GammaDesk</a>
        <p class="eyebrow">محصول دومان سامانه</p>
        <h1>راهکار جامع مدیریت خدمات فناوری اطلاعات</h1>
        <p class="hero-copy">
          GammaDesk سامانه مدیریت خدمات فناوری اطلاعات برای سازمان‌هاست؛ با
          تمرکز بر مدیریت درخواست‌ها، رخدادها، خدمات و فرایندهای ITIL.
        </p>
        <div class="actions">
          <a class="button button--accent" href="/contact/demo/"
            >درخواست دموی GammaDesk</a
          >
          <a class="text-link" href="#capabilities">مشاهده قابلیت‌ها ←</a>
        </div>
      </div>
      <div
        class="screenshot-placeholder"
        aria-label="محل Screenshot واقعی GammaDesk"
      >
        محل تصویر واقعی GammaDesk
      </div>
    </div>
  </section>

  <nav class="product-nav" aria-label="ناوبری GammaDesk">
    <div class="container product-nav-inner">
      <a href="#overview">معرفی</a><a href="#capabilities">قابلیت‌ها</a><a
        href="#itil">ITIL</a
      ><a href="#screenshots">تصاویر محیط</a><a href="#integrations"
        >یکپارچه‌سازی</a
      ><a href="#resources">منابع</a><a href="#faq">سوالات متداول</a><a
        class="nav-cta"
        href="/contact/demo/">درخواست دمو</a
      >
    </div>
  </nav>

  <section class="content-section" aria-labelledby="why-title">
    <div class="container narrow-content">
      <p class="eyebrow">چرا GammaDesk</p><h2 id="why-title">
        مدیریت متمرکز خدمات فناوری اطلاعات
      </h2><p>
        GammaDesk برای ساختاردهی مدیریت خدمات فناوری اطلاعات سازمان‌ها طراحی شده
        است. اطلاعات و قابلیت‌های محصول در ادامه بر اساس محتوای تأییدشده محصول
        تکمیل خواهند شد.
      </p>
    </div>
  </section>

  <section
    class="content-section capabilities"
    id="capabilities"
    aria-labelledby="capabilities-title"
  >
    <div class="container">
      <p class="eyebrow">قابلیت‌ها</p><h2 id="capabilities-title">
        حوزه‌های اصلی GammaDesk
      </h2><div class="capability-grid">
        {
          gammaDeskCapabilityGroups.map((group) => (
            <article class="capability-group">
              <>
                <h3>{group.name}</h3>
                <p>{group.description}</p>
                <ul>
                  {group.features.map((feature) => (
                    <li>
                      <a href={`/products/gammadesk/features/${feature.slug}/`}>
                        {feature.name}
                        <span aria-hidden="true">←</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="content-section itil" id="itil" aria-labelledby="itil-title">
    <div class="container narrow-content">
      <p class="eyebrow">ITIL / Service Management</p><h2 id="itil-title">
        GammaDesk و ITIL
      </h2><p>
        ITIL یک چارچوب و مجموعه‌ای از روش‌های مدیریت خدمات فناوری اطلاعات است.
        GammaDesk محصول ITSM دومان سامانه است و می‌تواند برای پیاده‌سازی و
        مدیریت فرایندهای مرتبط با ITIL به کار رود.
      </p><a class="text-link" href="/resources/itil/">مشاهده راهنمای ITIL ←</a>
    </div>
  </section>

  <section
    class="content-section"
    id="screenshots"
    aria-labelledby="screenshots-title"
  >
    <div class="container">
      <p class="eyebrow">محیط GammaDesk</p><h2 id="screenshots-title">
        تصاویر محیط محصول
      </h2><div class="gallery-placeholder">
        <span>محل Screenshotهای واقعی محصول</span><small
          >تصاویر رسمی GammaDesk پس از تأمین asset در این بخش قرار می‌گیرند.</small>
      </div>
    </div>
  </section>

  <section
    class="content-section"
    id="integrations"
    aria-labelledby="integrations-title"
  >
    <div class="container narrow-content">
      <p class="eyebrow">یکپارچه‌سازی</p><h2 id="integrations-title">
        ارتباط با سیستم‌های دیگر
      </h2><p>
        جزئیات یکپارچه‌سازی‌های GammaDesk پس از دریافت مستندات رسمی محصول در این
        بخش منتشر خواهد شد.
      </p>
    </div>
  </section>

  <section
    class="content-section"
    id="resources"
    aria-labelledby="resources-title"
  >
    <div class="container narrow-content">
      <p class="eyebrow">منابع GammaDesk</p><h2 id="resources-title">
        مطالعه بیشتر
      </h2><div class="resource-links">
        <a href="/resources/articles/">مقالات</a><a href="/resources/videos/"
          >ویدئوها</a
        ><a href="/resources/itil/">راهنمای ITIL</a><a href="/resources/faq/"
          >پرسش‌های متداول</a>
      </div>
    </div>
  </section>

  <section class="content-section" id="faq" aria-labelledby="faq-title">
    <div class="container narrow-content">
      <p class="eyebrow">FAQ</p><h2 id="faq-title">
        پرسش‌های متداول GammaDesk
      </h2><p>
        پرسش‌ها و پاسخ‌های رسمی محصول پس از تأیید محتوای مربوط به GammaDesk در
        این بخش اضافه خواهند شد.
      </p>
    </div>
  </section>

  <section class="final-cta">
    <div class="container narrow-content">
      <h2>GammaDesk را از نزدیک ببینید</h2><p>
        برای آشنایی با GammaDesk و بررسی نیازهای سازمان خود، با دومان سامانه در
        ارتباط باشید.
      </p><div class="actions">
        <a class="button button--accent" href="/contact/demo/"
          >درخواست دموی GammaDesk</a
        ><a class="text-link" href="/contact/">تماس با ما ←</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-hero {
    padding-block: clamp(4rem, 9vw, 8rem);
    background: var(--color-primary);
    color: white;
  }
  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .breadcrumb,
  .text-link {
    color: var(--color-secondary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .product-hero .breadcrumb,
  .product-hero .text-link {
    color: var(--color-accent-soft);
  }
  .breadcrumb {
    display: inline-block;
    margin-block-end: var(--space-lg);
  }
  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
  }
  .product-hero .eyebrow {
    color: var(--color-accent-soft);
  }
  h1 {
    max-width: 52rem;
    margin-block-end: var(--space-md);
    font-size: var(--font-size-h1);
    line-height: 1.2;
  }
  .hero-copy {
    max-width: 42rem;
    margin-block-end: var(--space-lg);
    color: #eee;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .screenshot-placeholder,
  .gallery-placeholder {
    display: grid;
    min-height: 19rem;
    place-items: center;
    border: 0.1rem dashed var(--color-line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-muted);
    text-align: center;
  }
  .screenshot-placeholder {
    border-color: rgba(253, 228, 213, 0.45);
    color: var(--color-accent-soft);
  }
  .product-nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 5;
    border-block-end: 0.0625rem solid var(--color-line);
    background: var(--color-surface);
  }
  .product-nav-inner {
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    padding-block: 0.85rem;
    white-space: nowrap;
  }
  .product-nav a {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .product-nav a:hover,
  .product-nav a:focus-visible {
    color: var(--color-accent-dark);
  }
  .product-nav .nav-cta {
    margin-inline-start: auto;
    color: var(--color-accent-dark);
  }
  .content-section {
    padding-block: var(--space-xl);
  }
  .content-section:nth-of-type(even) {
    background: var(--color-surface);
  }
  .narrow-content {
    max-width: 52rem;
  }
  h2 {
    margin-block-end: var(--space-md);
    color: var(--color-primary);
    font-size: var(--font-size-h2);
  }
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .capability-group {
    padding-block: 1.25rem;
    border-block-start: 0.2rem solid var(--color-primary);
  }
  .capability-group:first-child {
    border-color: var(--color-accent);
  }
  .capability-group h3 {
    margin-block-end: 0.4rem;
    color: var(--color-primary);
  }
  .capability-group p {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }
  .capability-group ul {
    display: grid;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .capability-group a,
  .resource-links a {
    display: flex;
    justify-content: space-between;
    padding-block: 0.35rem;
    color: var(--color-ink);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .capability-group a:hover,
  .resource-links a:hover {
    color: var(--color-accent-dark);
  }
  .capability-group a span {
    color: var(--color-accent);
  }
  .gallery-placeholder {
    min-height: 14rem;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-paper);
  }
  .gallery-placeholder small {
    color: var(--color-muted);
  }
  .resource-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
  }
  .final-cta {
    padding-block: var(--space-xl);
    background: var(--color-primary);
    color: white;
  }
  .final-cta h2 {
    color: white;
  }
  .final-cta p {
    color: #eee;
  }
  .final-cta .text-link {
    color: var(--color-accent-soft);
  }
  @media (min-width: 48rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    }
  }
  @media (max-width: 47.99rem) {
    .capability-grid,
    .resource-links {
      grid-template-columns: 1fr;
    }
    .product-nav-inner {
      gap: 0.85rem;
    }
    .product-nav .nav-cta {
      margin-inline-start: 0;
    }
  }
</style>
