---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gammaDeskFeatures } from "../data/gammadesk";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const feature = gammaDeskFeatures.find((item) => item.slug === slug);

if (!feature) {
  throw new Error(`Unknown GammaDesk feature: ${slug}`);
}

const relatedFeatures = gammaDeskFeatures
  .filter((item) => item.group === feature.group && item.slug !== feature.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${feature.name} | GammaDesk`}
  description={`${feature.name} در GammaDesk؛ ${feature.description}`}
>
  <article class="feature-page">
    <header class="feature-hero">
      <div class="container">
        <a class="breadcrumb" href="/products/gammadesk/features/"
          >محصولات / GammaDesk / قابلیت‌ها / {feature.name}</a
        >
        <p class="eyebrow">GammaDesk / {feature.group}</p>
        <h1>{feature.name}</h1>
        <p class="lead">{feature.description}</p>
        <a class="button button--accent" href="/contact/demo/"
          >درخواست دموی GammaDesk</a
        >
      </div>
    </header>

    <section class="feature-section" aria-labelledby="problem-title">
      <div class="container narrow-content">
        <p class="eyebrow">مسئله و زمینه</p>
        <h2 id="problem-title">درباره این قابلیت</h2>
        <p>
          این صفحه برای توضیح دقیق‌تر قابلیت «{feature.name}» در GammaDesk آماده
          شده است. جزئیات مسئله، مخاطبان و کاربردهای عملی پس از تأیید محتوای
          رسمی محصول تکمیل خواهد شد.
        </p>
      </div>
    </section>

    <section
      class="feature-section feature-section--surface"
      aria-labelledby="solution-title"
    >
      <div class="container narrow-content">
        <p class="eyebrow">GammaDesk</p>
        <h2 id="solution-title">راهکار GammaDesk</h2>
        <p>
          {feature.description} اطلاعات تکمیلی درباره نحوه عملکرد این قابلیت و ارتباط
          آن با سایر بخش‌های محصول در این بخش قرار می‌گیرد.
        </p>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="capabilities-title">
      <div class="container narrow-content">
        <p class="eyebrow">جزئیات قابلیت</p>
        <h2 id="capabilities-title">قابلیت‌های مرتبط</h2>
        <div class="pending-list">
          <span
            >فهرست قابلیت‌های تأییدشده این بخش پس از دریافت مستندات رسمی اضافه
            خواهد شد.</span>
        </div>
      </div>
    </section>

    <section
      class="feature-section feature-section--surface"
      aria-labelledby="screenshot-title"
    >
      <div class="container narrow-content">
        <p class="eyebrow">محیط محصول</p>
        <h2 id="screenshot-title">Screenshot قابلیت {feature.name}</h2>
        <div
          class="screenshot-placeholder"
          role="img"
          aria-label={`محل تصویر واقعی قابلیت ${feature.name}`}
        >
          محل Screenshot واقعی GammaDesk
        </div>
        <p class="asset-note">
          تصویر واقعی این قابلیت پس از تأمین asset رسمی در این بخش قرار می‌گیرد.
        </p>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="related-title">
      <div class="container narrow-content">
        <p class="eyebrow">ادامه مسیر</p>
        <h2 id="related-title">مطالب مرتبط</h2>
        <div class="related-links">
          <a href="/resources/itil/">راهنمای ITIL <span>←</span></a>
          <a href="/resources/articles/">مقالات <span>←</span></a>
          <a href="/resources/videos/">ویدئوها <span>←</span></a>
          <a href="/resources/faq/">پرسش‌های متداول <span>←</span></a>
        </div>
      </div>
    </section>

    {
      relatedFeatures.length > 0 && (
        <section
          class="feature-section feature-section--surface"
          aria-labelledby="related-features-title"
        >
          <div class="container narrow-content">
            <p class="eyebrow">{feature.group}</p>
            <h2 id="related-features-title">قابلیت‌های مرتبط</h2>
            <div class="related-links">
              {relatedFeatures.map((related) => (
                <a href={`/products/gammadesk/features/${related.slug}/`}>
                  <span>{related.name}</span>
                  <span>←</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="feature-section" aria-labelledby="faq-title">
      <div class="container narrow-content">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">پرسش‌های متداول</h2>
        <p>
          پرسش‌ها و پاسخ‌های رسمی درباره این قابلیت پس از تأیید محتوای GammaDesk
          منتشر خواهند شد.
        </p>
      </div>
    </section>

    <section class="feature-cta">
      <div class="container narrow-content">
        <h2>GammaDesk را از نزدیک ببینید</h2>
        <p>
          برای آشنایی بیشتر با GammaDesk و بررسی نیازهای سازمان خود با دومان
          سامانه در ارتباط باشید.
        </p>
        <div class="actions">
          <a class="button button--accent" href="/contact/demo/"
            >درخواست دموی GammaDesk</a
          ><a class="text-link" href="/products/gammadesk/"
            >بازگشت به GammaDesk ←</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .feature-hero {
    padding-block: clamp(4rem, 9vw, 8rem);
    background: var(--color-primary);
    color: white;
  }
  .container {
    width: min(calc(100% - 2rem), var(--container-width));
    margin-inline: auto;
  }
  .narrow-content {
    max-width: 52rem;
  }
  .breadcrumb {
    display: inline-block;
    margin-block-end: var(--space-lg);
    color: var(--color-accent-soft);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
  }
  .feature-hero .eyebrow {
    color: var(--color-accent-soft);
  }
  h1 {
    max-width: 52rem;
    margin-block-end: var(--space-md);
    font-size: var(--font-size-h1);
    line-height: 1.2;
  }
  h2 {
    margin-block-end: var(--space-md);
    color: var(--color-primary);
    font-size: var(--font-size-h2);
  }
  .feature-hero h1,
  .feature-cta h2 {
    color: white;
  }
  .lead {
    max-width: 42rem;
    margin-block-end: var(--space-lg);
    color: #eee;
    font-size: 1.2rem;
  }
  .feature-section {
    padding-block: var(--space-xl);
  }
  .feature-section--surface {
    background: var(--color-surface);
  }
  .feature-section p {
    color: var(--color-muted);
  }
  .pending-list {
    padding-block: 1.25rem;
    border-block-start: 0.2rem solid var(--color-accent);
    color: var(--color-muted);
  }
  .screenshot-placeholder {
    display: grid;
    min-height: 18rem;
    place-items: center;
    border: 0.1rem dashed var(--color-line);
    background: var(--color-paper);
    color: var(--color-muted);
    text-align: center;
  }
  .asset-note {
    margin-block-start: 0.75rem;
    font-size: var(--font-size-small);
  }
  .related-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
  }
  .related-links a {
    display: flex;
    justify-content: space-between;
    padding-block: 0.85rem;
    border-block-start: 0.0625rem solid var(--color-line);
    color: var(--color-ink);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .related-links a:hover {
    color: var(--color-accent-dark);
  }
  .related-links span:last-child {
    color: var(--color-accent);
  }
  .feature-cta {
    padding-block: var(--space-xl);
    background: var(--color-primary);
    color: white;
  }
  .feature-cta p {
    color: #eee;
  }
  .text-link {
    color: var(--color-accent-soft);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  @media (min-width: 48rem) {
    .container {
      width: min(calc(100% - 4rem), var(--container-width));
    }
  }
  @media (max-width: 47.99rem) {
    .related-links {
      grid-template-columns: 1fr;
    }
  }
</style>
