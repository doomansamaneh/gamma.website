---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductLogo from "../../components/brand/ProductLogo.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";
import CTA from "../../components/common/CTA.astro";
import { products } from "../../data/products";
---

<BaseLayout
  title="محصولات | دومان سامانه"
  description="محصولات و راهکارهای نرم‌افزاری سازمانی دومان سامانه شامل GammaItsm، ZED EAM، Landa و Gamma.Kernel."
>
  <section class="products-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">محصولات</p>
        <h1>راهکارهای نرم‌افزاری سازمانی.</h1>
        <p class="hero-copy">
          هر محصول در دومان سامانه بر یک حوزه تخصصی تمرکز دارد؛ از مدیریت خدمات
          و دارایی تا حسابداری و توسعه فنی.
        </p>
        <div class="actions">
          <a class="button button--accent" href="/contact/demo/">درخواست دمو</a>
          <a class="text-link" href="/company/about/"
            >درباره دومان سامانه <span aria-hidden="true">←</span></a
          >
        </div>
      </div>
      <div class="hero-panel" aria-label="نمای کلی محصولات دومان سامانه">
        <ul>
          <li>GammaItsm</li>
          <li>ZED EAM</li>
          <li>Landa</li>
          <li>Gamma.Kernel</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="products-section" aria-labelledby="products-title">
    <div class="container">
      <SectionHeading id="products-title" title="یک اکوسیستم" />

      <div class="product-grid">
        {
          products.map((product) => (
            <a
              class:list={{
                "product-card": true,
                "product-card--primary": product.primary,
              }}
              href={product.href}
            >
              <ProductLogo
                product={product.slug}
                compact
                class="product-card__logo"
              />
              <span class="product-name">{product.name}</span>
              <span class="product-category">{product.category}</span>
              <span class="product-description">{product.description}</span>
              <span class="product-link">
                {product.slug === "gamma-kernel"
                  ? "مشاهده پروژه"
                  : "مشاهده محصول"}
                <span aria-hidden="true">←</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="overview">
    <div class="container overview-grid">
      <div>
        <h2>چند مسیر</h2>
      </div>
      <p class="overview-copy">
        دومان سامانه با چند محصول مستقل، یک اکوسیستم سازگار برای نیازهای سازمانی
        می‌سازد. هر راهکار روی یک حوزه مشخص تمرکز دارد و در کنار هم، یک تجربه
        برند و طراحی یکپارچه ایجاد می‌کنند.
      </p>
    </div>
  </section>

  <CTA
    title="برای انتخاب مناسب‌ترین راهکار، با ما صحبت کنید."
    text="اگر نیاز به راهکاری خاص در سازمان شما دارید، تیم دومان سامانه به شما کمک می‌کند مناسب‌ترین محصول را پیدا کنید."
    primaryHref="/contact/demo/"
    primaryLabel="درخواست دمو"
    secondaryHref="/contact/"
    secondaryLabel="تماس با ما"
    compact
  />
</BaseLayout>

<style>
  .products-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--hero-product-background);
    color: var(--color-white);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .eyebrow--dark {
    color: var(--color-accent-dark);
  }

  h1 {
    max-width: 18ch;
    margin-block-end: var(--space-md);
    font-size: var(--font-size-h1);
    line-height: 1.2;
  }

  .hero-copy {
    max-width: 38rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .text-link {
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(-0.25rem);
  }

  .hero-panel {
    padding: var(--space-lg);
    border: 0.0625rem solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-md);
  }

  .hero-panel p {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-panel ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-on-dark);
    line-height: 2;
  }

  .products-section {
    padding-block: var(--space-xl);
    background: var(--color-surface);
  }

  .product-grid {
    display: grid;
    gap: var(--space-sm);
  }

  .product-card {
    display: flex;
    min-height: 17rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: var(--space-md);
    border-block-start: 0.25rem solid var(--color-primary);
    background: var(--color-paper);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-normal);
  }

  .product-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-0.2rem);
    box-shadow: var(--shadow-soft);
  }

  .product-card--primary {
    border-color: var(--color-accent);
  }

  .product-card__logo {
    max-width: 9rem;
    max-height: 2.5rem;
    margin-block-end: 0.25rem;
  }

  .product-name {
    color: var(--color-primary);
    font-size: 1.4rem;
    font-weight: 800;
    direction: ltr;
  }

  .product-category {
    color: var(--color-accent-dark);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .product-description {
    color: var(--color-muted);
    line-height: 1.9;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: auto;
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: 700;
  }

  .overview {
    padding-block: var(--space-xl);
    background: var(--color-paper);
  }

  .overview-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .overview h2 {
    max-width: 16ch;
    margin-block-end: 0;
    font-size: var(--font-size-h2);
  }

  .overview-copy {
    max-width: 36rem;
    margin-block-end: 0;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  @media (min-width: 48rem) {
    .hero-grid,
    .overview-grid {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
    }

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
