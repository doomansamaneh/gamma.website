---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
const capabilityGroups = [
  {
    title: "حسابداری آنلاین",
    items: [
      "ایجاد خودکار سرفصل‌ها و اسناد حسابداری",
      "ترازنامه، تراز آزمایشی و صورت سود و زیان",
      "مرور حساب‌ها و گزارش دفتر روزنامه و کل",
      "گزارش‌های مالی لحظه‌ای و قابل چاپ",
    ],
  },
  {
    title: "خرید و فروش آنلاین",
    items: [
      "ایجاد پیش فاکتور و تبدیل به فاکتور",
      "ارسال فاکتور برای مشتری",
      "مشاهده مانده فاکتورها",
      "گزارش خرید و فروش و کالاهای پرفروش",
    ],
  },
  {
    title: "دریافت و پرداخت",
    items: [
      "ثبت سریع دریافت‌ها و پرداخت‌ها",
      "اتصال دریافت و پرداخت به فاکتورها",
      "انتقال وجه بین بانک‌ها و صندوق‌ها",
      "ثبت هزینه‌های جاری و تشکیلاتی",
    ],
  },
  {
    title: "گزارش‌های مدیریتی و عملیاتی",
    items: [
      "داشبورد و پیشخان مدیریتی",
      "صورت سود و زیان و مقایسه با سال قبل",
      "نسبت‌های مالی مانند نسبت جاری",
      "گزارش فروش، هزینه، دریافت و پرداخت",
    ],
  },
  {
    title: "حقوق و دستمزد آنلاین",
    items: [
      "تعریف و مدیریت پرسنل",
      "ثبت سند حقوق و دستمزد",
      "دریافت فایل بیمه و مالیات حقوق",
      "ایجاد فیش حقوقی",
    ],
  },
  {
    title: "سامانه مودیان",
    items: [
      "ارسال فاکتور به سامانه مودیان",
      "برگشت از فروش و اصلاح فاکتورها",
      "ارسال الگوی پیمانکاری",
    ],
  },
  {
    title: "فروشگاه اینترنتی و API",
    items: [
      "ثبت سفارش‌های فروشگاه اینترنتی",
      "همگام‌سازی کالاها، خدمات و مشتریان",
    ],
  },
  {
    title: "اطلاعات پایه حسابداری",
    items: [
      "تعریف کالا و گروه کالا",
      "تعریف صندوق و حساب‌های بانکی",
      "مدیریت اشخاص و مخاطبان",
      "تعریف و اصلاح حساب‌های کل و معین",
    ],
  },
];
const benefits = [
  {
    title: "آنلاین و ابری",
    text: "دسترسی به حسابداری و امور مالی از طریق مرورگر و دستگاه‌های مختلف.",
  },
  {
    title: "ساده و سریع",
    text: "تمرکز بر ساده‌سازی عملیات روزمره حسابداری و مالی.",
  },
  {
    title: "همیشه در دسترس",
    text: "مدیریت حسابداری و امور مالی از هر مکان و با هر دستگاه، بدون نصب نرم افزار.",
  },
  {
    title: "مناسب کسب و کارهای کوچک و متوسط",
    text: "راهکاری برای کسب و کارهایی که به مدیریت ساده و یکپارچه امور مالی نیاز دارند.",
  },
];
---

<BaseLayout
  title="نرم افزار حسابداری آنلاین لاندا | دومان سامانه"
  description="لاندا، نرم افزار حسابداری آنلاین و ابری برای کسب و کارهای کوچک و متوسط؛ ساده، سریع و در دسترس از طریق مرورگر و دستگاه‌های مختلف."
>
  <main class="page">
    <!-- Hero -->
    <section class="landa-hero" aria-labelledby="landa-hero-title">
      <div class="landa-hero-media">
        <img
          src="/images/products/landa/landa-dashboard.png"
          alt="نمایی از نرم افزار حسابداری آنلاین لاندا"
          width="1916"
          height="960"
          loading="eager"
          fetchpriority="high"
        />
        <div class="landa-hero-tint" aria-hidden="true"></div>
        <div class="landa-hero-content">
          <div class="landa-hero-copy">
            <h1 id="landa-hero-title">
              لاندا؛ <span class="accent-text">حسابداری آنلاین</span> برای کسب و کارهای
              کوچک و متوسط
            </h1>
            <p class="hero-lead">
              لاندا یک نرم افزار حسابداری آنلاین و ابری است که مدیریت حسابداری و
              امور مالی کسب و کار را ساده، سریع و در دسترس می‌کند.
            </p>
            <div class="hero-actions">
              <a
                class="button button--accent"
                href="https://landa-sme.ir/"
                target="_blank"
                rel="noopener noreferrer"
              >
                ورود به سایت لاندا ↗
              </a>
              <a class="button button--secondary" href="#capabilities">
                آشنایی با امکانات
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Introduction -->
    <section class="content-section introduction" aria-labelledby="intro-title">
      <div class="container narrow-content">
        <SectionHeading
          id="intro-title"
          title="حسابداری ساده‌تر برای کسب و کارهای کوچک و متوسط"
        />
        <p>
          لاندا حسابداری و مدیریت مالی را به‌صورت آنلاین و ابری ارائه می‌کند.
          کسب و کارها می‌توانند امور مالی خود را بدون نصب نرم افزار حسابداری
          سنتی و از طریق مرورگر مدیریت کنند.
        </p>
      </div>
    </section>
    <!-- Benefits -->
    <section class="content-section benefits" aria-labelledby="benefits-title">
      <div class="container">
        <SectionHeading
          id="benefits-title"
          title="مدیریت مالی در دسترس و ساده"
        />
        <div class="benefits-grid">
          {
            benefits.map((benefit) => (
              <article class="benefit-item">
                {" "}
                <h3>{benefit.title}</h3> <p>{benefit.text}</p>{" "}
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <!-- Capabilities -->
    <section
      class="content-section capabilities"
      id="capabilities"
      aria-labelledby="capabilities-title"
    >
      <div class="container">
        <SectionHeading
          id="capabilities-title"
          title="امکانات و قابلیت‌ها"
          description="ابزارهای مورد نیاز برای حسابداری و مدیریت مالی کسب و کار، در یک سامانه آنلاین."
        />
        <div class="capability-grid">
          {
            capabilityGroups.map((group) => (
              <article class="capability-group">
                {" "}
                <h3>{group.title}</h3>{" "}
                <ul>
                  {" "}
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}{" "}
                </ul>{" "}
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <!-- Why Landa -->
    <section class="content-section why-landa" aria-labelledby="why-title">
      <div class="container narrow-content">
        <SectionHeading
          id="why-title"
          title="یک راهکار آنلاین برای مدیریت امور مالی"
        />
        <p>
          لاندا برای کسب و کارهای کوچک و متوسط طراحی شده است تا فروش، خرید،
          هزینه، دریافت، پرداخت و سود کسب و کار را ساده‌تر مدیریت کنند. دسترسی
          ابری و بدون نیاز به نصب، امکان استفاده از حسابداری را در هر زمان و از
          هر مکان فراهم می‌کند.
        </p>
      </div>
    </section>

    <!-- Product experience -->
    <section
      class="content-section product-experience"
      aria-labelledby="experience-title"
    >
      <div class="container">
        <div class="experience-copy">
          <SectionHeading
            id="experience-title"
            title="حسابداری ابری، بدون پیچیدگی‌های حسابداری سنتی"
          />

          <p>
            با لاندا می‌توانید حسابداری و امور مالی کسب و کار خود را هر زمان، از
            هر مکان و با هر دستگاه مدیریت کنید.
          </p>
        </div>

        <div class="landa-screens">
          <figure>
            <img
              src="/images/products/landa/landa-income-statement.png"
              alt="گزارش سود و زیان نرم افزار حسابداری آنلاین لاندا"
              width="800"
              height="520"
              loading="lazy"
            />
            <figcaption>گزارش سود و زیان حسابداری لاندا</figcaption>
          </figure>

          <figure>
            <img
              src="/images/products/landa/landa-voucher.png"
              alt="بخش حسابداری نرم افزار حسابداری آنلاین لاندا"
              width="800"
              height="520"
              loading="lazy"
            />
            <figcaption>محیط حسابداری و اسناد مالی لاندا</figcaption>
          </figure>

          <figure>
            <img
              src="/images/products/landa/landa-dashboard.png"
              alt="داشبورد نرم افزار حسابداری آنلاین لاندا"
              width="800"
              height="520"
              loading="lazy"
            />
            <figcaption>داشبورد و پیشخان مدیریتی لاندا</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Audience -->
    <section class="content-section audience" aria-labelledby="audience-title">
      <div class="container narrow-content">
        <SectionHeading
          id="audience-title"
          title="لاندا برای چه کسب و کارهایی مناسب است؟"
        />
        <p>
          لاندا برای کسب و کارهای کوچک و متوسطی مناسب است که می‌خواهند حسابداری
          آنلاین و ابری داشته باشند و فروش، خرید، هزینه، دریافت، پرداخت، گزارش و
          صورتحساب الکترونیکی خود را مدیریت کنند.
        </p>
      </div>
    </section>
    <!-- CTA -->
    <section
      class="content-section landa-cta"
      aria-labelledby="landa-cta-title"
    >
      <div class="container narrow-content">
        <h2 id="landa-cta-title">لاندا را بیشتر بشناسید</h2>
        <p>
          برای مشاهده امکانات، ثبت نام و تجربه رایگان نرم افزار حسابداری آنلاین
          لاندا به سایت رسمی محصول مراجعه کنید.
        </p>
        <a
          class="button button--accent"
          href="https://landa-sme.ir/"
          target="_blank"
          rel="noopener noreferrer"
        >
          ورود به سایت لاندا ↗
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  /* ========================================================= * Hero * ======================================================= */
  .landa-hero {
    position: relative;
    z-index: auto;
  }

  .landa-hero-media {
    position: relative;
  }

  .landa-hero-media > img {
    display: block;
    width: 100%;
    height: auto;
    border: 0; /* * تصویر را کمی زنده‌تر و سردتر می‌کند، * بدون اینکه جزئیات Dashboard از بین برود. */
    filter: saturate(0.94) brightness(1.015);
  }

  /* * لایه بسیار ظریف آبی/فیروزه‌ای روی تصویر. * blur فقط روی همین لایه انجام می‌شود، نه روی خود Screenshot. */
  .landa-hero-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* z-index: 1; */
    background: linear-gradient(
      90deg,
      rgba(232, 250, 252, 0.68) 0%,
      rgba(225, 248, 250, 0.42) 24%,
      rgba(93, 191, 204, 0.12) 52%,
      rgba(42, 143, 170, 0.08) 100%
    );
    backdrop-filter: blur(1.2px) saturate(105%);
    -webkit-backdrop-filter: blur(1.2px) saturate(105%);
  }

  .landa-hero-content {
    position: absolute;
    inset: 0;
    /* z-index: 2; */
    display: flex;
    align-items: center;
    width: 100%;
    max-width: var(--content-width, 1200px);
    margin-inline: auto;
    padding: 3rem 1.5rem;
    pointer-events: none;
  }

  /* * متن داخل یک سطح شیشه‌ای بسیار ملایم قرار می‌گیرد. * این باعث می‌شود روی هر تصویری خوانا باشد. */
  .landa-hero-copy {
    padding: clamp(1.25rem, 2.2vw, 2rem);
    pointer-events: auto;
    color: var(--color-primary);

    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1rem;
    box-shadow: 0 1rem 3rem rgba(30, 100, 120, 0.08);

    backdrop-filter: blur(8px) saturate(110%);
  }

  .landa-hero-copy h1 {
    margin: 0;
    color: var(--color-primary);
    line-height: 1.5;
  }

  .landa-hero-copy .accent-text {
    color: var(--color-brand);
  }

  .landa-hero-copy .hero-lead {
    max-width: 31rem;
    margin-top: 1.2rem;
    color: var(--color-muted);
    line-height: 2;
  }
  .landa-hero-copy .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: 1.5rem;
  }

  /* ========================================================= * Content * ======================================================= */
  .content-section {
    padding-block: var(--space-xl);
  }
  .introduction,
  .why-landa,
  .audience {
    background: var(--color-paper);
  }
  .benefits,
  .capabilities,
  .product-experience {
    background: var(--color-surface);
  }
  .narrow-content {
    max-width: 52rem;
  }
  .content-section > .container > p,
  .narrow-content > p,
  .experience-copy > p {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 2;
  }

  /* ========================================================= * Benefits * ======================================================= */
  .benefits-grid,
  .capability-grid {
    display: grid;
    gap: var(--space-lg);
  }
  .benefit-item {
    padding-block-start: var(--space-md);
    border-block-start: 0.2rem solid var(--color-brand);
  }
  .benefit-item h3,
  .capability-group h3 {
    margin-block-end: var(--space-sm);
    color: var(--color-primary);
    font-size: 1.25rem;
  }
  .benefit-item p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.9;
  }

  /* ========================================================= * Capabilities * ======================================================= */
  .capability-group {
    padding: var(--space-md);
    border: 0.0625rem solid var(--color-border);
    border-block-start: 0.2rem solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }
  .capability-group ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .capability-group li {
    position: relative;
    padding-inline-start: 1.25rem;
    color: var(--color-muted);
    line-height: 1.8;
  }
  .capability-group li::before {
    position: absolute;
    inset-inline-start: 0;
    top: 0.75rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-brand);
    content: "";
  }

  /* =========================================================
 * Product experience
 * ======================================================= */

  .product-experience {
    padding-block: var(--space-xl);
  }

  .experience-copy {
    max-width: 52rem;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .experience-copy > p {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 2;
  }

  .landa-screens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .landa-screens figure {
    min-width: 0;
    margin: 0;
  }

  .landa-screens figure:last-child {
    grid-column: 1 / -1;
    width: 72%;
    justify-self: center;
  }

  .landa-screens img {
    display: block;
    width: 100%;
    height: auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .landa-screens figcaption {
    margin-block-start: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    line-height: 1.7;
    text-align: center;
  }

  @media (max-width: 767px) {
    .landa-screens {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .landa-screens figure:last-child {
      grid-column: auto;
      width: 100%;
    }
  }

  /* ========================================================= * CTA * ======================================================= */
  .landa-cta {
    background: var(--hero-product-background);
    color: var(--color-white);
  }
  .landa-cta h2 {
    margin-block-end: var(--space-sm);
    color: var(--color-white);
    font-size: var(--font-size-h2);
  }
  .landa-cta p {
    max-width: 40rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
  } /* ========================================================= * Tablet * ======================================================= */
  @media (max-width: 1024px) {
    .landa-hero-content {
      padding-inline: 2rem;
    }
    .landa-hero-copy {
      width: min(50%, 31rem);
    }
    .landa-hero-tint {
      background: linear-gradient(
        90deg,
        rgba(232, 250, 252, 0.72) 0%,
        rgba(225, 248, 250, 0.46) 30%,
        rgba(93, 191, 204, 0.12) 58%,
        rgba(42, 143, 170, 0.06) 100%
      );
    }
  }

  /* ========================================================= * Mobile * * تصویر کاملاً واضح و بدون overlay باقی می‌ماند. * متن بعد از تصویر قرار می‌گیرد. * ======================================================= */
  @media (max-width: 767px) {
    .landa-hero-media {
      overflow: visible;
    }
    .landa-hero-media > img {
      width: 100%;
      height: auto; /* * روی موبایل Screenshot کاملاً شفاف باشد. */
      filter: none;
    }
    .landa-hero-tint {
      display: none;
    }
    .landa-hero-content {
      position: static;
      display: block;
      width: 100%;
      max-width: none;
      padding: 1.5rem 1rem 2rem;
      background: var(--color-paper);
      pointer-events: auto;
    }
    .landa-hero-copy {
      width: 100%;
      max-width: 34rem;
      margin-inline: auto;
      padding: 0;
      text-align: center;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .landa-hero-copy h1 {
      font-size: clamp(1.55rem, 6vw, 2rem);
      line-height: 1.5;
    }
    .landa-hero-copy .hero-lead {
      max-width: 34rem;
      margin: 0.8rem auto 0;
      font-size: 0.95rem;
      line-height: 1.9;
    }
    .landa-hero-copy .hero-actions {
      justify-content: center;
      margin-top: 1rem;
      gap: 0.6rem;
    }
    .experience-grid {
      grid-template-columns: 1fr;
    }
    .benefits-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ========================================================= * Desktop * ======================================================= */
  @media (min-width: 768px) {
    .experience-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
    .benefits-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
