---
import GammaDeskFeaturePage from "../../../../components/GammaDeskFeaturePage.astro";
import { gammaDeskFeatures } from "../../../../data/gammadesk";

export function getStaticPaths() {
  return gammaDeskFeatures.map((feature) => ({
    params: { slug: feature.slug },
    props: { slug: feature.slug },
  }));
}

const { slug } = Astro.props;
---

<GammaDeskFeaturePage slug={slug} />
