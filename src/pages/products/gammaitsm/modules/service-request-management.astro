---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const features = [
  {
    icon: "▦",
    title: "کاتالوگ خدمات",
    text: "امکان تعریف کاتالوگ خدمات در لایه‌های مختلف و برای واحدهای مختلف سازمان، متناسب با ساختار خدمات شما.",
  },
  {
    icon: "✓",
    title: "ثبت و پیگیری آسان",
    text: "کاربران می‌توانند درخواست خود را به‌سادگی ثبت کنند و در هر لحظه از وضعیت و مهلت رسیدگی آن مطلع شوند.",
  },
  {
    icon: "◈",
    title: "شناخت ماهیت درخواست‌ها",
    text: "درخواست‌ها بر اساس ماهیت‌هایی مانند نیاز جدید، پیشنهاد، مشکل، رخداد و درخواست خدمت دسته‌بندی می‌شوند.",
  },
  {
    icon: "↗",
    title: "توزیع هوشمند درخواست‌ها",
    text: "درخواست‌ها بر اساس شرایط مختلف بین کارشناسان توزیع می‌شوند و در کنار ارجاع خودکار، امکان ارجاع دستی نیز وجود دارد.",
  },
  {
    icon: "▥",
    title: "تحلیل حجم درخواست‌ها",
    text: "با مشاهده تعداد درخواست‌ها در ماه‌های مختلف، دوره‌های پرترافیک را شناسایی و برای ظرفیت کارشناسان برنامه‌ریزی کنید.",
  },
  {
    icon: "◷",
    title: "کنترل مهلت درخواست‌ها",
    text: "گاما قبل از رسیدن درخواست‌ها به تأخیر، به افراد مسئول اطلاع می‌دهد تا امکان اقدام به‌موقع وجود داشته باشد.",
  },
];

const notifications = [
  {
    number: "01",
    title: "اعلان‌های گاما",
    text: "درخواست‌هایی که به پایان مهلت خود نزدیک می‌شوند در بخش اعلان‌های گاما نمایش داده می‌شوند.",
  },
  {
    number: "02",
    title: "ارسال پیامک",
    text: "هنگام ارجاع درخواست یا ایجاد تأخیر، می‌توان پیامک اطلاع‌رسانی برای افراد مربوطه ارسال کرد.",
  },
  {
    number: "03",
    title: "ارسال ایمیل",
    text: "می‌توان ارسال ایمیل هنگام ایجاد درخواست، نزدیک شدن به مهلت یا ایجاد تأخیر را تنظیم کرد.",
  },
  {
    number: "04",
    title: "Push Notification",
    text: "حتی در صورت بسته بودن مرورگر، کاربران از درخواست‌های جدید و ارجاع‌شده مطلع می‌شوند.",
  },
];
---

<BaseLayout
  title="مدیریت درخواست‌های خدماتی | Gamma Help Desk"
  description="مدیریت درخواست‌های خدماتی و Request Fulfillment در Gamma Help Desk؛ از کاتالوگ خدمات و ثبت درخواست تا ارجاع، پیگیری، SLA و گزارش‌گیری."
>
  <main class="page">
    <!-- Hero -->
   <section class="hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a>
      <span>/</span>
      <a href="/products/">محصولات</a>
      <span>/</span>
      <a href="/products/gammaitsm/">Gamma Help Desk</a>
      <span>/</span>
      <span>مدیریت درخواست</span>
    </nav>

    <div class="hero-content">
      <div class="hero-copy">
        <h1>
          مدیریت درخواست‌های خدماتی،
          <span class="accent-text">از ثبت تا انجام</span>
        </h1>

        <p class="hero-lead">
          فرایند Request Fulfillment در ITIL برای مدیریت و برآورده کردن
          درخواست‌های خدماتی کاربران طراحی شده است؛ از درخواست‌های ساده‌ای
          مانند تغییر گذرواژه تا خدمات پیچیده‌تر سازمانی.
        </p>

        <div class="hero-meta">
          <div>
            <strong>Request Fulfillment</strong>
            <span>مدیریت چرخه درخواست</span>
          </div>

          <div>
            <strong>Service Catalog</strong>
            <span>کاتالوگ خدمات سازمان</span>
          </div>

          <div>
            <strong>SLA</strong>
            <span>کنترل مهلت رسیدگی</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="dashboard-window">
          <div class="window-header">
            <div class="window-dots">
              <i></i>
              <i></i>
              <i></i>
            </div>

            <span>Gamma Help Desk</span>
          </div>

          <div class="dashboard-body">
            <div class="dashboard-top">
              <div>
                <small>درخواست‌های خدماتی</small>
                <strong>128</strong>
              </div>

              <div class="status-pill">● در حال پردازش</div>
            </div>

            <div class="request-item">
              <div class="request-icon">▦</div>

              <div class="request-info">
                <strong>درخواست دسترسی به سامانه</strong>
                <span>واحد منابع انسانی</span>
              </div>

              <div class="request-status">در حال بررسی</div>
            </div>

            <div class="request-item">
              <div class="request-icon">✓</div>

              <div class="request-info">
                <strong>تغییر گذرواژه</strong>
                <span>واحد مالی</span>
              </div>

              <div class="request-status request-status--success">
                انجام شد
              </div>
            </div>

            <div class="request-item">
              <div class="request-icon">◷</div>

              <div class="request-info">
                <strong>درخواست نصب نرم‌افزار</strong>
                <span>واحد فروش</span>
              </div>

              <div class="request-status request-status--warning">
                نزدیک به SLA
              </div>
            </div>

            <div class="mini-chart">
              <div class="chart-label">
                <span>حجم درخواست‌ها</span>
                <strong>این ماه</strong>
              </div>

              <div class="chart-bars">
                <i style="height: 34%"></i>
                <i style="height: 52%"></i>
                <i style="height: 43%"></i>
                <i style="height: 76%"></i>
                <i style="height: 61%"></i>
                <i style="height: 90%"></i>
                <i style="height: 68%"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

    <!-- Process -->
    <section class="process-section">
      <div class="container">
        <div class="section-heading section-heading--center">
          <h2>
            درخواست‌های خدماتی را
            <span class="accent-text">ساختار یافته مدیریت کنید</span>
          </h2>

          <p>
            کاربران درخواست‌ها و نیازهای خود را طبق کاتالوگ خدمات اعلام می‌کنند
            و گاما تمام چرخه درخواست را از ثبت تا انجام و بسته شدن مدیریت
            می‌کند.
          </p>
        </div>

        <div class="process-flow">
          <div class="process-step">
            <span class="step-number">01</span>
            <div class="step-icon">▦</div>
            <strong>کاتالوگ خدمات</strong>
            <span>انتخاب خدمت</span>
          </div>

          <div class="process-line"></div>

          <div class="process-step">
            <span class="step-number">02</span>
            <div class="step-icon">＋</div>
            <strong>ثبت درخواست</strong>
            <span>ارسال درخواست</span>
          </div>

          <div class="process-line"></div>

          <div class="process-step">
            <span class="step-number">03</span>
            <div class="step-icon">↗</div>
            <strong>ارجاع</strong>
            <span>تخصیص به کارشناس</span>
          </div>

          <div class="process-line"></div>

          <div class="process-step">
            <span class="step-number">04</span>
            <div class="step-icon">⚙</div>
            <strong>انجام خدمت</strong>
            <span>اقدام و پیگیری</span>
          </div>

          <div class="process-line"></div>

          <div class="process-step">
            <span class="step-number">05</span>
            <div class="step-icon">✓</div>
            <strong>بسته شدن</strong>
            <span>تکمیل درخواست</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Catalog -->
    <section class="catalog-section">
      <div class="container feature-grid">
        <div class="feature-copy">
          <h2>
            هر خدمت،
            <span class="accent-text">یک مسیر مشخص برای درخواست</span>
          </h2>

          <p>
            کاربران درخواست‌های خود را بر اساس کاتالوگ خدمات ثبت می‌کنند. در
            نرم‌افزار Service Desk گاما می‌توانید کاتالوگ خدمات را در لایه‌های
            مختلف و برای بخش‌های مختلف سازمان تعریف کنید.
          </p>

          <div class="check-list">
            <div>
              <span>✓</span>
              <strong>تعریف خدمات در چند سطح</strong>
            </div>

            <div>
              <span>✓</span>
              <strong>اختصاص خدمات به واحدهای مختلف</strong>
            </div>

            <div>
              <span>✓</span>
              <strong>ثبت درخواست بر اساس خدمت انتخاب‌شده</strong>
            </div>
          </div>
        </div>

        <div class="catalog-visual">
          <div class="catalog-card">
            <div class="catalog-header">
              <div>
                <small>Service Catalog</small>
                <strong>کاتالوگ خدمات</strong>
              </div>

              <span>＋</span>
            </div>

            <div class="catalog-search">
              🔍
              <span>جستجوی خدمت موردنظر...</span>
            </div>

            <div class="catalog-category">
              <span class="category-icon">▣</span>
              <div>
                <strong>خدمات فناوری اطلاعات</strong>
                <small>۱۲ خدمت</small>
              </div>
              <span>←</span>
            </div>

            <div class="catalog-category">
              <span class="category-icon">◈</span>
              <div>
                <strong>خدمات منابع انسانی</strong>
                <small>۸ خدمت</small>
              </div>
              <span>←</span>
            </div>

            <div class="catalog-category">
              <span class="category-icon">▤</span>
              <div>
                <strong>خدمات مالی</strong>
                <small>۶ خدمت</small>
              </div>
              <span>←</span>
            </div>

            <div class="catalog-category">
              <span class="category-icon">◇</span>
              <div>
                <strong>خدمات عمومی سازمان</strong>
                <small>۱۵ خدمت</small>
              </div>
              <span>←</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Easy Request -->
    <section class="request-section">
      <div class="container">
        <div class="section-heading">
          <h2>
            ثبت و پیگیری آسان
            <span class="accent-text">درخواست‌ها</span>
          </h2>

          <p>
            از آنجایی که کاربران نهایی معمولاً در کار کردن با سامانه‌های
            نرم‌افزاری مقاومت می‌کنند، گاما محیطی ساده و مناسب برای آنها فراهم
            کرده است تا بتوانند درخواست خود را سریع ثبت و پیگیری کنند.
          </p>
        </div>

        <div class="request-features">
          <article class="request-feature">
            <div class="large-number">01</div>
            <h3>ثبت درخواست</h3>
            <p>
              کاربر خدمت موردنظر خود را انتخاب کرده و درخواست را بدون پیچیدگی و
              مراحل اضافی ثبت می‌کند.
            </p>
          </article>

          <article class="request-feature">
            <div class="large-number">02</div>
            <h3>پیگیری وضعیت</h3>
            <p>
              کاربر در هر لحظه می‌تواند وضعیت درخواست خود و آخرین اقدام
              انجام‌شده را مشاهده کند.
            </p>
          </article>

          <article class="request-feature">
            <div class="large-number">03</div>
            <h3>مشاهده مهلت رسیدگی</h3>
            <p>
              مهلت انجام درخواست برای کاربر شفاف است و امکان پیگیری وضعیت رسیدگی
              وجود دارد.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Request Types -->
    <section class="types-section">
      <div class="container types-grid">
        <div class="types-intro">
          <h2>
            بدانید کاربران
            <span class="accent-text">چه چیزی درخواست می‌کنند</span>
          </h2>

          <p>
            درخواست‌هایی که کاربران برای سازمان ارسال می‌کنند، بر اساس طراحی
            Service Catalog می‌توانند ماهیت‌های مختلفی داشته باشند. گاما با
            دسته‌بندی این درخواست‌ها به شما کمک می‌کند تصویر دقیق‌تری از نیازهای
            کاربران داشته باشید.
          </p>
        </div>

        <div class="type-tags">
          <span>نیاز جدید</span>
          <span>پیشنهاد</span>
          <span>مشکل</span>
          <span>رخداد</span>
          <span>درخواست خدمت</span>
          <span>درخواست اطلاعات</span>
        </div>
      </div>
    </section>

    <!-- Round Robin -->
    <section class="distribution-section">
      <div class="container">
        <div class="section-heading section-heading--center">
          <h2>
            توزیع هوشمند درخواست‌ها
            <span class="accent-text">بین کارشناسان</span>
          </h2>

          <p>
            گاما با توجه به شرایط درخواست مانند موضوع، محصول، نوع درخواست و واحد
            سازمانی، امکان تعریف فرآیندهای ارجاع و توزیع درخواست‌ها را فراهم
            می‌کند.
          </p>
        </div>

        <div class="distribution-flow">
          <div class="distribution-node distribution-node--main">
            <span>＋</span>
            <strong>درخواست جدید</strong>
            <small>Request</small>
          </div>

          <div class="distribution-connector"></div>

          <div class="distribution-node">
            <span>⚙</span>
            <strong>بررسی شرایط</strong>
            <small>موضوع · محصول · واحد</small>
          </div>

          <div class="distribution-connector"></div>

          <div class="distribution-node">
            <span>◈</span>
            <strong>الگوریتم توزیع</strong>
            <small>Round Robin و سایر روش‌ها</small>
          </div>

          <div class="distribution-connector"></div>

          <div class="experts">
            <div class="expert">
              <span>01</span>
              <strong>کارشناس ۱</strong>
            </div>

            <div class="expert">
              <span>02</span>
              <strong>کارشناس ۲</strong>
            </div>

            <div class="expert">
              <span>03</span>
              <strong>کارشناس ۳</strong>
            </div>
          </div>
        </div>

        <div class="distribution-note">
          <span>i</span>
          <p>
            توزیع درخواست‌ها می‌تواند به‌صورت خودکار انجام شود و در کنار آن،
            امکان ارجاع دستی درخواست به مسئول مربوطه نیز وجود دارد.
          </p>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="capabilities-section">
      <div class="container">
        <div class="section-heading">
          <h2>
            همه چیز برای مدیریت
            <span class="accent-text">چرخه درخواست</span>
          </h2>
        </div>

        <div class="capabilities-grid">
          {
            features.map((feature) => (
              <article class="capability-card">
                <div class="capability-icon">{feature.icon}</div>

                <h3>{feature.title}</h3>

                <p>{feature.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Workload -->
    <section class="workload-section">
      <div class="container workload-grid">
        <div class="workload-copy">
          <h2>
            پیک کاری سازمان را
            <span class="accent-text">بشناسید</span>
          </h2>

          <p>
            گاما تعداد درخواست‌ها را بر اساس ماه‌های مختلف سال نمایش می‌دهد تا
            بتوانید دوره‌هایی را که حجم درخواست‌ها بیشتر است شناسایی کرده و برای
            آنها برنامه‌ریزی مناسب داشته باشید.
          </p>

          <div class="stat-row">
            <div>
              <strong>1,280</strong>
              <span>درخواست این ماه</span>
            </div>

            <div>
              <strong>87٪</strong>
              <span>درخواست‌های به‌موقع</span>
            </div>
          </div>
        </div>

        <div class="workload-chart">
          <div class="chart-header">
            <div>
              <small>گزارش ماهانه درخواست‌ها</small>
              <strong>حجم درخواست‌ها</strong>
            </div>

            <span>1405</span>
          </div>

          <div class="bars">
            <div class="bar-column">
              <i style="height: 42%"></i>
              <span>فر</span>
            </div>

            <div class="bar-column">
              <i style="height: 57%"></i>
              <span>ارد</span>
            </div>

            <div class="bar-column">
              <i style="height: 48%"></i>
              <span>خرد</span>
            </div>

            <div class="bar-column">
              <i style="height: 73%"></i>
              <span>تیر</span>
            </div>

            <div class="bar-column">
              <i style="height: 64%"></i>
              <span>مرد</span>
            </div>

            <div class="bar-column bar-column--active">
              <i style="height: 91%"></i>
              <span>شهریور</span>
            </div>

            <div class="bar-column">
              <i style="height: 69%"></i>
              <span>مهر</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Notifications -->
    <section class="notification-section">
      <div class="container">
        <div class="section-heading section-heading--center">
          <h2>
            نگران تأخیر در انجام درخواست‌ها
            <span class="accent-text">نباشید</span>
          </h2>

          <p>
            گاما با اطلاع‌رسانی هوشمند و توجه به مهلت درخواست‌ها، به شما کمک
            می‌کند پیش از ایجاد تأخیر برای انجام درخواست اقدام کنید.
          </p>
        </div>

        <div class="notification-grid">
          {
            notifications.map((notification) => (
              <article class="notification-card">
                <span class="notification-number">{notification.number}</span>

                <div>
                  <h3>{notification.title}</h3>
                  <p>{notification.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="benefits-section">
      <div class="container">
        <div class="section-heading section-heading--center">
          <h2>
            یک چرخه شفاف برای
            <span class="accent-text">خدمات سازمان</span>
          </h2>
        </div>

        <div class="benefits-grid">
          <article>
            <span>01</span>
            <strong>ثبت ساختاریافته</strong>
            <p>درخواست‌ها بر اساس کاتالوگ خدمات ثبت می‌شوند.</p>
          </article>

          <article>
            <span>02</span>
            <strong>توزیع هوشمند</strong>
            <p>درخواست‌ها به شکل مناسب بین کارشناسان توزیع می‌شوند.</p>
          </article>

          <article>
            <span>03</span>
            <strong>شفافیت وضعیت</strong>
            <p>کاربر و مسئولان همیشه از وضعیت درخواست مطلع هستند.</p>
          </article>

          <article>
            <span>04</span>
            <strong>کنترل SLA</strong>
            <p>نزدیک شدن به مهلت و ایجاد تأخیر قابل مشاهده و پیگیری است.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="final-cta">
      <div class="container">
        <div class="cta-content">
          <h2>
            درخواست‌های خدماتی را
