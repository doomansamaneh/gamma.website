---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="سرویس‌های دوره‌ای | Gamma ITSM"
  description="مدیریت سرویس‌های دوره‌ای و برنامه‌های زمان‌بندی‌شده تجهیزات با امکان تعریف دارایی، وظایف، چک‌لیست، فرم، گردش کار و ثبت نتایج در Gamma ITSM."
>
  <!-- =========================================================
       Hero
       Global .hero is used intentionally.
       ========================================================= -->

  <section class="hero" id="overview">
    <div class="container">
      <nav class="breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a>
        <span>/</span>
        <a href="/products/">محصولات</a>
        <span>/</span>
        <a href="/products/gammaitsm/">Gamma ITSM</a>
        <span>/</span>
        <span>سرویس‌های دوره‌ای</span>
      </nav>

      <div class="hero-content">
        <div class="hero-copy">
          <h1>
            سرویس‌های دوره‌ای؛
            <span class="accent-text">
              برنامه‌ریزی و اجرای منظم فعالیت‌ها
            </span>
          </h1>

          <p class="hero-lead">
            فعالیت‌های دوره‌ای تجهیزات را با برنامه زمان‌بندی‌شده، دارایی‌های
            مشخص، وظایف استاندارد، چک‌لیست، فرم و گردش کار مدیریت کنید و نتیجه
            هر فعالیت را در سامانه ثبت و پیگیری نمایید.
          </p>

          <div class="hero-actions">
            <a class="button button--accent" href="/contact/demo/">
              درخواست دمو
            </a>

            <a class="button button--secondary" href="#how-it-works">
              آشنایی با فرایند
            </a>
          </div>
        </div>

        <div class="hero-visual periodic-visual" aria-hidden="true">
          <div class="periodic-plan">
            <div class="plan-header">
              <span>برنامه دوره‌ای</span>
              <strong>بازدید تجهیزات</strong>
            </div>

            <div class="plan-row">
              <span>دوره</span>
              <strong>هر ۶ ماه</strong>
            </div>

            <div class="plan-row">
              <span>دارایی</span>
              <strong>PCها</strong>
            </div>

            <div class="plan-row">
              <span>وظایف</span>
              <strong>۴ وظیفه</strong>
            </div>

            <div class="plan-progress">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>

          <p class="hero-visual-caption">برنامه‌ریزی، اجرا و ثبت نتیجه</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Introduction
       ========================================================= -->

  <section class="periodic-section" id="how-it-works">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">سرویس دوره‌ای</p>

        <h2>
          فعالیت‌های تکرارشونده را
          <span class="accent-text">به یک فرایند قابل مدیریت</span>
          تبدیل کنید
        </h2>

        <p>
          سرویس‌های دوره‌ای در Gamma ITSM برای فعالیت‌هایی طراحی شده‌اند که باید
          در بازه‌های زمانی مشخص روی مجموعه‌ای از تجهیزات، دارایی‌ها یا سایر
          اقلام انجام شوند.
        </p>

        <p>
          به‌جای ایجاد و پیگیری دستی فعالیت‌ها، برنامه یک‌بار تعریف می‌شود و
          سامانه بر اساس دوره، دارایی‌ها، وظایف و گردش کار مشخص، اجرای فعالیت‌ها
          را مدیریت می‌کند.
        </p>
      </div>

      <div class="process-steps">
        <article class="process-step">
          <span class="process-index">01</span>
          <h3>تعریف اطلاعات پایه</h3>
          <p>
            گروه‌بندی وظایف و تعریف فعالیت‌هایی که باید در برنامه انجام شوند.
          </p>
        </article>

        <article class="process-step">
          <span class="process-index">02</span>
          <h3>تعریف برنامه</h3>
          <p>
            تعیین دوره اجرا، دارایی‌ها، مسئول، گردش کار و ظرفیت اجرای روزانه.
          </p>
        </article>

        <article class="process-step">
          <span class="process-index">03</span>
          <h3>اجرای برنامه</h3>
          <p>ایجاد و اجرای فعالیت‌ها برای دارایی‌ها و کارشناسان مرتبط.</p>
        </article>

        <article class="process-step">
          <span class="process-index">04</span>
          <h3>مشاهده نتایج</h3>
          <p>مشاهده جزئیات فعالیت‌ها، وظایف، قطعات و اطلاعات ثبت‌شده.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Scheduling
       ========================================================= -->

  <section class="periodic-section periodic-section--dark">
    <div class="container">
      <div class="section-intro section-intro--dark">
        <p class="section-label">برنامه‌ریزی</p>

        <h2>
          برای هر تجهیز،
          <span class="accent-text">برنامه مناسب خودش را تعریف کنید</span>
        </h2>

        <p>
          برنامه‌های دوره‌ای می‌توانند دوره‌های زمانی، دارایی‌ها، وظایف و گردش
          کار متفاوتی داشته باشند.
        </p>
      </div>

      <div class="schedule-examples">
        <article class="schedule-card">
          <div class="schedule-card-header">
            <span>برنامه 01</span>
            <strong>سرویس دوره‌ای PCها</strong>
          </div>

          <div class="schedule-meta">
            <div>
              <small>دوره</small>
              <strong>هر ۶ ماه</strong>
            </div>

            <div>
              <small>دارایی</small>
              <strong>تجهیزات کلاینت</strong>
            </div>
          </div>

          <ul>
            <li>گردگیری تجهیزات</li>
            <li>بررسی وضعیت شبکه</li>
            <li>بررسی نسخه سیستم‌عامل</li>
            <li>بررسی وضعیت سخت‌افزار</li>
          </ul>
        </article>

        <article class="schedule-card">
          <div class="schedule-card-header">
            <span>برنامه 02</span>
            <strong>بازبینی سرورها</strong>
          </div>

          <div class="schedule-meta">
            <div>
              <small>دوره</small>
              <strong>ماهانه</strong>
            </div>

            <div>
              <small>دارایی</small>
              <strong>سرورها</strong>
            </div>
          </div>

          <ul>
            <li>بررسی ظرفیت هارد</li>
            <li>بررسی منابع CPU</li>
            <li>بررسی وضعیت سرویس‌ها</li>
            <li>بررسی پشتیبان‌گیری</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Tasks
       ========================================================= -->

  <section class="periodic-section">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">وظایف و چک‌لیست</p>

        <h2>
          هر برنامه با
          <span class="accent-text">وظایف مشخص و قابل کنترل</span>
          اجرا می‌شود
        </h2>

        <p>
          وظایف مورد نیاز ابتدا در اطلاعات پایه تعریف می‌شوند و سپس در
          برنامه‌های مختلف مورد استفاده قرار می‌گیرند. ترتیب اجرا، زمان
          استاندارد، هزینه و دستورالعمل انجام کار نیز می‌تواند برای هر وظیفه
          مشخص شود.
        </p>
      </div>

      <div class="task-layout">
        <div class="task-list">
          <article class="task-item">
            <span>01</span>

            <div>
              <h3>ترتیب اجرا</h3>
              <p>مشخص می‌کند وظایف در چه ترتیبی انجام شوند.</p>
            </div>
          </article>

          <article class="task-item">
            <span>02</span>

            <div>
              <h3>زمان استاندارد</h3>
              <p>مدت زمان استاندارد مورد انتظار برای انجام وظیفه.</p>
            </div>
          </article>

          <article class="task-item">
            <span>03</span>

            <div>
              <h3>هزینه استاندارد</h3>
              <p>امکان ثبت هزینه استاندارد هر فعالیت.</p>
            </div>
          </article>

          <article class="task-item">
            <span>04</span>

            <div>
              <h3>دستورالعمل انجام کار</h3>
              <p>شرح یا دستورالعمل مورد نیاز کارشناس برای انجام وظیفه.</p>
            </div>
          </article>
        </div>

        <div class="checklist-panel">
          <div class="checklist-header">
            <span>چک‌لیست سرویس</span>
            <strong>بررسی PC</strong>
          </div>

          <div class="checklist-item">
            <span class="checkmark">✓</span>
            <span>گردگیری تجهیزات</span>
          </div>

          <div class="checklist-item">
            <span class="checkmark">✓</span>
            <span>بررسی اتصال شبکه</span>
          </div>

          <div class="checklist-item">
            <span class="checkmark">✓</span>
            <span>بررسی نسخه سیستم‌عامل</span>
          </div>

          <div class="checklist-item">
            <span class="checkmark">✓</span>
            <span>بررسی آنتی‌ویروس</span>
          </div>

          <div class="checklist-note">
            چک‌لیست هر وظیفه می‌تواند با فرم‌ساز Gamma متناسب با نیاز همان
            فعالیت طراحی شود.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Forms
       ========================================================= -->

  <section class="periodic-section periodic-section--paper">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">فرم و گردآوری اطلاعات</p>

        <h2>
          برای هر فعالیت،
          <span class="accent-text">فرم مورد نیاز خودتان را بسازید</span>
        </h2>

        <p>
          چک‌لیست فقط مجموعه‌ای از گزینه‌های بله و خیر نیست. برای هر وظیفه
          می‌توان یک فرم متناسب با اطلاعات مورد نیاز همان فعالیت طراحی کرد و
          نتیجه اجرای آن را ثبت نمود.
        </p>
      </div>

      <div class="form-capability">
        <div class="form-copy">
          <h3>یک برنامه، چند وظیفه، چند فرم متفاوت</h3>

          <p>
            برای نمونه، در سرویس دوره‌ای یک سرور می‌توان وظایف متفاوتی مانند
            بررسی CPU، بررسی ظرفیت دیسک، بررسی آنتی‌ویروس و کنترل پشتیبان‌گیری
            تعریف کرد.
          </p>

          <p>
            هر یک از این وظایف می‌تواند چک‌لیست یا فرم مخصوص خود را داشته باشد
            تا اطلاعات دقیق مورد نیاز همان فعالیت از کارشناس دریافت شود.
          </p>
        </div>

        <div class="form-preview">
          <div class="form-preview-header">
            <span>فرم وظیفه</span>
            <strong>بررسی منابع سرور</strong>
          </div>

          <div class="fake-field">
            <span>میزان مصرف CPU</span>
            <strong>42%</strong>
          </div>

          <div class="fake-field">
            <span>فضای آزاد دیسک</span>
            <strong>280 GB</strong>
          </div>

          <div class="fake-field">
            <span>وضعیت پشتیبان‌گیری</span>
            <strong>تأیید شد</strong>
          </div>

          <div class="fake-field">
            <span>شرح کارشناس</span>
            <strong>بدون مغایرت</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Assets + workflow
       ========================================================= -->

  <section class="periodic-section periodic-section--dark">
    <div class="container">
      <div class="section-intro section-intro--dark">
        <p class="section-label">دارایی و گردش کار</p>

        <h2>
          اجرای برنامه را
          <span class="accent-text">به فرایند سازمانی خود متصل کنید</span>
        </h2>

        <p>
          هر برنامه می‌تواند مجموعه مشخصی از دارایی‌ها و یک گردش کار داشته باشد.
          بنابراین اجرای سرویس دوره‌ای تنها به ثبت یک فعالیت محدود نمی‌شود و
          می‌تواند بخشی از فرایند خدمات سازمان باشد.
        </p>
      </div>

      <div class="workflow-model">
        <div class="workflow-node">
          <span>برنامه</span>
          <strong>بازدید دوره‌ای</strong>
          <small>هر ماه</small>
        </div>

        <div class="workflow-line"></div>

        <div class="workflow-node">
          <span>دارایی‌ها</span>
          <strong>سرورها</strong>
          <small>دارایی‌های منتخب</small>
        </div>

        <div class="workflow-line"></div>

        <div class="workflow-node">
          <span>وظایف</span>
          <strong>چک‌لیست‌ها</strong>
          <small>فرم‌های اختصاصی</small>
        </div>

        <div class="workflow-line"></div>

        <div class="workflow-node workflow-node--accent">
          <span>گردش کار</span>
          <strong>تأیید و ثبت نتیجه</strong>
          <small>فرایند سازمانی</small>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Execution
       ========================================================= -->

  <section class="periodic-section">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">اجرای برنامه</p>

        <h2>
          اجرای دوره‌ای،
          <span class="accent-text">بدون ایجاد حجم کار یک‌باره</span>
        </h2>

        <p>
          وقتی تعداد دارایی‌های یک برنامه زیاد باشد، اجرای همه فعالیت‌ها در یک
          زمان همیشه منطقی نیست. Gamma می‌تواند تعداد مواردی را که در هر روز
          برای هر کارشناس به کارپوشه ارسال می‌شود کنترل کند.
        </p>
      </div>

      <div class="execution-example">
        <div class="execution-summary">
          <div>
            <span>تعداد کل</span>
            <strong>100</strong>
            <small>دارایی</small>
          </div>

          <div>
            <span>ظرفیت روزانه</span>
            <strong>10</strong>
            <small>مورد برای هر کارشناس</small>
          </div>

          <div>
            <span>اجرای تدریجی</span>
            <strong>10 روز</strong>
            <small>تا تکمیل برنامه</small>
          </div>
        </div>

        <div class="execution-days">
          <div>
            <span>روز ۱</span>
            <strong>10</strong>
          </div>

          <div>
            <span>روز ۲</span>
            <strong>10</strong>
          </div>

          <div>
            <span>روز ۳</span>
            <strong>10</strong>
          </div>

          <div>
            <span>...</span>
            <strong>...</strong>
          </div>

          <div class="execution-days--complete">
            <span>تکمیل</span>
            <strong>100</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Real-world inspection
       ========================================================= -->

  <section class="periodic-section periodic-section--paper">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">ثبت وضعیت واقعی</p>

        <h2>
          مغایرت‌ها را هنگام بازدید
          <span class="accent-text">ثبت و اصلاح کنید</span>
        </h2>

        <p>
          سرویس دوره‌ای تنها برای تأیید انجام یک وظیفه نیست. در زمان بازدید ممکن
          است وضعیت واقعی دارایی با اطلاعات ثبت‌شده در سامانه متفاوت باشد. Gamma
          امکان ثبت این مغایرت‌ها و اصلاح اطلاعات را در همان فرایند فراهم
          می‌کند.
        </p>
      </div>

      <div class="inspection-grid">
        <article class="inspection-card">
          <span class="inspection-status inspection-status--missing">
            مشاهده نشد
          </span>

          <h3>دارایی در محل نیست</h3>

          <p>
            اگر دارایی ثبت‌شده در محل یا در اختیار مخاطب مشاهده نشود، وضعیت آن
            در سرویس دوره‌ای مشخص می‌شود.
          </p>
        </article>

        <article class="inspection-card">
          <span class="inspection-status inspection-status--edit">
            نیاز به اصلاح
          </span>

          <h3>اطلاعات دارایی متفاوت است</h3>

          <p>
            مشخصات ثبت‌شده دارایی را می‌توان در زمان سرویس بررسی و در صورت نیاز
            اصلاح کرد.
          </p>
        </article>

        <article class="inspection-card">
          <span class="inspection-status inspection-status--parts">
            قطعات
          </span>

          <h3>قطعات تغییر کرده‌اند</h3>

          <p>
            قطعات وابسته به دارایی بررسی می‌شوند و قطعه جدید را می‌توان اضافه،
            ویرایش یا حذف کرد.
          </p>
        </article>

        <article class="inspection-card">
          <span class="inspection-status inspection-status--new">
            دارایی جدید
          </span>

          <h3>دارایی ثبت نشده است</h3>

          <p>
            اگر دارایی در اختیار مخاطب وجود داشته باشد اما در سامانه ثبت نشده
            باشد، امکان ثبت آن در فرایند سرویس وجود دارد.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Results
       ========================================================= -->

  <section class="periodic-section">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">نتایج و سابقه</p>

        <h2>
          نتیجه هر سرویس،
          <span class="accent-text">بخشی از سابقه دارایی است</span>
        </h2>

        <p>
          پس از اجرای سرویس دوره‌ای می‌توان جزئیات هر فعالیت، وظایف انجام‌شده،
          فرم‌های تکمیل‌شده، قطعات و اطلاعات ثبت‌شده برای هر دارایی را مشاهده و
          پیگیری کرد.
        </p>
      </div>

      <div class="result-model">
        <div class="result-block">
          <span>برنامه</span>
          <strong>سرویس دوره‌ای سرورها</strong>
        </div>

        <div class="result-divider"></div>

        <div class="result-block">
          <span>دارایی</span>
          <strong>Server-024</strong>
        </div>

        <div class="result-divider"></div>

        <div class="result-block">
          <span>وظایف انجام‌شده</span>
          <strong>8 وظیفه</strong>
        </div>

        <div class="result-divider"></div>

        <div class="result-block">
          <span>نتیجه</span>
          <strong>تکمیل و تأیید</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Feature summary
       ========================================================= -->

  <section class="periodic-section periodic-section--dark">
    <div class="container">
      <div class="section-intro section-intro--dark">
        <p class="section-label">یکپارچه در Gamma ITSM</p>

        <h2>
          از برنامه‌ریزی تا نتیجه،
          <span class="accent-text">در یک فرایند</span>
        </h2>
      </div>

      <div class="capability-grid">
        <div class="capability-item">
          <strong>برنامه زمان‌بندی‌شده</strong>
          <span>تعریف دوره‌های مختلف برای فعالیت‌ها</span>
        </div>

        <div class="capability-item">
          <strong>دارایی‌های هدف</strong>
          <span>انتخاب تجهیزات و دارایی‌های هر برنامه</span>
        </div>

        <div class="capability-item">
          <strong>وظایف استاندارد</strong>
          <span>تعریف فعالیت‌ها، زمان و دستورالعمل انجام</span>
