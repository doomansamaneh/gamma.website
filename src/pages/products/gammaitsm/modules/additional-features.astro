---
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "ویژگی‌های تکمیلی | Gamma ITSM";
const description =
  "Gamma ITSM علاوه بر مدیریت خدمات و درخواست‌ها، امکاناتی برای اطلاع‌رسانی سازمانی، ارزیابی کاربران و مدیریت قراردادها فراهم می‌کند.";
---

<BaseLayout title={title} description={description}>
  <main class="additional-features-page">
    <!-- =========================================================
         Hero
         ========================================================= -->

    <section class="hero" id="overview">
      <div class="container">
        <nav class="breadcrumb" aria-label="مسیر صفحه">
          <a href="/">خانه</a>
          <span>/</span>

          <a href="/products/">محصولات</a>
          <span>/</span>

          <a href="/products/gammaitsm/">Gamma ITSM</a>
          <span>/</span>

          <span>ویژگی‌های تکمیلی</span>
        </nav>

        <div class="hero-content">
          <div class="hero-copy">
            <h1>
              ویژگی‌های تکمیلی
              <span class="accent-text">Gamma ITSM</span>
            </h1>

            <p class="hero-lead">
              قابلیت‌هایی برای اطلاع‌رسانی سازمانی، ارزیابی کاربران و مدیریت
              قراردادها که در کنار فرآیندهای خدمات IT، مدیریت روزمره سازمان را
              کامل‌تر می‌کنند.
            </p>
          </div>

          <div class="hero-visual">
            <div class="feature-overview" aria-hidden="true">
              <span>اطلاع‌رسانی</span>
              <span>ارزیابی</span>
              <span>قرارداد</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Introduction
         ========================================================= -->

    <section class="intro-section">
      <div class="container">
        <div class="intro-content">
          <div>
            <h2>
              مدیریت خدمات،
              <span class="accent-text">کامل‌تر</span>
            </h2>
          </div>

          <div class="intro-copy">
            <p>
              در یک سازمان، همه تعاملات به ثبت و پیگیری درخواست‌های IT محدود
              نمی‌شود. اطلاع‌رسانی به کاربران، دریافت بازخورد و ارزیابی دوره‌ای
              و همچنین مدیریت قراردادهای مرتبط با خدمات و دارایی‌ها، بخش دیگری
              از فعالیت‌های روزمره سازمان است.
            </p>

            <p>
              Gamma این قابلیت‌ها را در کنار اطلاعات و فرآیندهای اصلی سازمان
              قرار می‌دهد تا این فعالیت‌ها نیز قابل مدیریت، پیگیری و ثبت باشند.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Feature Cards
         ========================================================= -->

    <section class="features-section" id="features">
      <div class="container">
        <div class="section-heading">
          <h2>
            سه قابلیت،
            <span class="accent-text">یک بستر یکپارچه</span>
          </h2>

          <p>
            قابلیت‌های تکمیلی Gamma برای ارتباط بهتر با کاربران، دریافت بازخورد
            و مدیریت تعهدات سازمانی.
          </p>
        </div>

        <div class="feature-grid">
          <!-- News -->

          <article class="feature-card">
            <div class="feature-number">01</div>

            <div class="feature-icon" aria-hidden="true">
              <span class="icon-lines"></span>
            </div>

            <h3>اخبار و اطلاع‌رسانی سازمانی</h3>

            <p>
              اخبار و اطلاعیه‌های سازمان را برای همه یا بخشی از پرسنل منتشر کنید
              و پیام موردنظر را در زمان ورود کاربر در اختیار او قرار دهید.
            </p>

            <ul>
              <li>انتشار خبر برای همه یا گروهی از کاربران</li>
              <li>تعیین مخاطبان هر خبر</li>
              <li>نمایش خودکار خبر هنگام ورود</li>
              <li>مناسب برای اطلاعیه‌ها، هشدارها و پیام‌های سازمانی</li>
            </ul>
          </article>

          <!-- Evaluation -->

          <article class="feature-card">
            <div class="feature-number">02</div>

            <div
              class="feature-icon feature-icon--evaluation"
              aria-hidden="true"
            >
              <span class="icon-check"></span>
            </div>

            <h3>نظرسنجی و ارزیابی‌های دوره‌ای</h3>

            <p>
              برنامه‌های ارزیابی و نظرسنجی را برای کاربران تعریف کنید، پرسشنامه
              را با Form Builder طراحی کنید و تکمیل ارزیابی را در زمان ورود
              کاربر مدیریت نمایید.
            </p>

            <ul>
              <li>تعریف برنامه‌های ارزیابی دوره‌ای</li>
              <li>طراحی پرسشنامه با Form Builder</li>
              <li>انتخاب کاربران یا گروه هدف</li>
              <li>تعیین دوره و زمان فعال بودن ارزیابی</li>
              <li>نمایش ارزیابی هنگام ورود و الزام به تکمیل آن</li>
            </ul>
          </article>

          <!-- Contracts -->

          <article class="feature-card feature-card--contract">
            <div class="feature-number">03</div>

            <div class="feature-icon feature-icon--contract" aria-hidden="true">
              <span class="icon-contract"></span>
            </div>

            <h3>مدیریت قراردادها</h3>

            <p>
              قراردادها را در ارتباط با دارایی‌ها و فرآیندهای سازمان مدیریت کنید
              و با استفاده از گردش کار، اطلاع‌رسانی و ثبت اقدامات، وضعیت و سوابق
              قرارداد را پیگیری نمایید.
            </p>

            <ul>
              <li>تعریف و مدیریت قراردادها</li>
              <li>ارتباط قرارداد با دارایی‌ها</li>
              <li>اطلاع‌رسانی پیش از پایان قرارداد</li>
              <li>اجرای فرآیند قرارداد براساس گردش کار</li>
              <li>ثبت اقدامات و سوابق انجام‌شده</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- =========================================================
         News
         ========================================================= -->

    <section class="news-section section-light" id="organizational-news">
      <div class="container">
        <div class="split-content">
          <div class="split-copy">
            <h2>
              اطلاع‌رسانی را
              <span class="accent-text">به کاربر برسانید</span>
            </h2>

            <p>
              همه پیام‌های سازمانی لازم نیست از طریق ایمیل یا پیام‌رسان جداگانه
              ارسال شوند. در Gamma می‌توان خبر را برای همه کاربران یا گروه مشخصی
              از پرسنل تعریف کرد.
            </p>

            <p>
              در زمان ورود کاربر، در صورتی که خبر برای او تعریف شده باشد، پیام
              به‌صورت Popup نمایش داده می‌شود تا اطلاع‌رسانی مهم در همان محیط
              کاری در دسترس قرار گیرد.
            </p>
          </div>

          <div class="concept-panel news-panel">
            <div class="panel-header">
              <span>اخبار سازمانی</span>
              <span class="panel-status">فعال</span>
            </div>

            <div class="news-item">
              <div class="news-dot"></div>

              <div>
                <strong>اطلاعیه به‌روزرسانی خدمات</strong>
                <span>مخاطب: واحد فناوری اطلاعات</span>
              </div>
            </div>

            <div class="news-item">
              <div class="news-dot"></div>

              <div>
                <strong>اطلاعیه عمومی سازمان</strong>
                <span>مخاطب: همه کاربران</span>
              </div>
            </div>

            <div class="news-popup">
              <span class="popup-label">پیام جدید</span>
              <strong>اطلاعیه سازمانی</strong>
              <p>یک اطلاعیه جدید برای شما ثبت شده است.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Evaluation
         ========================================================= -->

    <section class="evaluation-section section-dark" id="evaluation">
      <div class="container">
        <div class="split-content split-content--reverse">
          <div class="split-copy">
            <h2>
              ارزیابی‌های دوره‌ای،
              <span class="accent-text">ساختاریافته</span>
            </h2>

            <p>
              برای دریافت نظر کاربران، نیازی به تعریف فرم‌های جداگانه و
              فرآیندهای دستی نیست. برنامه ارزیابی را تعریف کنید و پرسشنامه
              موردنظر را با Form Builder بسازید.
            </p>

            <p>
              ارزیابی می‌تواند برای همه کاربران یا گروه مشخصی فعال شود و در بازه
              زمانی مشخص در دسترس باشد. در صورت فعال بودن ارزیابی برای کاربر،
              پرسشنامه هنگام ورود نمایش داده می‌شود و کاربر باید آن را تکمیل
              کند.
            </p>
          </div>

          <div class="evaluation-flow">
            <div class="evaluation-step">
              <span>01</span>
              <strong>برنامه ارزیابی</strong>
              <small>تعیین دوره و مخاطبان</small>
            </div>

            <div class="evaluation-line"></div>

            <div class="evaluation-step">
              <span>02</span>
              <strong>پرسشنامه</strong>
              <small>طراحی با Form Builder</small>
            </div>

            <div class="evaluation-line"></div>

            <div class="evaluation-step evaluation-step--active">
              <span>03</span>
              <strong>ورود کاربر</strong>
              <small>نمایش ارزیابی فعال</small>
            </div>

            <div class="evaluation-line"></div>

            <div class="evaluation-step">
              <span>04</span>
              <strong>تکمیل</strong>
              <small>ثبت پاسخ‌ها</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Contract Management
         ========================================================= -->

    <section class="contract-section" id="contracts">
      <div class="container">
        <div class="section-heading contract-heading">
          <h2>
            قرارداد،
            <span class="accent-text">متصل به فرآیند</span>
          </h2>

          <p>
            مدیریت قرارداد در Gamma فقط ثبت اطلاعات قرارداد نیست؛ قرارداد
            می‌تواند به دارایی‌ها، گردش کار، اقدامات و اطلاع‌رسانی‌های موردنیاز
            متصل باشد.
          </p>
        </div>

        <div class="contract-model">
          <div class="contract-main">
            <div class="contract-card">
              <span class="contract-label">قرارداد</span>

              <strong>قرارداد پشتیبانی تجهیزات</strong>

              <div class="contract-meta">
                <span>وضعیت: فعال</span>
                <span>پایان: ۱۴۰۵/۱۲/۲۹</span>
              </div>
            </div>
          </div>

          <div class="contract-relations">
            <div class="relation-card">
              <span class="relation-index">01</span>
              <strong>دارایی‌ها</strong>
              <p>ارتباط قرارداد با تجهیزات و دارایی‌های تحت پوشش</p>
            </div>

            <div class="relation-card">
              <span class="relation-index">02</span>
              <strong>گردش کار</strong>
              <p>اجرای فرآیند قرارداد براساس مراحل و مسئولیت‌ها</p>
            </div>

            <div class="relation-card">
              <span class="relation-index">03</span>
              <strong>اقدامات</strong>
              <p>ثبت فعالیت‌ها، پیگیری و نگهداری سوابق</p>
            </div>

            <div class="relation-card">
              <span class="relation-index">04</span>
              <strong>اطلاع‌رسانی</strong>
              <p>هشدار و خبررسانی پیش از پایان قرارداد</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Contract Process
         ========================================================= -->

    <section class="contract-process section-paper">
      <div class="container">
        <div class="split-content">
          <div class="split-copy">
            <h2>
              از ثبت قرارداد تا
              <span class="accent-text">پیگیری تعهدات</span>
            </h2>

            <p>
              قرارداد می‌تواند بخشی از یک فرآیند سازمانی باشد. با تعریف گردش
              کار، مراحل موردنیاز برای بررسی، تأیید، اجرا و پیگیری قرارداد مشخص
              می‌شود.
            </p>

            <p>
              در کنار آن، اقدامات انجام‌شده ثبت می‌شوند و پیش از رسیدن به تاریخ
              پایان قرارداد، اطلاع‌رسانی موردنیاز انجام می‌شود.
            </p>
          </div>

          <div class="process-timeline">
            <div class="timeline-item">
              <span>01</span>
              <div>
                <strong>ثبت قرارداد</strong>
                <small>اطلاعات و مدت قرارداد</small>
              </div>
            </div>

            <div class="timeline-item">
              <span>02</span>
              <div>
                <strong>ارتباط با دارایی</strong>
                <small>تعیین تجهیزات و دارایی‌های مرتبط</small>
              </div>
            </div>

            <div class="timeline-item">
              <span>03</span>
              <div>
                <strong>گردش کار</strong>
                <small>اجرای مراحل و مسئولیت‌ها</small>
              </div>
            </div>

            <div class="timeline-item">
              <span>04</span>
              <div>
                <strong>اقدامات و پیگیری</strong>
                <small>ثبت سوابق و فعالیت‌ها</small>
              </div>
            </div>

            <div class="timeline-item timeline-item--last">
              <span>05</span>
              <div>
                <strong>اطلاع‌رسانی</strong>
                <small>هشدار پیش از پایان قرارداد</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Summary
         ========================================================= -->

    <section class="summary-section section-dark">
      <div class="container">
        <div class="summary-content">
          <h2>
            قابلیت‌هایی که
            <span class="accent-text">کنار هم معنا پیدا می‌کنند</span>
          </h2>

          <p>
            Gamma ITSM با کنار هم قرار دادن مدیریت خدمات، اطلاعات سازمانی،
            ارتباط با کاربران و فرآیندهای اجرایی، یک بستر یکپارچه برای مدیریت
            فعالیت‌های مرتبط با خدمات IT فراهم می‌کند.
          </p>

          <div class="summary-list">
            <div>
              <strong>اطلاع‌رسانی</strong>
              <span>پیام را به مخاطب درست برسانید.</span>
            </div>

            <div>
              <strong>ارزیابی</strong>
              <span>بازخورد کاربران را ساختاریافته دریافت کنید.</span>
            </div>

            <div>
              <strong>قرارداد</strong>
              <span>تعهدات را به دارایی و فرآیند متصل کنید.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* =========================================================
       Additional Features
       Page-specific CSS only
       Hero styles are inherited from global styles.
       ========================================================= */

    .additional-features-page {
      --additional-line: rgba(35, 31, 32, 0.12);
      --additional-soft: rgba(239, 63, 35, 0.07);
      --additional-dark-line: rgba(255, 255, 255, 0.14);
    }

    /* =========================================================
       Hero Visual
       ========================================================= */

    .additional-features-logo {
      max-width: 10rem;
      margin-inline: auto;
    }

    .feature-overview {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-xs);
      margin-block-start: var(--space-lg);
    }

    .feature-overview span {
      padding: 0.45rem 0.8rem;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--radius-sm);
      font-size: var(--font-size-sm);
      color: var(--color-text-on-dark);
      background: rgba(255, 255, 255, 0.035);
    }

    .hero-visual-caption {
      margin-block-start: var(--space-md);
    }

    /* =========================================================
       Intro
       ========================================================= */

    .intro-section {
      padding-block: var(--space-xl);
      background: var(--color-white);
    }

    .intro-content {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-xl);
      align-items: start;
    }

    .intro-content h2,
    .section-heading h2,
    .split-copy h2,
    .summary-content h2 {
      margin: 0;
      font-size: var(--font-size-h2);
      line-height: var(--line-height-heading);
    }

    .intro-copy {
      max-width: 48rem;
    }

    .intro-copy p {
      margin: 0;
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .intro-copy p + p {
      margin-block-start: var(--space-md);
    }

    /* =========================================================
       Feature Cards
       ========================================================= */

    .features-section {
      padding-block: var(--space-xl);
      background: var(--color-paper);
    }

    .section-heading {
      max-width: 52rem;
      margin-block-end: var(--space-lg);
    }

    .section-heading p {
      margin-block-start: var(--space-md);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
    }

    .feature-card {
      position: relative;
      padding: var(--space-lg);
      border: 1px solid var(--additional-line);
      border-radius: var(--radius-lg);
      background: var(--color-white);
      box-shadow: var(--shadow-soft);
    }

    .feature-number {
      position: absolute;
      inset-block-start: var(--space-md);
      inset-inline-end: var(--space-md);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-muted);
    }

    .feature-icon {
      width: 3rem;
      height: 3rem;
      display: grid;
      place-items: center;
      margin-block-end: var(--space-md);
      border-radius: var(--radius-md);
      background: var(--additional-soft);
    }

    .icon-lines {
      width: 1.2rem;
      height: 0.9rem;
      display: block;
      border-block: 2px solid var(--color-accent);
      position: relative;
    }

    .icon-lines::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-start: 0.28rem;
      border-block-start: 2px solid var(--color-accent);
    }

    .icon-check {
      width: 1rem;
      height: 0.55rem;
      display: block;
      border-inline-start: 2px solid var(--color-accent);
      border-block-end: 2px solid var(--color-accent);
      transform: rotate(-45deg);
    }

    .icon-contract {
      width: 1rem;
      height: 1.2rem;
      display: block;
      border: 2px solid var(--color-accent);
      border-radius: 2px;
      position: relative;
    }

    .icon-contract::after {
      content: "";
      position: absolute;
      inset-inline: 0.2rem;
      inset-block-start: 0.3rem;
      height: 2px;
      background: var(--color-accent);
      box-shadow: 0 0.28rem 0 var(--color-accent);
    }

    .feature-card h3 {
      margin: 0;
      font-size: var(--font-size-xl);
      line-height: var(--line-height-heading);
    }

    .feature-card > p {
      margin-block: var(--space-md);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .feature-card ul {
      display: grid;
      gap: 0.7rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .feature-card li {
      position: relative;
      padding-inline-start: 1.2rem;
      color: var(--color-text-secondary);
      font-size: var(--font-size-sm);
      line-height: 1.8;
    }

    .feature-card li::before {
      content: "";
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: 0.72rem;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: 50%;
      background: var(--color-accent);
    }

    /* =========================================================
       Split Sections
       ========================================================= */

    .section-light {
      background: var(--color-white);
    }

    .section-dark {
      background: var(--hero-bg-base);
      color: var(--color-text-on-dark);
    }

    .section-paper {
      background: var(--color-paper);
    }

    .news-section,
    .evaluation-section,
    .contract-process,
    .summary-section {
      padding-block: var(--space-xl);
    }

    .split-content {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-xl);
      align-items: center;
    }

    .split-content--reverse {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }

    .split-copy {
      max-width: 40rem;
    }

    .split-copy p {
      margin-block-start: var(--space-md);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .section-dark .split-copy p {
      color: var(--color-text-on-dark);
      opacity: 0.86;
    }

    /* =========================================================
       News Concept Panel
       ========================================================= */

    .concept-panel {
      position: relative;
      min-height: 24rem;
      padding: var(--space-lg);
      border: 1px solid var(--additional-line);
      border-radius: var(--radius-lg);
      background: var(--color-paper);
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-block-end: var(--space-md);
      border-block-end: 1px solid var(--additional-line);
    }

    .panel-header > span:first-child {
      font-weight: var(--font-weight-semibold);
    }

    .panel-status {
      padding: 0.25rem 0.6rem;
      border-radius: var(--radius-sm);
      font-size: var(--font-size-xs);
      color: var(--color-success);
      background: rgba(57, 115, 91, 0.1);
    }

    .news-item {
      display: flex;
      gap: var(--space-sm);
      padding-block: var(--space-md);
      border-block-end: 1px solid var(--additional-line);
    }

    .news-dot {
      flex: 0 0 auto;
      width: 0.55rem;
      height: 0.55rem;
      margin-block-start: 0.5rem;
      border-radius: 50%;
      background: var(--color-accent);
    }

    .news-item strong,
    .news-item span {
      display: block;
    }

    .news-item strong {
      font-size: var(--font-size-sm);
    }

    .news-item span {
      margin-block-start: 0.25rem;
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
    }

    .news-popup {
      position: absolute;
      inset-inline-end: var(--space-lg);
      inset-block-end: var(--space-lg);
      width: min(17rem, calc(100% - 2 * var(--space-lg)));
      padding: var(--space-md);
      border: 1px solid var(--additional-line);
      border-radius: var(--radius-md);
      background: var(--color-white);
      box-shadow: var(--shadow-soft);
    }

    .popup-label {
      display: block;
      margin-block-end: 0.3rem;
      color: var(--color-accent);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
    }

    .news-popup strong {
      display: block;
    }

    .news-popup p {
      margin: 0.35rem 0 0;
      color: var(--color-text-secondary);
      font-size: var(--font-size-xs);
      line-height: 1.7;
    }

    /* =========================================================
       Evaluation
       ========================================================= */

    .evaluation-flow {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: var(--space-sm);
    }

    .evaluation-step {
      min-width: 0;
      padding: var(--space-md);
      border: 1px solid var(--additional-dark-line);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.035);
    }

    .evaluation-step > span {
      display: block;
      margin-block-end: var(--space-sm);
      color: var(--color-accent);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
    }

    .evaluation-step strong,
    .evaluation-step small {
      display: block;
    }

    .evaluation-step strong {
      font-size: var(--font-size-sm);
    }

    .evaluation-step small {
      margin-block-start: 0.3rem;
      color: var(--color-text-on-dark);
      opacity: 0.7;
      font-size: var(--font-size-xs);
      line-height: 1.6;
    }

    .evaluation-step--active {
      border-color: rgba(239, 63, 35, 0.5);
      background: rgba(239, 63, 35, 0.08);
    }

    .evaluation-line {
      width: 1.5rem;
      height: 1px;
      background: var(--additional-dark-line);
    }

    /* =========================================================
       Contract Model
       ========================================================= */

    .contract-section {
      padding-block: var(--space-xl);
      background: var(--color-white);
    }

    .contract-heading {
      max-width: 52rem;
    }

    .contract-model {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: var(--space-lg);
      margin-block-start: var(--space-lg);
      align-items: center;
    }

    .contract-card {
      padding: var(--space-lg);
      border: 1px solid var(--additional-line);
      border-radius: var(--radius-lg);
      background: var(--color-paper);
      box-shadow: var(--shadow-soft);
    }

    .contract-label {
      display: block;
      margin-block-end: var(--space-sm);
      color: var(--color-accent);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    .contract-card strong {
      display: block;
      font-size: var(--font-size-xl);
    }

    .contract-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-block-start: var(--space-md);
      padding-block-start: var(--space-md);
      border-block-start: 1px solid var(--additional-line);
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
    }

    .contract-relations {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm);
    }

    .relation-card {
      padding: var(--space-md);
      border: 1px solid var(--additional-line);
      border-radius: var(--radius-md);
      background: var(--color-white);
    }

    .relation-index {
      display: block;
      margin-block-end: 0.5rem;
      color: var(--color-accent);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
    }

    .relation-card strong {
      display: block;
    }

    .relation-card p {
      margin: 0.4rem 0 0;
      color: var(--color-text-secondary);
      font-size: var(--font-size-sm);
      line-height: 1.7;
    }

    /* =========================================================
       Contract Timeline
       ========================================================= */

    .process-timeline {
      display: grid;
      gap: 0;
      border-block-start: 1px solid var(--additional-line);
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: var(--space-md);
      padding-block: var(--space-md);
      border-block-end: 1px solid var(--additional-line);
    }

    .timeline-item > span {
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 50%;
      background: var(--additional-soft);
      color: var(--color-accent);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
    }

    .timeline-item strong,
    .timeline-item small {
      display: block;
    }

    .timeline-item strong {
      font-size: var(--font-size-sm);
    }

    .timeline-item small {
      margin-block-start: 0.25rem;
      color: var(--color-text-secondary);
      font-size: var(--font-size-xs);
    }

    /* =========================================================
       Summary
       ========================================================= */

    .summary-content {
      max-width: 58rem;
    }

    .summary-content p {
      max-width: 48rem;
      margin-block-start: var(--space-md);
      color: var(--color-text-on-dark);
      opacity: 0.84;
      line-height: var(--line-height-relaxed);
    }

    .summary-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
      margin-block-start: var(--space-lg);
    }

    .summary-list > div {
      padding-block-start: var(--space-md);
      border-block-start: 1px solid var(--additional-dark-line);
    }

    .summary-list strong,
    .summary-list span {
      display: block;
    }

    .summary-list strong {
      color: var(--color-white);
    }

    .summary-list span {
      margin-block-start: 0.35rem;
      color: var(--color-text-on-dark);
      opacity: 0.72;
      font-size: var(--font-size-sm);
      line-height: 1.7;
    }

    /* =========================================================
       Responsive
       ========================================================= */

    @media (max-width: 900px) {
      .intro-content,
      .split-content,
      .split-content--reverse,
      .contract-model {
        grid-template-columns: 1fr;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .evaluation-flow {
        grid-template-columns: 1fr;
      }

      .evaluation-line {
        width: 1px;
        height: 1.25rem;
        margin-inline: auto;
      }

      .summary-list {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .intro-section,
      .features-section,
      .news-section,
      .evaluation-section,
      .contract-section,
      .contract-process,
      .summary-section {
        padding-block: var(--space-lg);
      }

      .feature-card,
      .concept-panel,
      .contract-card {
        padding: var(--space-md);
      }

      .contract-relations {
        grid-template-columns: 1fr;
      }

      .news-popup {
        position: static;
        width: auto;
        margin-block-start: var(--space-md);
      }

      .concept-panel {
        min-height: auto;
      }
    }
  </style>
</BaseLayout>
