  .agent-info strong {
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
  }

  /* Lifecycle */

  .lifecycle {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: start;
  }

  .lifecycle::before {
    position: absolute;
    top: 21px;
    inset-inline: 10%;
    height: 1px;
    background: var(--color-border);
    content: "";
  }

  .lifecycle article {
    position: relative;
    z-index: 1;
    padding-inline: 1rem;
    text-align: center;
  }

  .lifecycle-marker {
    display: grid;
    width: 44px;
    height: 44px;
    margin-inline: auto;
    margin-bottom: 1.25rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
  }

  .lifecycle-marker span {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
  }

  .lifecycle article strong {
    display: block;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
  }

  .lifecycle article small {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }

  .lifecycle-card--accent .lifecycle-marker {
    border-color: var(--color-accent);
    background: var(--color-brand-subtle);
  }

  .lifecycle-card--accent .lifecycle-marker span {
    color: var(--color-accent);
  }

  /* CTA */

  .asset-cta {
    padding-block: var(--space-xl);
  }

  .cta-box {
    max-width: 900px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
  }

  .cta-box p {
    max-width: 650px;
    margin-inline: auto;
  }

  .cta-box .button {
    margin-top: var(--space-lg);
  }

  /* Tablet */

  @media (max-width: 64rem) {
    .feature-grid,
    .feature-grid--reverse {
      grid-template-columns: 1fr;
    }

    .feature-grid--reverse .feature-content,
    .feature-grid--reverse > :not(.feature-content) {
      grid-column: auto;
      grid-row: auto;
    }

    .product-tree {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tree-card:nth-child(3),
    .tree-card:nth-child(4) {
      border-top: 1px solid var(--color-border);
    }

    .tree-card:nth-child(3) {
      border-inline-start: 0;
    }

    .cost-grid,
    .management-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cost-grid article:nth-child(3),
    .management-grid article:nth-child(3) {
      border-inline-start: 0;
      border-top: 1px solid var(--color-border);
    }

    .cost-grid article:nth-child(4),
    .management-grid article:nth-child(4) {
      border-top: 1px solid var(--color-border);
    }

    .report-layout {
      grid-template-columns: 1fr;
    }

    .lifecycle {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .lifecycle::before {
      top: 22px;
      bottom: 22px;
      inset-inline: auto;
      inset-inline-start: 22px;
      width: 1px;
      height: auto;
    }

    .lifecycle article {
      display: grid;
      grid-template-columns: 44px 1fr;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      text-align: start;
    }

    .lifecycle-marker {
      margin: 0;
    }

    .lifecycle article strong,
    .lifecycle article small {
      grid-column: 2;
    }

    .lifecycle article strong {
      grid-row: 1;
      align-self: end;
    }

    .lifecycle article small {
      grid-row: 2;
      margin-top: 0;
      align-self: start;
    }

    .lifecycle-marker {
      grid-row: 1 / span 2;
      grid-column: 1;
    }
  }

  /* Mobile */

  @media (max-width: 48rem) {
    h1 {
      font-size: clamp(2.5rem, 11vw, 4rem);
    }

    .section-heading h2,
    .feature-content h2,
    .cta-box h2 {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .product-tree,
    .cost-grid,
    .management-grid {
      grid-template-columns: 1fr;
    }

    .tree-card,
    .cost-grid article,
    .management-grid article {
      min-height: auto;
      border-inline-start: 0 !important;
      border-top: 1px solid var(--color-border);
    }

    .tree-card:first-child,
    .cost-grid article:first-child,
    .management-grid article:first-child {
      border-top: 0;
    }

    .feature-list,
    .history-list,
    .agent-list {
      grid-template-columns: 1fr;
    }

    .movement-panel {
      grid-template-columns: 1fr;
    }

    .movement-arrow {
      transform: rotate(-90deg);
    }

    .movement-alert {
      grid-column: auto;
    }

    .scan-results {
      grid-template-columns: 1fr;
    }

    .asset-status {
      grid-template-columns: 1fr;
    }

    .asset-status div + div {
      border-inline-start: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .agent-info {
      grid-template-columns: 1fr;
    }

    .agent-info div:nth-child(odd) {
      border-inline-end: 0;
    }

    .agent-info div + div {
      border-top: 1px solid var(--color-border);
    }

    .report-card__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .org-row {
      align-items: flex-start;
      flex-direction: column;
