---
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "گزارش‌ها و داشبوردها | Gamma ITSM";
const description =
  "گزارش‌ها و داشبوردهای Gamma ITSM برای تحلیل درخواست‌ها، دارایی‌ها، اقدامات، مصرف کالا و قطعات و عملکرد خدمات IT.";
---

<BaseLayout title={title} description={description}>
  <div class="reports-page">
    <!-- =====================================================
     Hero
     ===================================================== -->
    <section class="hero" id="overview">
      <div class="container">
        <nav class="breadcrumb" aria-label="مسیر صفحه">
          <a href="/">خانه</a>
          <span>/</span>
          <a href="/products/">محصولات</a>
          <span>/</span>
          <a href="/products/gammaitsm/">Gamma ITSM</a>
          <span>/</span>
          <span>گزارش‌ها</span>
        </nav>

        <div class="hero-content">
          <div class="hero-copy">
            <h1>
              گزارش‌ها و داشبوردها؛
              <span class="accent-text">تصمیم‌گیری با داده</span>
            </h1>

            <p class="hero-lead">
              اطلاعات واقعی عملیات خدمات IT را از درخواست و حادثه تا دارایی،
              انبار و اقدامات در یک نگاه ببینید و بر اساس آن تصمیم بگیرید.
            </p>
          </div>

          <div class="hero-visual">
            <div class="hero-report" aria-hidden="true">
              <div class="hero-report-top">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="hero-report-content">
                <div class="hero-report-title">
                  <span>داشبورد خدمات IT</span>
                  <strong>گزارش عملکرد</strong>
                </div>

                <div class="hero-report-metrics">
                  <div>
                    <small>درخواست‌ها:</small>
                    <strong>128</strong>
                    <span>این ماه</span>
                  </div>
                  <div>
                    <small>تأخیر: </small>
                    <strong>7٪</strong>
                    <span>از کل درخواست‌ها</span>
                  </div>
                  <div>
                    <small>دارایی‌ها: </small>
                    <strong>482</strong>
                    <span>ثبت شده</span>
                  </div>
                </div>

                <div class="hero-report-chart">
                  <i style="height: 36%"></i>
                  <i style="height: 54%"></i>
                  <i style="height: 44%"></i>
                  <i style="height: 70%"></i>
                  <i style="height: 62%"></i>
                  <i style="height: 86%"></i>
                </div>

                <div class="hero-report-footer">
                  <span>درخواست‌ها</span>
                  <span>دارایی‌ها</span>
                  <span>منابع</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Report domains
     ===================================================== -->
    <section class="reports-section" aria-labelledby="report-domains-title">
      <div class="container">
        <div class="section-heading">
          <h2 id="report-domains-title">
            گزارش بر اساس <span class="accent-text">اطلاعات عملیاتی</span>
          </h2>
          <p>
            گزارش‌ها می‌توانند بر پایه سند، دارایی، انبار یا اقدام ساخته شوند و
            هر کدام تصویر متفاوتی از عملکرد خدمات ارائه دهند.
          </p>
        </div>

        <div class="report-domains">
          <article class="report-domain">
            <span>۰۱</span>
            <h3>سند</h3>
            <p>
              درخواست‌ها، حوادث و سایر اسناد خدمات را با وضعیت، زمان و اطلاعات
              اجرایی بررسی کنید.
            </p>
          </article>

          <article class="report-domain">
            <span>۰۲</span>
            <h3>دارایی</h3>
            <p>
              وضعیت دارایی‌ها، هزینه، میزان استفاده، تعداد درخواست و ارتباط
              آن‌ها با واحدهای سازمانی را تحلیل کنید.
            </p>
          </article>

          <article class="report-domain">
            <span>۰۳</span>
            <h3>انبار</h3>
            <p>
              ورود و خروج کالا و قطعه، مصرف، موجودی و اقلام مورد استفاده را در
              گزارش‌های عملیاتی ببینید.
            </p>
          </article>

          <article class="report-domain">
            <span>۰۴</span>
            <h3>اقدام</h3>
            <p>
              عملکرد اقدام‌ها و فعالیت‌های انجام‌شده را بر اساس زمان، وضعیت،
              مسئول و نتیجه بررسی کنید.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Configurable dashboard
     ===================================================== -->
    <section class="reports-section reports-section--dark">
      <div class="container">
        <div class="dashboard-layout">
          <div class="dashboard-panel">
            <div class="dashboard-panel-header">
              <strong>داشبورد خدمات IT</strong>
              <span>قابل تنظیم</span>
            </div>

            <div class="dashboard-items">
              <div>
                <span>درخواست‌های باز</span>
                <strong>۴۲</strong>
              </div>
              <div>
                <span>منتظر پاسخ</span>
                <strong>۱۱</strong>
              </div>
              <div>
                <span>تأخیر در انجام</span>
                <strong>۷</strong>
              </div>
              <div>
                <span>انجام‌شده</span>
                <strong>۸۶</strong>
              </div>
            </div>
          </div>

          <div class="dashboard-copy">
            <h2>داشبورد قابل تنظیم</h2>
            <p>
              شاخص‌هایی را که برای تیم و مدیر خدمات مهم هستند کنار هم قرار دهید.
              داشبورد می‌تواند نمایی سریع از وضعیت درخواست‌ها، دارایی‌ها، منابع
              و اقدامات ارائه کند.
            </p>

            <div class="dashboard-point">
              <span>۱</span>
              <div>
                <h3>شاخص‌های موردنیاز را انتخاب کنید</h3>
                <p>
                  اطلاعات مهم را در یک نمای واحد قرار دهید و از پراکندگی
                  گزارش‌ها جلوگیری کنید.
                </p>
              </div>
            </div>

            <div class="dashboard-point">
              <span>۲</span>
              <div>
                <h3>گزارش را برای نقش خود ببینید</h3>
                <p>
                  نمای عملیاتی برای تیم پشتیبانی و نمای مدیریتی برای بررسی
                  روندها و عملکرد داشته باشید.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Request reports
     ===================================================== -->
    <section class="reports-section">
      <div class="container">
        <div class="split-section">
          <div class="split-copy">
            <h2>
              گزارش درخواست‌ها با
              <span class="accent-text">جستجوی پیشرفته</span>
            </h2>
            <p>
              درخواست‌ها را فقط بر اساس تعداد نبینید. آن‌ها را با ترکیب فیلترها
              و وضعیت‌های مختلف بررسی کنید تا مشخص شود چه چیزی بیشتر درخواست
              شده، چه چیزی دیر انجام شده و چه مواردی هنوز در انتظار هستند.
            </p>
            <p>
              گزارش می‌تواند بر اساس گروه سرویس، سرویس و درخواست متداول تهیه شود
              و بازه زمانی و سایر فیلدهای موردنیاز را نیز در تحلیل وارد کند.
            </p>
          </div>

          <div class="report-cards">
            <article class="report-card">
              <span class="report-card-number">گروه سرویس</span>
              <h3>نمای کلی خدمات</h3>
              <p>
                حجم درخواست‌ها را در سطح گروه سرویس مقایسه کنید و بخش‌های
                پرترافیک را سریع‌تر پیدا کنید.
              </p>
              <div class="report-card-tags">
                <span>تعداد</span>
                <span>روند زمانی</span>
                <span>وضعیت</span>
              </div>
            </article>

            <article class="report-card">
              <span class="report-card-number">سرویس</span>
              <h3>تحلیل هر سرویس</h3>
              <p>
                ببینید هر سرویس چه میزان درخواست دارد و زمان انجام و تأخیر آن
                چگونه است.
              </p>
              <div class="report-card-tags">
                <span>زمان انجام</span>
                <span>تأخیر</span>
                <span>انجام‌شده</span>
              </div>
            </article>

            <article class="report-card">
              <span class="report-card-number">درخواست متداول</span>
              <h3>شناخت الگوی تقاضا</h3>
              <p>
                درخواست‌های پرتکرار را شناسایی کنید و تمرکز بهتری روی خدمات
                پرتعداد داشته باشید.
              </p>
              <div class="report-card-tags">
                <span>تعداد</span>
                <span>بازه زمانی</span>
                <span>گروه‌بندی</span>
              </div>
            </article>

            <article class="report-card">
              <span class="report-card-number">وضعیت</span>
              <h3>پیگیری جریان کار</h3>
              <p>
                درخواست‌های انجام‌شده، در انتظار، متأخر و سایر وضعیت‌ها را در یک
                گزارش قابل فیلتر بررسی کنید.
              </p>
              <div class="report-card-tags">
                <span>منتظر</span>
                <span>تأخیر</span>
                <span>انجام‌شده</span>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Asset reports
     ===================================================== -->
    <section class="reports-section reports-section--soft">
      <div class="container">
        <div class="section-heading">
          <h2>
            گزارش دارایی‌ها؛ از
            <span class="accent-text">وضعیت تا هزینه</span>
          </h2>
          <p>
            دارایی‌ها را از زاویه‌های مختلف بررسی کنید و ارتباط هزینه، میزان
            استفاده و نیاز به پشتیبانی را بهتر بشناسید.
          </p>
        </div>

        <div class="analysis-list">
          <article>
            <span>۰۱</span>
            <div>
              <strong>دارایی‌های پرهزینه</strong>
              <small>
                شناسایی دارایی‌هایی که هزینه خرید، نگهداری یا پشتیبانی بیشتری
                ایجاد کرده‌اند.
              </small>
            </div>
          </article>

          <article>
            <span>۰۲</span>
            <div>
              <strong>دارایی‌های پر درخواست</strong>
              <small>
                پیدا کردن دارایی‌هایی که بیشترین درخواست یا حادثه را به خود
                اختصاص داده‌اند.
              </small>
            </div>
          </article>

          <article>
            <span>۰۳</span>
            <div>
              <strong>وضعیت دارایی</strong>
              <small>
                بررسی وضعیت دارایی و شناخت دارایی‌های فعال، در حال استفاده و
                سایر وضعیت‌های تعریف‌شده.
              </small>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Asset dimensions
     ===================================================== -->
    <section class="reports-section reports-section--dark">
      <div class="container">
        <div class="section-heading section-heading--dark">
          <h2>
            آمار دارایی به تفکیک
            <span class="accent-text">ابعاد مختلف</span>
          </h2>
          <p>
            برای تحلیل دقیق‌تر، اطلاعات دارایی را در ابعاد مختلف گروه‌بندی کنید.
          </p>
        </div>

        <div class="dimension-grid">
          <article>
            <span>کالا</span>
            <strong>مدل و نوع</strong>
            <small>تعداد دارایی‌های هر کالا</small>
          </article>

          <article>
            <span>برند</span>
            <strong>برند سازنده</strong>
            <small>مقایسه تعداد و وضعیت دارایی‌ها</small>
          </article>

          <article>
            <span>واحد سازمانی</span>
            <strong>محل سازمانی</strong>
            <small>توزیع دارایی بین واحدها</small>
          </article>

          <article>
            <span>سایر ابعاد</span>
            <strong>اطلاعات قابل تحلیل</strong>
            <small>گروه‌بندی بر اساس داده‌های موجود</small>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Inventory / consumption
     ===================================================== -->
    <section class="reports-section">
      <div class="container">
        <div class="split-section">
          <div class="inventory-card">
            <div class="inventory-card-header">
              <span>گزارش مصرف کالا و قطعه</span>
              <strong>مصرف را از چند زاویه ببینید</strong>
            </div>

            <div class="inventory-list">
              <div>
                <span>کالا</span>
                <strong>میزان مصرف</strong>
              </div>
              <div>
                <span>مدل</span>
                <strong>تفکیک مدل‌ها</strong>
              </div>
              <div>
                <span>واحد</span>
                <strong>مصرف هر واحد</strong>
              </div>
              <div>
                <span>فرستنده</span>
                <strong>عملیات مصرف</strong>
              </div>
            </div>
          </div>

          <div class="split-copy">
            <h2>گزارش مصرف کالا و قطعه</h2>
            <p>
              مصرف منابع را فقط در سطح انبار بررسی نکنید. مقدار مصرف را بر اساس
              کالا، مدل، واحد سازمانی، فرستنده و سایر اطلاعات مرتبط تحلیل کنید
              تا الگوی مصرف و نقاط پرهزینه مشخص شود.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Repeated incidents / requests
     ===================================================== -->
    <section class="reports-section reports-section--soft">
      <div class="container">
        <div class="section-heading">
          <h2>
            درخواست‌ها و حوادث تکراری؛
            <span class="accent-text">علت را پیدا کنید</span>
          </h2>
          <p>
            موارد تکراری را براساس نرم‌های تعریف‌شده در علت‌های ریشه‌ای بررسی
            کنید و نقاطی را که بیش از حد معمول تکرار می‌شوند شناسایی کنید.
          </p>
        </div>

        <div class="problem-flow">
          <div>
            <span>ورودی</span>
            <strong>درخواست یا حادثه</strong>
            <small>اطلاعات ثبت‌شده در عملیات خدمات</small>
          </div>

          <i aria-hidden="true"></i>

          <div>
            <span>تحلیل</span>
            <strong>الگوی تکرار</strong>
            <small>مقایسه با نرم‌های تعریف‌شده</small>
          </div>

          <i aria-hidden="true"></i>

          <div>
            <span>نتیجه</span>
            <strong>علت ریشه‌ای</strong>
            <small>تمرکز روی مسئله‌ای که باید اصلاح شود</small>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Components in use
     ===================================================== -->
    <section class="reports-section">
      <div class="container">
        <div class="split-section">
          <div class="split-copy">
            <h2>
              قطعات در حال استفاده روی
              <span class="accent-text">کامپیوترها</span>
            </h2>
            <p>
              بدانید هر قطعه در کدام تجهیزات استفاده شده است و وضعیت استفاده از
              قطعات را در سطح دارایی بررسی کنید.
            </p>
            <p>
              این گزارش برای کنترل تجهیزات، برنامه‌ریزی تعویض و شناخت وابستگی
              قطعات به دارایی‌ها کاربرد دارد.
            </p>
          </div>

          <div class="report-card">
            <span class="report-card-number">نمایش رابطه</span>
            <h3>قطعه ← رایانه</h3>
            <p>
              فهرست قطعات نصب‌شده و رایانه‌هایی که از آن‌ها استفاده می‌کنند، به
              شکل یک گزارش قابل بررسی در دسترس است.
            </p>
            <div class="report-card-tags">
              <span>قطعه</span>
              <span>رایانه</span>
              <span>وضعیت استفاده</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
     Summary
     ===================================================== -->
    <section class="reports-section reports-section--dark">
      <div class="container">
        <div class="reports-summary">
          <div class="summary-copy">
            <h2>اطلاعات عملیاتی را به تصمیم تبدیل کنید</h2>
            <p>
              گزارش‌های Gamma ITSM برای پاسخ دادن به سؤال‌های واقعی عملیات طراحی
              شده‌اند؛ چه تعداد درخواست داریم، کدام خدمات پرترافیک‌اند، چه
              دارایی‌هایی هزینه یا درخواست بیشتری دارند و منابع در کجا مصرف
              می‌شوند.
            </p>
          </div>

          <div class="summary-points">
            <div>
              <span>۰۱</span>
              <strong>تحلیل درخواست‌ها</strong>
            </div>
            <div>
              <span>۰۲</span>
              <strong>تحلیل دارایی‌ها</strong>
            </div>
            <div>
              <span>۰۳</span>
              <strong>تحلیل مصرف منابع</strong>
            </div>
            <div>
              <span>۰۴</span>
              <strong>تحلیل عملکرد</strong>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .reports-page {
    --reports-soft-line: color-mix(
      in srgb,
      var(--color-brand-dark) 12%,
      transparent
    );
    --reports-dark-line: color-mix(
      in srgb,
      var(--color-white) 16%,
      transparent
    );
  }

  /* Hero */
  .hero {
    background: var(--color-brand-dark);
  }

  .hero-report {
    width: min(100%, 28rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.045);
  }

  .hero-report-top {
    display: flex;
    gap: 0.35rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-report-top span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
  }

  .hero-report-content {
    padding: var(--space-md);
  }

  .hero-report-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hero-report-title span {
    color: rgba(216, 225, 223, 0.58);
    font-size: var(--font-size-xs);
  }

  .hero-report-title strong {
    color: var(--color-white);
    font-size: var(--font-size-sm);
  }

  .hero-report-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: var(--space-md);
  }

  .hero-report-metrics div {
    padding: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-report-metrics small,
  .hero-report-metrics strong,
  .hero-report-metrics span {
    display: block;
  }

  .hero-report-metrics small,
  .hero-report-metrics span {
    color: rgba(216, 225, 223, 0.52);
    font-size: var(--font-size-xs);
  }

  .hero-report-metrics strong {
    margin: 0.35rem 0;
    color: var(--color-white);
    font-size: 1.1rem;
  }

  .hero-report-chart {
    display: flex;
    align-items: end;
    gap: 0.45rem;
    height: 7rem;
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-report-chart i {
    flex: 1;
    min-width: 0;
    border-radius: 0.2rem 0.2rem 0 0;
