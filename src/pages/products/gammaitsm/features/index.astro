---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { GammaItsmCapabilityGroups } from "../../../../data/gammaitsm";
---

<BaseLayout
  title="قابلیت‌های GammaItsm | دومان سامانه"
  description="فهرست دسته‌بندی‌شده قابلیت‌های GammaItsm."
>
  <main class="features-page">
    <div class="container">
      <a class="breadcrumb" href="/products/gammaitsm/"
        >محصولات / GammaItsm / قابلیت‌ها</a
      >
      <p class="eyebrow">GammaItsm</p>
      <h1>قابلیت‌های GammaItsm</h1>
      <p class="intro">
        قابلیت‌های GammaItsm در دسته‌بندی‌های مرتبط با مدیریت خدمات فناوری
        اطلاعات ارائه شده‌اند.
      </p>
      <div class="feature-groups">
        {
          GammaItsmCapabilityGroups.map((group) => (
            <section aria-labelledby={group.slug}>
              <h2 id={group.slug}>{group.name}</h2>

              <div class="feature-list">
                {group.features.map((feature) => (
                  <a href={`/products/gammaitsm/features/${feature.slug}/`}>
                    <strong>{feature.name}</strong>
                    <span>{feature.description}</span>
                    <em aria-hidden="true">←</em>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      <a class="button button--accent" href="/contact/demo/">
        درخواست دموی GammaItsm
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  .features-page {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .breadcrumb {
    display: inline-block;
    margin-block-end: var(--space-lg);
    color: var(--color-secondary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
  }
  h1 {
    margin-block-end: var(--space-md);
    color: var(--color-primary);
    font-size: var(--font-size-h1);
  }
  .intro {
    max-width: 42rem;
    margin-block-end: var(--space-xl);
    color: var(--color-muted);
    font-size: 1.15rem;
  }
  .feature-groups {
    display: grid;
    gap: var(--space-xl);
    margin-block-end: var(--space-xl);
  }
  h2 {
    margin-block-end: var(--space-md);
    color: var(--color-primary);
    font-size: var(--font-size-h2);
  }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
  }
  .feature-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    padding-block: 1rem;
    border-block-start: 0.0625rem solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }
  .feature-list a:hover {
    color: var(--color-accent-dark);
  }
  .feature-list strong {
    font-size: 1.05rem;
  }
  .feature-list span {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }
  .feature-list em {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    color: var(--color-accent);
    font-style: normal;
  }
  @media (max-width: 47.99rem) {
    .feature-list {
      grid-template-columns: 1fr;
    }
  }
</style>
