---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductLogo from "@components/brand/ProductLogo.astro";
import SectionHeading from "@components/common/SectionHeading.astro";

import {
  zedEamBenefits,
  zedEamCapabilityGroups,
  zedEamLifecycle,
} from "@data/zed-eam";

import { zedEamModules } from "@data/zed-eam-modules";
---

<BaseLayout
  title="ZED EAM | نرم افزار مدیریت دارایی سازمانی | دومان سامانه"
  description="ZED EAM راهکار مدیریت دارایی سازمانی برای مدیریت دارایی‌ها، تجهیزات، نگهداری و تعمیرات و فرآیندهای مرتبط در سازمان‌ها است."
>
  <main class="page zed-page">
    <!-- =========================================================
         Hero
         ========================================================= -->

    <section class="hero" id="overview">
      <div class="container">
        <nav class="breadcrumb" aria-label="مسیر صفحه">
          <a href="/">خانه</a>
          <span>/</span>
          <a href="/products/">محصولات</a>
          <span>/</span>
          <span>ZED EAM</span>
        </nav>

        <div class="hero-content">
          <div class="hero-copy">
            <h1>
              ZED EAM؛
              <span class="accent-text">
                مدیریت یکپارچه دارایی‌های سازمانی
              </span>
            </h1>

            <p class="hero-lead">
              راهکاری جامع برای مدیریت دارایی‌ها، تجهیزات، نگهداری و تعمیرات و
              فرآیندهای مرتبط در سازمان‌های دارایی‌محور.
            </p>

            <div class="hero-actions">
              <a class="button button--accent" href="/contact/demo/">
                درخواست دمو
              </a>

              <a class="button button--secondary" href="#modules">
                آشنایی با زیرسیستم‌ها
              </a>
            </div>
          </div>

          <div class="hero-visual">
            <ProductLogo product="zed-eam" class="zed-logo" />

            <div class="asset-flow" aria-hidden="true">
              <span>دارایی</span>
              <i></i>
              <span>فرآیند</span>
              <i></i>
              <span>نگهداری</span>
              <i></i>
              <span>اطلاعات</span>
            </div>

            <p class="hero-visual-caption">از دارایی تا اطلاعات مدیریتی</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Experience
         ========================================================= -->

    <section class="experience-section">
      <div class="container">
        <div class="experience-grid">
          <div class="experience-copy">
            <p class="section-label">۲۰ سال تجربه</p>

            <SectionHeading title="فناوری جدید، تجربه‌ای کهنه‌کار" />

            <p>
              ZED EAM یک محصول تازه با تجربه‌ای تازه نیست. این محصول حاصل سال‌ها
              تجربه دومان سامانه در طراحی، توسعه و پیاده‌سازی نرم‌افزارهای
              سازمانی است.
            </p>

            <p>
              تجربه‌ای که طی دو دهه در کنار سازمان‌ها شکل گرفته، امروز در معماری
              و نسل جدید ZED ادامه پیدا کرده است؛ با فناوری‌های جدید و رویکردی
              تازه برای مدیریت دارایی‌های سازمانی.
            </p>
          </div>

          <div class="experience-stat">
            <strong>20</strong>
            <span>سال</span>
            <p>
              تجربه در توسعه<br />
              نرم‌افزارهای سازمانی
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Value
         ========================================================= -->

    <section
      class="content-section value-section"
      aria-labelledby="value-title"
    >
      <div class="container">
        <SectionHeading
          id="value-title"
          title="ZED فقط فهرستی از دارایی‌ها نیست"
          description="مدیریت دارایی زمانی ارزشمند است که اطلاعات، فرآیندها و عملیات مرتبط با دارایی در یک ساختار منسجم کنار هم قرار بگیرند."
        />

        <div class="value-grid">
          {
            zedEamBenefits.map((benefit) => (
              <article class="value-item">
                <h3>{benefit.title}</h3>
                <p>{benefit.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================
         Modules
         ========================================================= -->

    <section
      class="content-section modules-section"
      id="modules"
      aria-labelledby="modules-title"
    >
      <div class="container">
        <SectionHeading
          id="modules-title"
          title="زیرسیستم‌های ZED EAM"
          description="هر زیرسیستم بخشی از چرخه مدیریت دارایی را پوشش می‌دهد و قابلیت‌های مرتبط با همان حوزه را در اختیار سازمان قرار می‌دهد."
        />

        <div class="modules-list">
          {
            zedEamModules.map((module, index) => (
              <article class="zed-module">
                <div class="module-header">
                  <span class="module-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <div>
                    <h3>{module.name}</h3>

                    <p>{module.shortDescription}</p>
                  </div>
                </div>

                {module.features?.length > 0 && (
                  <div class="module-features">
                    <span class="module-features-label">قابلیت‌ها</span>

                    <ul>
                      {module.features.map((feature) => (
                        <li>
                          <strong>{feature.name}</strong>

                          {feature.description && (
                            <span>{feature.description}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================
         Architecture / Integration
         ========================================================= -->

    <section class="architecture-section">
      <div class="container">
        <div class="architecture-grid">
          <div class="architecture-copy">
            <p class="section-label">یک ساختار یکپارچه</p>

            <SectionHeading
              title="ماژول‌ها جدا نیستند؛ بخشی از یک سیستم هستند"
            />

            <p>
              ZED EAM زیرسیستم‌های مختلف مدیریت دارایی را در یک ساختار منسجم
              کنار هم قرار می‌دهد تا اطلاعات و فرآیندهای مرتبط با دارایی در
              بخش‌های مختلف سازمان پراکنده نباشد.
            </p>

            <p>
              ارتباط میان دارایی، نگهداری، فرآیندهای عملیاتی، اطلاعات فنی و
              گزارش‌های مدیریتی باعث می‌شود اطلاعات ثبت‌شده در هر بخش، برای
              بخش‌های دیگر نیز قابل استفاده باشد.
            </p>
          </div>

          <div class="architecture-flow">
            <div class="flow-node">
              <span>01</span>
              <strong>دارایی</strong>
              <small>اطلاعات پایه و شناسنامه</small>
            </div>

            <i></i>

            <div class="flow-node">
              <span>02</span>
              <strong>فرآیند</strong>
              <small>درخواست و عملیات</small>
            </div>

            <i></i>

            <div class="flow-node">
              <span>03</span>
              <strong>نگهداری</strong>
              <small>سرویس و تعمیرات</small>
            </div>

            <i></i>

            <div class="flow-node">
              <span>04</span>
              <strong>اطلاعات</strong>
              <small>گزارش و تصمیم‌گیری</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Capabilities
         ========================================================= -->

    <!-- <section
      class="content-section capabilities-section"
      id="capabilities"
      aria-labelledby="capabilities-title"
    >
      <div class="container">
        <SectionHeading id="capabilities-title" title="قابلیت‌های ZED EAM" />

        <div class="capability-grid">
          {
            zedEamCapabilityGroups.map((group) => (
              <article class="capability-group">
                <h3>{group.title}</h3>

                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section> -->

    <!-- =========================================================
         Lifecycle
         ========================================================= -->

    <section
      class="content-section lifecycle-section"
      aria-labelledby="lifecycle-title"
    >
      <div class="container">
        <div class="lifecycle-grid">
          <div>
            <SectionHeading
              id="lifecycle-title"
              title="مدیریت دارایی در تمام چرخه عمر"
            />

            <p>
              اطلاعات دارایی در یک نقطه متمرکز می‌شود تا سازمان بتواند وضعیت،
              سوابق و فرآیندهای مرتبط با دارایی‌ها را در طول چرخه عمر آن‌ها
              مدیریت کند.
            </p>
          </div>

          <ol class="lifecycle-list">
            {
              zedEamLifecycle.map((stage, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>

                  <strong>{stage}</strong>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Technology
         ========================================================= -->

    <section class="technology-section">
      <div class="container">
        <div class="technology-grid">
          <div>
            <p class="section-label">فناوری</p>

            <SectionHeading
              title="ساخته‌شده برای نسل جدید نرم‌افزارهای سازمانی"
            />

            <p>
              ZED بر پایه فناوری‌های جدید و معماری نرم‌افزارهای سازمانی توسعه
              یافته است تا علاوه بر پاسخ‌گویی به نیازهای امروز، امکان توسعه و
              تکامل محصول در سال‌های آینده نیز فراهم باشد.
            </p>
          </div>

          <div class="technology-stack">
            <div class="technology-item">
              <strong>.NET 10</strong>
              <span>Backend</span>
            </div>

            <div class="technology-item">
              <strong>Gamma.Kernel</strong>
              <span>Enterprise Application Framework</span>
            </div>

            <div class="technology-item">
              <strong>Vue 3</strong>
              <span>Frontend</span>
            </div>

            <div class="technology-item">
              <strong>Quasar</strong>
              <span>Application UI</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Audience
         ========================================================= -->

    <section
      class="content-section audience-section"
      aria-labelledby="audience-title"
    >
      <div class="container narrow-content">
        <SectionHeading
          id="audience-title"
          title="ZED EAM برای چه سازمان‌هایی مناسب است؟"
        />

        <p>
          ZED EAM برای سازمان‌های دارای تعداد زیاد تجهیزات، شرکت‌های صنعتی و
          خدماتی و سازمان‌هایی مناسب است که دارایی‌های فیزیکی گسترده، فرآیندهای
          نگهداری و تعمیرات پیچیده یا نیاز به مدیریت متمرکز اطلاعات دارایی
          دارند.
        </p>
      </div>
    </section>

    <!-- =========================================================
         Ecosystem
         ========================================================= -->

    <section class="ecosystem-section">
      <div class="container">
        <div class="ecosystem-grid">
          <div>
            <p class="section-label">دومان سامانه</p>

            <SectionHeading title="ZED؛ نسل جدید تجربه نرم‌افزارهای سازمانی" />
          </div>

          <p>
            ZED EAM یکی از محصولات سازمانی دومان سامانه است. تجربه‌ای که در طول
            سال‌ها توسعه و پیاده‌سازی راهکارهای سازمانی شکل گرفته، در این محصول
            با معماری و فناوری جدید ادامه پیدا کرده است.
          </p>
        </div>
      </div>
    </section>

    <!-- =========================================================
         CTA
         ========================================================= -->

    <section class="zed-cta">
      <div class="container">
        <div class="zed-cta-inner">
          <div>
            <p class="section-label">ZED EAM</p>

            <h2>
              دارایی‌های سازمان را
              <span>هوشمندانه‌تر مدیریت کنید</span>
            </h2>

            <p>
              برای آشنایی بیشتر با ZED EAM و بررسی تناسب آن با فرآیندهای سازمان
              خود با کارشناسان دومان سامانه در ارتباط باشید.
            </p>
          </div>

          <div class="zed-cta-actions">
            <a class="button button--accent" href="/contact/demo/">
              درخواست دمو
            </a>

            <a class="text-link" href="/contact/">
              تماس با ما
              <span aria-hidden="true">←</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* =========================================================
     ZED Product Theme
     ========================================================= */

  .zed-page {
    --zed-accent: #3b78a3;
    --zed-accent-dark: #2d5f83;
    --zed-accent-soft: #edf4f8;
    --zed-accent-line: rgba(59, 120, 163, 0.28);
  }

  /* =========================================================
     Hero
     ========================================================= */

  .zed-page .hero {
    --color-accent: var(--zed-accent);
    --color-accent-dark: var(--zed-accent-dark);

    background:
      radial-gradient(
        circle at 86% 20%,
        rgba(59, 120, 163, 0.12),
        transparent 30%
      ),
      var(--hero-corporate-background);

    padding-block: 1.25rem 7rem;
  }

  .zed-page .hero-content {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(20rem, 0.85fr);
    align-items: center;
    gap: 4rem;

    max-width: 80rem;
    margin-inline: auto;
  }

  .zed-page .hero-copy {
    max-width: 52rem;
  }

  .zed-page .hero-copy h1 {
    max-width: 50rem;
  }

  .zed-page .hero-lead {
    max-width: 42rem;
    margin-block-start: 1.75rem;
  }

  .zed-page .hero-actions {
    margin-block-start: 2rem;
  }

  .zed-page .accent-text {
    color: var(--zed-accent);
  }

  .zed-page .hero-visual {
    min-height: 18rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 2rem;

    border-inline-start: 1px solid rgba(216, 225, 223, 0.12);
  }

  .zed-logo {
    max-width: 14rem;
    max-height: 4rem;
  }

  :global(.product-logo-fallback.zed-logo) {
    color: var(--color-white);
    font-size: 2rem;
  }

  .asset-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;

    margin-block-start: 2.5rem;

    color: var(--color-text-on-dark);
    font-size: var(--font-size-sm);
  }

  .asset-flow i {
    width: 1.75rem;
    height: 0.0625rem;
    background: var(--zed-accent);
  }

  .hero-visual-caption {
    margin-block-start: 1.25rem;
    color: rgba(216, 225, 223, 0.7);
    font-size: var(--font-size-sm);
  }

  /* =========================================================
     Shared Sections
     ========================================================= */

  .content-section {
    padding-block: var(--space-xl);
  }

  .narrow-content {
    max-width: 52rem;
  }

  .content-section > .container > p,
  .narrow-content > p,
  .experience-copy > p,
  .architecture-copy > p,
  .technology-grid > div > p,
  .ecosystem-grid > p {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 2;
  }

  .section-label {
    margin-block-end: 1rem;
    color: var(--zed-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  /* =========================================================
     Experience
     ========================================================= */

  .experience-section {
    padding-block: var(--space-xl);
    background: var(--color-paper);
  }

  .experience-grid {
    display: grid;
    gap: 4rem;
    align-items: center;
  }

  .experience-copy {
    max-width: 50rem;
  }

  .experience-copy p:last-child {
    margin-block-end: 0;
  }

  .experience-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-height: 18rem;

    border: 1px solid var(--zed-accent-line);

    background: linear-gradient(145deg, rgba(59, 120, 163, 0.08), transparent);
  }

  .experience-stat strong {
    color: var(--zed-accent);
    font-size: clamp(6rem, 13vw, 10rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.08em;
  }

  .experience-stat > span {
    margin-block-start: 1rem;
    color: var(--color-primary);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .experience-stat p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    text-align: center;
    line-height: 1.8;
  }

  /* =========================================================
     Value
     ========================================================= */

  .value-section {
    background: var(--color-surface);
  }

  .value-grid {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: 3.5rem;
  }

  .value-item {
    padding-block-start: var(--space-md);
    border-block-start: 0.2rem solid var(--zed-accent);
  }

  .value-item h3 {
    margin-block-end: var(--space-sm);
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  .value-item p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.9;
  }

  /* =========================================================
     Modules
     ========================================================= */

  .modules-section {
    background: var(--color-paper);
  }

  .modules-list {
    display: grid;
    gap: 1rem;
    margin-block-start: 3.5rem;
  }

  .zed-module {
    padding: 1.5rem;

    border: 1px solid var(--color-border);
    border-inline-start: 0.3rem solid var(--zed-accent);

    background: var(--color-surface);

    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .zed-module:hover {
    border-color: var(--zed-accent-line);
    transform: translateY(-0.15rem);
    box-shadow: var(--shadow-soft);
  }

  .module-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .module-number {
    color: var(--zed-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
  }

  .module-header h3 {
    margin: 0;
    color: var(--color-primary);
    font-size: 1.3rem;
  }

  .module-header p {
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .module-features {
    margin-block-start: 1.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--color-border);
  }

  .module-features-label {
    display: block;
    margin-block-end: 0.75rem;

    color: var(--zed-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .module-features ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 2rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .module-features li {
    position: relative;
    padding-inline-start: 1rem;
  }

  .module-features li::before {
    position: absolute;
    inset-inline-start: 0;
    top: 0.8rem;

    width: 0.35rem;
    height: 0.35rem;

    border-radius: 50%;
    background: var(--zed-accent);

    content: "";
  }

  .module-features strong {
    display: block;
    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: var(--font-weight-semibold);
  }

  .module-features span {
    display: block;
    margin-block-start: 0.2rem;

    color: var(--color-muted);
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  /* =========================================================
     Architecture
     ========================================================= */

  .architecture-section {
    padding-block: var(--space-xl);
    background: var(--color-surface);
  }

  .architecture-grid {
    display: grid;
    gap: 4rem;
    align-items: center;
  }

  .architecture-copy {
    max-width: 48rem;
  }

  .architecture-flow {
    display: grid;
    gap: 0.75rem;
  }

  .flow-node {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;

    padding: 1.1rem 1.25rem;

    border: 1px solid var(--color-border);
    border-inline-start: 0.25rem solid var(--zed-accent);

    background: var(--color-paper);
  }

  .flow-node span {
    grid-row: span 2;

    color: var(--zed-accent);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .flow-node strong {
    color: var(--color-primary);
  }

  .flow-node small {
    color: var(--color-muted);
  }

  .architecture-flow > i {
    width: 1px;
    height: 1.25rem;
    margin-inline-start: 1.4rem;
