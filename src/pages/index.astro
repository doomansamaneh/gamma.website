---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHeroEcosystem from "../components/home/HomeHeroEcosystem.astro";
import ProductLogo from "../components/brand/ProductLogo.astro";
import SectionHeading from "../components/common/SectionHeading.astro";
import { products } from "../data/products";
---

<BaseLayout>
  <section class="intro">
    <div class="container intro-grid">
      <div class="intro-content">
        <p class="eyebrow">دومان سامانه</p>
        <h1>راهکارهای نرم‌افزاری سازمانی.</h1>
        <p class="intro-copy">
          دومان سامانه محصولات نرم‌افزاری برای حوزه‌های سازمانی و تخصصی طراحی و
          توسعه می‌دهد.
        </p>
        <div class="actions">
          <a class="button button--accent" href="/products/">مشاهده محصولات</a>
          <a class="text-link" href="/company/about/"
            >درباره دومان سامانه <span aria-hidden="true">←</span></a
          >
        </div>
      </div>
      <HomeHeroEcosystem />
    </div>
  </section>

  <section class="products" aria-labelledby="products-title">
    <div class="container">
      <SectionHeading
        id="products-title"
        title="یک اکوسیستم"
        description="هر محصول با تمرکز بر یک حوزه مستقل طراحی شده است."
      />
      <div class="product-grid">
        {
          products.map((product) => (
            <a
              class:list={{
                "product-card": true,
                "product-card--primary": product.primary,
              }}
              href={product.href}
            >
              <ProductLogo
                product={product.slug}
                compact
                class="product-card__logo"
              />
              <span class="product-name">{product.name}</span>
              <span>{product.description}</span>
              <span class="product-link">
                {product.slug === "gamma-kernel"
                  ? "مشاهده پروژه"
                  : "مشاهده محصول"}{" "}
                ←
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- <section class="overview" aria-labelledby="overview-title">
    <div class="container overview-grid">
      <div>
        <p class="eyebrow">دومان سامانه</p>
        <h2 id="overview-title">از مسئله تا راهکار</h2>
      </div>

      <p class="overview-copy">
        هر یک از محصولات دومان سامانه برای حل مسئله‌ای مشخص طراحی شده است؛
        راهکارهایی مستقل که در کنار یکدیگر، تجربه و توانمندی ما در توسعه
        نرم‌افزارهای تخصصی را شکل می‌دهند.
      </p>
    </div>
  </section> -->

  <!-- <CTA
    title="برای انتخاب مناسب‌ترین راهکار، با ما صحبت کنید."
    text="اگر نیاز به راهکاری خاص در سازمان شما دارید، تیم دومان سامانه به شما کمک می‌کند مناسب‌ترین محصول را پیدا کنید."
    primaryHref="/contact/demo/"
    primaryLabel="درخواست دمو"
    secondaryHref="/contact/"
    secondaryLabel="تماس با ما"
    compact
  /> -->
</BaseLayout>

<style>
  .intro {
    min-height: min(42rem, calc(100vh - 9.5rem));
    padding-block: clamp(5rem, 14vw, 10rem);
    background: var(--hero-corporate-background);
    color: white;
  }

  .intro-grid {
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .intro-content {
    min-width: 0;
  }

  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 56rem;
    margin: 0;
    font-size: var(--font-size-h1);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .intro-copy {
    max-width: 36rem;
    margin-block: var(--space-lg);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--color-text-on-dark);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .text-link {
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    margin-inline-start: 0.4rem;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(-0.25rem);
  }

  .overview {
    padding-block: var(--space-xl);
    background: var(--color-paper);
  }

  .products {
    padding-block: var(--space-xl);
    background: var(--color-surface);
  }

  .product-grid {
    display: grid;
    gap: var(--space-sm);
  }

  .product-card {
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: var(--space-md);
    border-block-start: 0.25rem solid var(--color-primary);
    background: var(--color-paper);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .product-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-0.2rem);
  }

  .product-card--primary {
    border-color: var(--color-accent);
  }

  .product-card__logo {
    max-width: 8.75rem;
    max-height: 2.5rem;
    margin-block-end: 0.25rem;
  }

  .product-name {
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 800;
    direction: ltr;
  }

  .product-card > span:nth-child(3) {
    color: var(--color-muted);
  }

  .product-link {
    margin-block-start: auto;
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: 700;
  }

  .overview-grid {
    display: grid;
    max-width: 48rem;
    margin-inline: auto;
    gap: var(--space-lg);
    text-align: center;
  }

  .overview h2 {
    max-width: none;
    margin-block-end: 0;
    font-size: var(--font-size-h2);
  }

  .overview-copy {
    max-width: 32rem;
    margin-block-end: 0;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  @media (min-width: 48rem) {
    .intro-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 47.99rem) {
    .intro-grid {
      gap: var(--space-lg);
    }
  }
</style>
