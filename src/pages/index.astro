---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/products";
---

<BaseLayout>
  <section class="intro">
    <div class="container">
      <p class="eyebrow">دومان سامانه</p>
      <h1>محصولات نرم‌افزاری برای مسائل واقعی.</h1>
      <p class="intro-copy">
        دومان سامانه یک شرکت فناوری است که محصولات نرم‌افزاری برای حوزه‌های
        سازمانی و تخصصی طراحی و توسعه می‌دهد.
      </p>
      <div class="actions">
        <a class="button button--accent" href="/products/">مشاهده محصولات</a>
        <a class="text-link" href="/company/about/"
          >درباره دومان سامانه <span aria-hidden="true">←</span></a
        >
      </div>
    </div>
  </section>
  <section class="products" aria-labelledby="products-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">سبد محصولات</p>
        <h2 id="products-title">چهار محصول، چهار حوزه تخصصی.</h2>
        <p>
          هر محصول مسیر و هویت مستقل خود را دارد و زیر چتر برند دومان سامانه
          توسعه پیدا می‌کند.
        </p>
      </div>
      <div class="product-grid">
        {
          products.map((product) => (
            <a
              class:list={{
                "product-card": true,
                "product-card--primary": product.primary,
              }}
              href={product.href}
            >
              <span class="product-mark" aria-hidden="true">
                {product.name.slice(0, 2)}
              </span>
              <span class="product-name">{product.name}</span>
              <span>{product.description}</span>
              <span class="product-link">
                {product.slug === "gamma-kernel"
                  ? "مشاهده پروژه"
                  : "مشاهده محصول"}{" "}
                ←
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="overview" aria-labelledby="overview-title">
    <div class="container overview-grid">
      <div>
        <p class="eyebrow">ساختار سایت</p>
        <h2 id="overview-title">یک شرکت، چند مسیر برای شناخت بهتر.</h2>
      </div>
      <p class="overview-copy">
        در این وب‌سایت، محصولات، منابع آموزشی و اطلاعات شرکت در ساختاری مستقل و
        قابل توسعه ارائه می‌شوند.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    min-height: min(42rem, calc(100vh - 9.5rem));
    padding-block: clamp(5rem, 14vw, 10rem);
    background: var(--color-primary);
    color: white;
  }

  .eyebrow {
    margin-block-end: 1rem;
    color: var(--color-accent-soft);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 56rem;
    margin: 0;
    font-size: var(--font-size-h1);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .intro-copy {
    max-width: 36rem;
    margin-block: 2rem;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
  }

  .intro-copy {
    color: #dbe5e3;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .text-link {
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    margin-inline-start: 0.4rem;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(-0.25rem);
  }

  .overview {
    padding-block: var(--space-xl);
    background: var(--color-paper);
  }

  .products {
    padding-block: var(--space-xl);
    background: var(--color-surface);
  }

  .section-heading {
    max-width: 42rem;
    margin-block-end: var(--space-lg);
  }

  .section-heading h2 {
    margin-block-end: var(--space-sm);
    color: var(--color-primary);
    font-size: var(--font-size-h2);
  }

  .section-heading p:last-child {
    margin-block-end: 0;
    color: var(--color-muted);
  }

  .product-grid {
    display: grid;
    gap: 1rem;
  }

  .product-card {
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
    border-block-start: 0.25rem solid var(--color-primary);
    background: var(--color-paper);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .product-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-0.2rem);
  }

  .product-card--primary {
    border-color: var(--color-accent);
  }

  .product-mark {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    background: var(--color-primary);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .product-name {
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 800;
    direction: ltr;
  }

  .product-card > span:nth-child(3) {
    color: var(--color-muted);
  }

  .product-link {
    margin-block-start: auto;
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: 700;
  }

  .overview-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .overview h2 {
    max-width: 14ch;
    margin-block-end: 0;
    font-size: var(--font-size-h2);
  }

  .overview-copy {
    max-width: 32rem;
    margin-block-end: 0;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  @media (min-width: 48rem) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .overview-grid {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
</style>
