---
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHeroEcosystem from "@components/home/HomeHeroEcosystem.astro";
import ProductLogo from "@components/brand/ProductLogo.astro";
import { products } from "@data/products";
---

<BaseLayout>
  <!-- =========================================================
       Hero
       ========================================================= -->

  <section class="intro">
    <div class="container intro-grid">
      <div class="intro-content">
        <h1>
          نرم‌افزارهای تخصصی برای
          <span class="accent-text">سازمانها، کسب و کارها</span>
        </h1>

        <p class="intro-copy">
          دومان سامانه راهکارهای نرم‌افزاری تخصصی برای مدیریت خدمات، دارایی‌ها،
          امور مالی و توسعه نرم‌افزارهای سازمانی طراحی و توسعه می‌دهد.
        </p>

        <div class="actions">
          <a class="button button--accent" href="/products/">
            مشاهده محصولات
          </a>

          <a class="text-link" href="/company/about/">
            درباره دومان سامانه
            <span aria-hidden="true">←</span>
          </a>
        </div>
      </div>

      <HomeHeroEcosystem />
    </div>
  </section>

  <section class="products" aria-labelledby="products-title">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">اکوسیستم محصولات</p>

        <h2 id="products-title">
          راهکارهای تخصصی برای
          <span class="accent-text"> نیازهای متفاوت </span>
        </h2>

        <p>
          محصولات دومان سامانه هرکدام برای یک حوزه مشخص طراحی شده‌اند؛ از مدیریت
          خدمات فناوری اطلاعات و دارایی‌های سازمانی تا حسابداری ابری و توسعه
          نرم‌افزارهای سازمانی.
        </p>
      </div>

      <div class="product-grid">
        {
          products.map((product) => (
            <a
              href={product.href}
              class:list={{
                "product-card": true,
                "product-card--primary": product.primary,
              }}
            >
              <div class="product-header">
                <ProductLogo
                  product={product.slug}
                  compact
                  class="product-logo"
                />

                {product.primary && (
                  <span class="product-badge">محصول اصلی</span>
                )}
              </div>

              <div class="product-content">
                <h3 class="product-name">{product.name}</h3>

                <p class="product-category">{product.category}</p>

                <p class="product-description">{product.description}</p>
              </div>

              <div class="product-footer">
                <span>
                  {product.slug === "gamma-kernel"
                    ? "مشاهده پروژه"
                    : "مشاهده محصول"}
                </span>

                <span aria-hidden="true">←</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================================================
       Philosophy
       ========================================================= -->

  <section class="philosophy" aria-labelledby="philosophy-title">
    <div class="container philosophy-grid">
      <div class="philosophy-heading">
        <p class="section-label">رویکرد ما</p>

        <h2 id="philosophy-title">
          از مسئله شروع می‌کنیم،
          <span class="accent-text"> نه از محصول </span>
        </h2>
      </div>

      <div class="philosophy-content">
        <p class="philosophy-lead">
          نرم‌افزار سازمانی زمانی ارزشمند است که با فرآیندهای واقعی سازمان
          هماهنگ باشد و بتواند یک مسئله عملیاتی را به شکل قابل اتکا حل کند.
        </p>

        <p>
          به همین دلیل محصولات دومان سامانه بر اساس حوزه‌های مشخص و نیازهای
          واقعی کسب و کارها و سازمان‌ها شکل گرفته‌اند؛ با تمرکز بر عمق محصول،
          قابلیت توسعه و استفاده در محیط‌های سازمانی.
        </p>

        <a class="inline-link" href="/company/about/">
          بیشتر درباره دومان سامانه
          <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       Domains
       ========================================================= -->

  <section class="domains" aria-labelledby="domains-title">
    <div class="container">
      <div class="section-intro section-intro--center">
        <p class="section-label">حوزه‌های فعالیت</p>

        <h2 id="domains-title">
          فناوری در خدمت
          <span class="accent-text"> فرآیندهای سازمان </span>
        </h2>

        <p>
          از مدیریت خدمات فناوری اطلاعات تا مدیریت دارایی، امور مالی و توسعه
          نرم‌افزارهای سازمانی.
        </p>
      </div>

      <div class="domain-list">
        <div class="domain-item">
          <span class="domain-number"> 01 </span>

          <div>
            <h3>مدیریت خدمات فناوری اطلاعات</h3>

            <p>
              مدیریت درخواست‌ها، رخدادها، مشکلات، تغییرات، دارایی‌ها و فرآیندهای
              خدمات IT.
            </p>
          </div>
        </div>

        <div class="domain-item">
          <span class="domain-number"> 02 </span>

          <div>
            <h3>مدیریت دارایی‌های سازمانی</h3>

            <p>
              مدیریت چرخه عمر دارایی‌ها، تجهیزات و فرآیندهای نگهداری و
              بهره‌برداری سازمان.
            </p>
          </div>
        </div>

        <div class="domain-item">
          <span class="domain-number"> 03 </span>

          <div>
            <h3>حسابداری و امور مالی</h3>

            <p>
              راهکار حسابداری ابری برای کسب و کارهای کوچک و متوسط با تمرکز بر
              سادگی و دسترسی آنلاین.
            </p>
          </div>
        </div>

        <div class="domain-item">
          <span class="domain-number"> 04 </span>

          <div>
            <h3>توسعه نرم‌افزار سازمانی</h3>

            <p>
              چارچوب‌ها و زیرساخت‌های نرم‌افزاری برای توسعه برنامه‌های سازمانی
              مبتنی بر .NET.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       CTA
       ========================================================= -->

  <section class="final-cta">
    <div class="container final-cta-inner">
      <div>
        <p class="section-label">دومان سامانه</p>

        <h2>
          درباره راهکار مناسب
          <span class="accent-text"> صحبت کنیم </span>
        </h2>

        <p>
          اگر برای سازمان خود به دنبال یک راهکار نرم‌افزاری تخصصی هستید، محصولات
          دومان سامانه را بررسی کنید یا با ما در تماس باشید.
        </p>
      </div>

      <div class="final-cta-actions">
        <a class="button button--accent" href="/contact/demo/"> درخواست دمو </a>

        <a class="button button--secondary" href="/contact/"> تماس با ما </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================
   Hero
   ========================================================= */

  .intro {
    padding-block: clamp(5rem, 12vw, 9rem);
    background: var(--hero-corporate-background);
    color: var(--color-text-on-dark);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .intro-content {
    min-width: 0;
  }

  .intro-copy {
    max-width: 40rem;
    margin-block: var(--space-lg);
    color: var(--color-text-on-dark);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 2;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .text-link {
    color: var(--color-white);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .text-link span,
  .inline-link span {
    display: inline-block;
    margin-inline-start: 0.4rem;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span,
  .inline-link:hover span {
    transform: translateX(-0.25rem);
  }

  /* =========================================================
   Products Cards
   ========================================================= */

  .products {
    padding-block: clamp(5rem, 10vw, 8rem);
    background: var(--color-surface);
  }

  .product-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: var(--space-lg);
  }

  .product-card {
    position: relative;

    display: flex;

    flex-direction: column;

    min-height: 22rem;

    padding: clamp(1.75rem, 3vw, 2.5rem);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    background: var(--color-white);

    text-decoration: none;

    overflow: hidden;

    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .product-card::before {
    content: "";

    position: absolute;

    inset-inline-start: 0;

    inset-block-start: 0;

    width: 100%;

    height: 4px;

    background: transparent;

    transition: background var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-6px);

    box-shadow: var(--shadow-soft);

    border-color: rgba(239, 63, 35, 0.35);
  }

  .product-card:hover::before,
  .product-card--primary::before {
    background: var(--color-accent);
  }

  .product-card--primary {
    background: linear-gradient(
      180deg,
      var(--color-white),
      var(--color-brand-subtle)
    );
  }

  .product-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;
  }

  .product-logo {
    max-width: 10rem;

    max-height: 3rem;
  }

  .product-badge {
    padding: 0.3rem 0.75rem;

    border-radius: 999px;

    background: var(--color-brand-subtle);

    color: var(--color-accent-dark);

    font-size: var(--font-size-xs);

    font-weight: var(--font-weight-semibold);
  }

  .product-content {
    margin-top: 2.25rem;
  }

  .product-name {
    margin: 0;

    color: var(--color-primary);

    font-size: 1.35rem;

    font-weight: var(--font-weight-bold);

    direction: ltr;
  }

  .product-category {
    margin-top: 0.5rem;

    color: var(--color-accent-dark);

    font-size: var(--font-size-sm);

    font-weight: var(--font-weight-semibold);
  }

  .product-description {
    margin-top: 1rem;

    color: var(--color-muted);

    line-height: 1.9;
  }

  .product-footer {
    display: flex;

    align-items: center;

    gap: 0.5rem;

    margin-top: auto;

    padding-top: 2rem;

    color: var(--color-primary);

    font-size: var(--font-size-sm);

    font-weight: var(--font-weight-bold);
  }

  .product-footer span:last-child {
    transition: transform var(--transition-fast);
  }

  .product-card:hover .product-footer span:last-child {
    transform: translateX(-0.25rem);
  }

  /* =========================================================
   Philosophy
   ========================================================= */

  .philosophy {
    padding-block: clamp(5rem, 10vw, 8rem);
    background: var(--color-paper);
  }

  .philosophy-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap: clamp(3rem, 9vw, 9rem);

    align-items: start;
  }

  .philosophy-content {
    max-width: 42rem;
  }

  .philosophy-lead {
    margin: 0;

    color: var(--color-primary);

    font-size: clamp(1.25rem, 2.5vw, 1.65rem);

    line-height: 1.8;
  }

  .philosophy-content > p:not(.philosophy-lead) {
    margin-block: var(--space-lg);

    color: var(--color-muted);

    line-height: 2;
  }

  .inline-link {
    color: var(--color-primary);

    font-weight: var(--font-weight-bold);

    text-decoration: none;
  }

  .inline-link:hover {
    color: var(--color-accent);
  }

  /* =========================================================
   Domains
   ========================================================= */

  .domains {
    padding-block: clamp(5rem, 10vw, 8rem);

    background: var(--color-primary);

    color: var(--color-text-on-dark);
  }

  .section-intro--center {
    max-width: 44rem;

    margin-inline: auto;

    text-align: center;
  }

  .domains .section-intro h2 {
    color: var(--color-white);
  }

  .domains .section-intro > p:last-child {
    margin-inline: auto;

    color: rgba(216, 225, 223, 0.72);
  }

  .domain-list {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    margin-top: 4rem;

    border-top: 1px solid rgba(216, 225, 223, 0.16);
  }

  .domain-item {
    display: grid;

    grid-template-columns: 3rem minmax(0, 1fr);

    gap: 1.5rem;

    padding: 2rem 1rem 2rem 0;

    border-bottom: 1px solid rgba(216, 225, 223, 0.16);
  }

  .domain-item:nth-child(odd) {
    padding-inline-end: 3rem;

    border-inline-end: 1px solid rgba(216, 225, 223, 0.16);
  }

  .domain-item:nth-child(even) {
    padding-inline-start: 3rem;
  }

  .domain-number {
    color: var(--color-accent);

    font-size: var(--font-size-sm);

    font-weight: var(--font-weight-bold);

    direction: ltr;
  }

  .domain-item h3 {
    margin: 0;

    color: var(--color-white);

    font-size: 1.2rem;
  }

  .domain-item p {
    margin-top: 0.75rem;

    color: rgba(216, 225, 223, 0.68);

    line-height: 1.9;
  }

  /* =========================================================
   CTA
   ========================================================= */

  .final-cta {
    padding-block: clamp(4rem, 8vw, 6rem);

    background: var(--color-surface);
  }

  .final-cta-inner {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 3rem;
  }

  .final-cta p:last-child {
    max-width: 38rem;

    margin-block: var(--space-md) 0;

    color: var(--color-muted);

    line-height: 1.9;
  }

  .final-cta-actions {
    display: flex;

    flex-shrink: 0;

    flex-wrap: wrap;

    gap: var(--space-sm);
  }

  /* =========================================================
   Responsive
   ========================================================= */

  @media (max-width: 64rem) {
    .intro-grid,
    .philosophy-grid {
      grid-template-columns: 1fr;
    }

    .final-cta-inner {
      align-items: flex-start;

      flex-direction: column;
    }
  }

  @media (max-width: 48rem) {
    .intro {
      padding-block: 4.5rem 5rem;
    }

    .product-grid,
    .domain-list {
      grid-template-columns: 1fr;
    }

    .product-card {
      min-height: 18rem;
    }

    .domain-item,
    .domain-item:nth-child(odd),
    .domain-item:nth-child(even) {
      grid-template-columns: 2.5rem minmax(0, 1fr);

      padding-inline: 0;

      border-inline-end: 0;
    }

    .final-cta-actions {
      width: 100%;
    }

    .final-cta-actions .button {
      flex: 1;
    }
  }
</style>
