---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="تماس با ما | دومان سامانه"
  description="برای دریافت اطلاعات بیشتر درباره محصولات دومان سامانه، درخواست دمو، مشاوره و ارتباط با واحد فروش و پشتیبانی با ما در تماس باشید."
>
  <main class="contact-page">
    <!-- =========================================================
         Hero
         ========================================================= -->

    <section class="hero" id="overview">
      <div class="container">
        <nav class="breadcrumb" aria-label="مسیر صفحه">
          <a href="/">خانه</a>
          <span>/</span>
          <span>تماس با ما</span>
        </nav>

        <div class="hero-content">
          <div class="hero-copy">
            <p class="hero-label">ارتباط با دومان سامانه</p>

            <h1>
              برای شروع یک
              <span class="accent-text">گفت‌وگوی واقعی</span>
              با ما در تماس باشید
            </h1>

            <p class="hero-lead">
              اگر درباره محصولات، راهکارهای سازمانی، دریافت دمو یا نحوه استقرار
              و استفاده از راهکارهای دومان سامانه سوالی دارید، کارشناسان ما
              آماده پاسخگویی هستند.
            </p>

            <div class="hero-actions">
              <a class="button button--accent" href="/contact/demo/">
                درخواست دموی اختصاصی
              </a>

              <a class="button button--secondary" href="#contact-info">
                اطلاعات تماس
              </a>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="contact-visual">
              <span class="contact-visual-label">DOOMAN SAMANEH</span>
              <strong>ارتباط</strong>
              <span>فروش · مشاوره · پشتیبانی</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Contact Information
         ========================================================= -->

    <section class="contact-section" id="contact-info">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">اطلاعات تماس</p>

          <h2>
            از یکی از راه‌های
            <span class="accent-text">زیر با ما در ارتباط باشید</span>
          </h2>

          <p>
            برای دریافت مشاوره، اطلاعات محصولات، هماهنگی جلسه و یا پیگیری
            درخواست‌های خود می‌توانید با واحد مربوطه تماس بگیرید.
          </p>
        </div>

        <div class="contact-grid">
          <!-- Sales -->

          <article class="contact-card contact-card--primary">
            <div class="contact-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2
                  19.79 19.79 0 0 1-8.63-3.07
                  19.5 19.5 0 0 1-6-6
                  A19.79 19.79 0 0 1 2.12 4.18
                  2 2 0 0 1 5.11 2h3
                  a2 2 0 0 1 2 1.72
                  c.12.9.33 1.77.62 2.61
                  a2 2 0 0 1-.45 2.11L9 9.91
                  a16 16 0 0 0 6 6l1.47-1.47
                  a2 2 0 0 1 2.11-.45
                  c.84.29 1.71.5 2.61.62
                  A2 2 0 0 1 22 16.92Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>

            <p class="contact-card-label">فروش و مشاوره</p>

            <h3>واحد فروش</h3>

            <p>
              برای آشنایی با محصولات، دریافت مشاوره و هماهنگی جلسه با کارشناسان
              فروش تماس بگیرید.
            </p>

            <div class="contact-details">
              <a href="tel:02188539251">
                <span>تلفن فروش</span>
                <strong>021-88569251</strong>
              </a>

              <a href="tel:09362330888">
                <span>موبایل</span>
                <strong>0936-2330888</strong>
              </a>

              <a href="gammaDesk.sale@gmail.com">
                <span>ایمیل فروش</span>
                <strong>gammaDesk.sale@gmail.com</strong>
              </a>
            </div>
          </article>

          <!-- Support -->

          <article class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path
                  d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>

            <p class="contact-card-label">پشتیبانی</p>

            <h3>واحد پشتیبانی</h3>

            <p>
              برای پیگیری درخواست‌های پشتیبانی و دریافت راهنمایی درباره محصولات
              با واحد پشتیبانی در ارتباط باشید.
            </p>

            <div class="contact-details">
              <a href="tel:09220634538">
                <span>تلفن پشتیبانی</span>
                <strong>0922-0634538</strong>
              </a>

              <a href="tel:09124593902">
                <span>تلفن پشتیبانی</span>
                <strong>0912-4593902</strong>
              </a>

              <a href="mailto:help.gammaDesk@gmail.com">
                <span>ایمیل پشتیبانی</span>
                <strong>help.gammaDesk@gmail.com</strong>
              </a>
            </div>
          </article>

          <!-- General -->

          <article class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path
                  d="M4 4h16v16H4z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"></path>
                <path
                  d="m4 7 8 6 8-6"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>

            <p class="contact-card-label">ارتباط عمومی</p>

            <h3>ایمیل و ارتباطات</h3>

            <p>
              برای ارتباطات عمومی و ارسال مکاتبات می‌توانید از ایمیل عمومی شرکت
              استفاده کنید.
            </p>

            <div class="contact-details">
              <a href="mailto:gammaDesk@gmail.com">
                <span>ایمیل عمومی</span>
                <strong>gammaDesk@gmail.com</strong>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Office / Working Hours
         ========================================================= -->

    <section class="contact-extra">
      <div class="container">
        <div class="contact-extra-grid">
          <div class="contact-extra-content">
            <p class="section-label">دفتر و شرکت</p>

            <h2>
              اطلاعات
              <span class="accent-text">دفتر مرکزی</span>
            </h2>

            <address>
              تهران، اندیشه، شهرک صدف، مجتمع اداری زیتون، واحد 103
            </address>
          </div>

          <div class="office-details">
            <div class="office-item">
              <span class="office-item-label">ساعات کاری</span>
              <strong>شنبه تا چهارشنبه</strong>
              <span>09:00 تا 17:00</span>
            </div>

            <!-- <div class="office-item">
              <span class="office-item-label">تلفن دفتر</span>
              <a href="tel:XXXXXXXXXXX"> ۰۲۱-XXXXXXXX </a>
            </div> -->
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         Demo CTA
         ========================================================= -->

    <section class="contact-cta">
      <div class="container">
        <div class="contact-cta-inner">
          <div>
            <p class="section-label">تجربه محصولات</p>

            <h2>
              قبل از تماس،
              <span class="accent-text">محصول را خودتان ببینید</span>
            </h2>

            <p>
              اگر برای ارزیابی Gamma ITSM نیاز به مشاهده عملی محصول دارید،
              می‌توانید ابتدا دموی آنلاین را تجربه کنید یا برای دریافت دموی
              اختصاصی درخواست خود را ثبت کنید.
            </p>
          </div>

          <div class="contact-cta-actions">
            <a class="button button--accent" href="/contact/demo/">
              درخواست دموی اختصاصی
            </a>

            <a class="button button--secondary" href="/products/gammaitsm/">
              آشنایی با Gamma ITSM
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* =========================================================
   Contact Page
   ========================================================= */

  .contact-page {
    /* =======================================================
     Hero
     ======================================================= */

    .hero {
      background: var(--hero-corporate-background);
      color: var(--color-text-on-dark);
    }

    .hero-content {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: center;
      min-height: 34rem;
    }

    .hero-copy {
      max-width: 50rem;
    }

    .hero-copy h1 {
      max-width: 48rem;
      margin: var(--space-lg) 0 var(--space-md);
      color: var(--color-white);
    }

    .hero-lead {
      max-width: 42rem;
      margin: 0;
      color: #c8d0ce;
      font-size: clamp(1.05rem, 2vw, 1.2rem);
      line-height: var(--line-height-relaxed);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-top: var(--space-lg);
    }

    .hero-visual {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* =======================================================
     Contact Visual
     ======================================================= */

    .contact-visual {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: min(100%, 24rem);
      aspect-ratio: 1;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-lg);
      background:
        radial-gradient(
          circle at 50% 35%,
          rgba(239, 63, 35, 0.14),
          transparent 48%
        ),
        rgba(255, 255, 255, 0.025);
      box-shadow: var(--shadow-soft);
      text-align: center;
    }

    .contact-visual-label {
      margin-bottom: var(--space-md);
      color: #8f9997;
      font-size: 0.7rem;
      font-weight: var(--font-weight-semibold);
      letter-spacing: 0.16em;
    }

    .contact-visual strong {
      color: var(--color-white);
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 1;
      font-weight: var(--font-weight-bold);
    }

    .contact-visual > span:last-child {
      margin-top: var(--space-md);
      color: #adb7b4;
      font-size: var(--font-size-sm);
    }

    /* =======================================================
     Buttons
     ======================================================= */

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding-inline: 1.25rem;
      border-radius: var(--radius-md);
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
      transition:
        background var(--transition-fast),
        color var(--transition-fast),
        border-color var(--transition-fast);
    }

    .button--accent {
      border: 1px solid var(--color-accent);
      background: var(--color-accent);
      color: var(--color-white);
    }

    .button--accent:hover {
      background: var(--color-accent-dark);
      border-color: var(--color-accent-dark);
    }

    .button--secondary {
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: transparent;
      color: var(--color-white);
    }

    .button--secondary:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    /* =======================================================
     Contact Information
     ======================================================= */

    .contact-section {
      padding-block: var(--space-xl);
    }

    .section-heading {
      max-width: 54rem;
      margin-bottom: var(--space-xl);
    }

    .section-heading .section-label {
      color: var(--color-accent);
    }

    .section-heading > p:last-child {
      max-width: 48rem;
      margin: var(--space-md) 0 0;
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }

    .contact-card {
      padding: clamp(1.5rem, 3vw, 2rem);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }

    .contact-card--primary {
      border-color: color-mix(
        in srgb,
        var(--color-accent) 28%,
        var(--color-border)
      );
    }

    .contact-card-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      margin-bottom: var(--space-md);
      border-radius: var(--radius-md);
      background: var(--color-brand-subtle);
      color: var(--color-accent);
    }

    .contact-card-icon svg {
      width: 1.4rem;
      height: 1.4rem;
    }

    .contact-card-label {
      margin: 0 0 0.35rem;
      color: var(--color-accent);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    .contact-card h3 {
      margin: 0;
      font-size: var(--font-size-xl);
    }

    .contact-card > p:not(.contact-card-label) {
      min-height: 5.5rem;
      margin: var(--space-sm) 0 var(--space-lg);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .contact-details {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
    }

    .contact-details a {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      color: var(--color-text-primary);
      text-decoration: none;
    }

    .contact-details a:hover strong {
      color: var(--color-accent);
    }

    .contact-details span {
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
    }

    .contact-details strong {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      transition: color var(--transition-fast);
    }

    /* =======================================================
     Office
     ======================================================= */

    .contact-extra {
      padding-block: var(--space-xl);
      background: var(--color-surface);
      border-block: 1px solid var(--color-border);
    }

    .contact-extra-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
    }

    .contact-extra-content .section-label {
      color: var(--color-accent);
    }

    .contact-extra-content p:not(.section-label) {
      max-width: 42rem;
      margin: var(--space-md) 0;
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }

    .contact-extra-content address {
      margin-top: var(--space-lg);
      padding-top: var(--space-md);
      border-top: 1px solid var(--color-border);
      color: var(--color-text-primary);
      font-style: normal;
      line-height: var(--line-height-relaxed);
    }

    .office-details {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--color-border);
    }

    .office-item {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding-block: var(--space-md);
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-secondary);
      line-height: var(--line-height-normal);
    }

    .office-item-label {
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
    }

    .office-item strong,
    .office-item a {
      color: var(--color-text-primary);
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
    }

    .office-item a:hover {
      color: var(--color-accent);
    }

    /* =======================================================
     CTA
     ======================================================= */

    .contact-cta {
      padding-block: var(--space-xl);
    }

    .contact-cta-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-xl);
      padding: clamp(2rem, 5vw, 4rem);
      border-radius: var(--radius-lg);
      background: var(--hero-corporate-background);
      color: var(--color-white);
    }

    .contact-cta-inner > div:first-child {
      max-width: 48rem;
    }

    .contact-cta .section-label {
      color: #bfc8c5;
    }

    .contact-cta p:not(.section-label) {
      margin: var(--space-md) 0 0;
      color: #c4ccca;
      line-height: var(--line-height-relaxed);
    }

    .contact-cta-actions {
      display: flex;
      flex-shrink: 0;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    /* =======================================================
     IMPORTANT:
     Do not override global accent-text rules here.
     ======================================================= */

    .contact-page h1 .accent-text,
    .contact-page h2 .accent-text {
      color: var(--color-accent);
    }

    /* =======================================================
     Responsive
     ======================================================= */

    @media (max-width: 64rem) {
      .hero-content {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-visual {
        justify-content: flex-start;
        min-height: auto;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .contact-card > p:not(.contact-card-label) {
        min-height: auto;
      }

      .contact-extra-grid {
        grid-template-columns: 1fr;
        gap: var(--space-xl);
      }

      .contact-cta-inner {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 40rem) {
      .contact-cta-actions {
        width: 100%;
      }

      .contact-cta-actions .button {
        width: 100%;
      }

      .contact-visual {
        width: 100%;
        max-width: 20rem;
      }

      .contact-section,
      .contact-extra,
      .contact-cta {
        padding-block: 4rem;
      }
    }
  }
</style>
