---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/common/SectionHeading.astro";
import CTA from "../../../components/common/CTA.astro";
---

<BaseLayout
  title="ماموریت و چشم‌انداز | دومان سامانه"
  description="ماموریت و چشم‌انداز دومان سامانه؛ ساخت نرم‌افزارهای سازمانی قابل اعتماد، ماندگار و ارزش‌آفرین برای کسب و کارها."
>
  <section class="mission-hero">
    <div class="container hero-grid">
      <div>
        <h1>چشم‌انداز دومان سامانه</h1>
        <p class="hero-copy">
          آنچه امروز می‌سازیم، برای حل نیازهای واقعی کسب و کارهاست؛ و آنچه برای
          آینده دنبال می‌کنیم، ساخت نرم‌افزارهای ماندگار، قابل توسعه و
          ارزش‌آفرین است.
        </p>
        <div class="actions">
          <a class="button button--accent" href="/products/">مشاهده محصولات</a>
          <a class="text-link" href="/company/about/"
            >درباره ما <span aria-hidden="true">←</span></a
          >
        </div>
      </div>
      <div class="hero-panel">
        <div class="panel-label">ارزش‌های اصلی</div>
        <ul>
          <li>حل مسئله واقعی سازمان</li>
          <li>توسعه مستمر</li>
          <li>کیفیت مهندسی</li>
          <li>ارزش بلندمدت</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mission-section">
    <div class="container">
      <SectionHeading
        title="ماموریت ما"
        description="دومان سامانه برای ایجاد ارزش در سازمان‌ها، نرم‌افزارهایی می‌سازد که فرآیندهای پیچیده را ساده‌تر، تصمیم‌گیری را دقیق‌تر و بهره‌وری را پایدارتر می‌کنند."
      />

      <div class="mission-grid">
        <article class="info-card info-card--primary">
          <h3>چرا وجود داریم؟</h3>
          <p>
            چون نیازهای واقعی کسب و کارها و سازمان‌ها را با ابزارهای فنی مناسب
            پاسخ می‌دهیم؛ با هدف تبدیل پیچیدگی‌های عملیاتی به سیستم‌های قابل
            کنترل، قابل استفاده و قابل توسعه.
          </p>
        </article>
        <article class="info-card">
          <h3>چه ارزشی می‌سازیم؟</h3>
          <p>
            ارزش ما در ساخت نرم‌افزارهای قابل اعتماد و ماندگار است؛
            نرم‌افزارهایی که با درک عمیق از کسب و کار، عملکردی روشن و تجربه‌ای
            حرفه‌ای برای کاربران فراهم می‌کنند.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="vision-section">
    <div class="container">
      <SectionHeading
        title="چشم‌انداز ما"
        description="دومان سامانه به دنبال آن است که در مسیر توسعه فناوری و نرم‌افزارهای سازمانی، به یک شریک پایدار برای کسب و کارها تبدیل شود."
      />

      <div class="vision-layout">
        <div class="vision-copy">
          <p>
            چشم‌انداز ما، ساخت مجموعه‌ای از محصولات و فناوری‌هایی است که با رشد
            نیازهای سازمان‌ها، هم‌راستا و قابل گسترش بمانند. ما به دنبال آنیم که
            با تمرکز بر کیفیت مهندسی، توسعه مستمر و درک درست از فرآیندهای کسب و
            کار، راهکارهایی ایجاد کنیم که برای سال‌ها در اختیار کاربران قرار
            بگیرند.
          </p>
        </div>
        <ul class="vision-points">
          <li>توسعه یک سبد محصولات شرکت‌محور و واقع‌گرایانه</li>
          <li>حفظ تمرکز بر کیفیت نرم‌افزار و قابلیت اطمینان</li>
          <li>هم‌راستایی با نیازهای سازمانی و رشد تدریجی کسب و کار</li>
          <li>توسعه فناوری‌هایی که با تغییرات آینده سازگار بمانند</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <SectionHeading
        title="اصول ما"
        description="مبنا و جهت‌گیری ما در توسعه فناوری، بر شناخت درست مسئله و خلق ارزش پایدار استوار است."
      />

      <div class="principles-grid">
        <article class="principle-card">
          <h3>شناخت مسئله واقعی</h3>
          <p>
            قبل از ساخت، نیاز سازمان و فرایند کاری را به‌صورت دقیق درک می‌کنیم.
          </p>
        </article>
        <article class="principle-card">
          <h3>توسعه مستمر</h3>
          <p>
            محصولات ما با دید بلندمدت ساخته می‌شوند و در مسیر تغییرات سازمانی
            رشد می‌کنند.
          </p>
        </article>
        <article class="principle-card">
          <h3>کیفیت مهندسی</h3>
          <p>
            عملکرد، پایداری و قابلیت استفاده، از اولویت‌های اصلی طراحی و توسعه
            هستند.
          </p>
        </article>
        <article class="principle-card">
          <h3>ارزش برای مشتری</h3>
          <p>
            تمرکز ما بر نتیجه‌ی عملی برای سازمان‌ها و بهبود تجربه کاربران است.
          </p>
        </article>
      </div>
    </div>
  </section>

  <CTA
    title="برای آشنایی بیشتر با مسیر و راهکارهای دومان سامانه، با ما صحبت کنید."
    text="در دومان سامانه، توسعه نرم‌افزار با درک نیازهای کسب و کار و نگاه بلندمدت به آینده همراه است."
    primaryHref="/contact/demo/"
    primaryLabel="درخواست دمو"
    secondaryHref="/products/"
    secondaryLabel="مشاهده محصولات"
    compact
  />
</BaseLayout>

<style>
  .mission-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--hero-corporate-background);
    color: var(--color-white);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin-block-end: var(--space-md);
    font-size: var(--font-size-h1);
    line-height: 1.2;
  }

  .hero-copy {
    max-width: 38rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .text-link {
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(-0.25rem);
  }

  .hero-panel {
    padding: var(--space-lg);
    border: 0.0625rem solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-md);
  }

  .panel-label {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-panel ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-on-dark);
    line-height: 2;
  }

  .mission-section,
  .vision-section,
  .principles-section {
    padding-block: var(--space-xl);
  }

  .mission-grid,
  .principles-grid {
    display: grid;
    gap: var(--space-md);
  }

  .info-card,
  .principle-card {
    padding: var(--space-md);
    background: var(--color-paper);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .info-card--primary {
    background: var(--color-surface);
    border-color: rgba(239, 63, 35, 0.2);
  }

  .info-card h3,
  .principle-card h3 {
    margin-block-end: 0.75rem;
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  .info-card p,
  .principle-card p,
  .vision-copy p {
    margin: 0;
    color: var(--color-muted);
    line-height: 2;
  }

  .vision-layout {
    display: grid;
    gap: var(--space-lg);
  }

  .vision-points {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-primary);
    line-height: 2;
  }

  @media (min-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }

    .mission-grid,
    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .vision-layout {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
    }
  }
</style>
