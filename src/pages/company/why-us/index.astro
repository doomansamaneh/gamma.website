---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/common/SectionHeading.astro";
import CTA from "../../../components/common/CTA.astro";
---

<BaseLayout
  title="چرا دومان سامانه؟ | دومان سامانه"
  description="دلایل انتخاب دومان سامانه بر پایه تجربه، توسعه مستمر، شناخت نیازهای سازمانی و سبد محصولات متنوع آن."
>
  <section class="whyus-hero">
    <div class="container hero-grid">
      <div>
        <h1>چرا دومان سامانه؟</h1>
        <p class="hero-copy">
          دومان سامانه با تجربه‌ی عملی در ساخت نرم‌افزارهای سازمانی، ترکیب
          مهندسی، شناخت مسئله و توسعه مستمر را برای ایجاد راهکارهای کاربردی به
          کار می‌گیرد.
        </p>
        <div class="actions">
          <a class="button button--accent" href="/contact/demo/">درخواست دمو</a>
          <a class="text-link" href="/company/about/"
            >درباره ما <span aria-hidden="true">←</span></a
          >
        </div>
      </div>
      <div class="hero-panel">
        <div class="panel-label">دلایل اصلی</div>
        <ul>
          <li>تجربه در ساخت نرم‌افزار واقعی</li>
          <li>توسعه محصول، نه پروژه کوتاه‌مدت</li>
          <li>شناخت عمیق نیازهای سازمانی</li>
          <li>سبد محصولات متنوع</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="summary">
    <div class="container">
      <SectionHeading
        title="پاسخ کوتاه"
        description="دومان سامانه به‌خاطر تجربه‌ی عملی در توسعه نرم‌افزارهای سازمانی، نگاه محصول‌محور و مهندسی مستمر، انتخابی مناسب برای سازمان‌هایی است که به راهکارهای قابل اعتماد و قابل توسعه نیاز دارند."
      />

      <div class="summary-copy">
        <p>
          مسیر رشد دومان سامانه از ساخت و بهبود سیستم‌های نرم‌افزاری در
          سازمان‌ها آغاز شد و با گذشت زمان، به مجموعه‌ای از محصولات و پروژه‌های
          تخصصی تبدیل شد. این تجربه باعث شده است که در طراحی و توسعه محصولات، هم
          نیاز کسب و کار و هم کیفیت فنی به‌صورت هم‌زمان در نظر گرفته شود.
        </p>
        <p>
          اگر می‌خواهید درباره ریشه‌ها و مسیر شکل‌گیری شرکت بیشتر بدانید، به بخش
          <a href="/company/about/">درباره ما</a> مراجعه کنید.
        </p>
      </div>
    </div>
  </section>

  <section class="reasons">
    <div class="container">
      <SectionHeading
        title="چرا دومان سامانه را انتخاب کنیم؟"
        description="دلایل اصلی همکاری با دومان سامانه بر پایه تجربه، محصول‌محوری، مهندسی و نگاه بلندمدت شکل گرفته است."
      />

      <div class="reason-grid">
        <article class="reason-card">
          <span class="index">01</span>
          <h3>تجربه واقعی در توسعه نرم‌افزار</h3>
          <p>
            مسیر شرکت از طراحی و توسعه سیستم‌های سازمانی آغاز شد و به‌مرور به
            مجموعه‌ای از محصولات تخصصی تبدیل شد. این تجربه، درک عمیقی از نیازهای
            واقعی کسب و کارها ایجاد کرده است.
          </p>
        </article>

        <article class="reason-card">
          <span class="index">02</span>
          <h3>محصول‌هایی که از مسئله واقعی شکل گرفته‌اند</h3>
          <p>
            محصولات دومان سامانه از نیازهای عملیاتی و سازمانی نشأت می‌گیرند، نه
            صرفاً از یک قالب گرافیکی یا ایده‌ی کلی. این رویکرد باعث می‌شود
            راهکارها به‌جای کپی‌برداری از الگوها، با واقعیت سازمان‌ها هم‌راستا
            باشند.
          </p>
        </article>

        <article class="reason-card">
          <span class="index">03</span>
          <h3>توسعه مستمر و قابل رشد</h3>
          <p>
            نرم‌افزارهای سازمانی باید هم‌زمان با تغییرات فرایندها، قوانین و
            نیازهای کاربران رشد کنند. دومان سامانه این اصل را در توسعه محصولات
            خود در نظر می‌گیرد.
          </p>
        </article>

        <article class="reason-card">
          <span class="index">04</span>
          <h3>دانش عمیق در حوزه‌های مختلف</h3>
          <p>
            مجموعه محصولات شرکت در حوزه‌های مختلف از خدمات فناوری تا دارایی،
            حسابداری و فناوری پایه قرار دارند. این تنوع نشان می‌دهد که تیم فنی و
            مدیریتی با نیازهای متنوع کسب و کارها آشنایی دارد.
          </p>
        </article>

        <article class="reason-card">
          <span class="index">05</span>
          <h3>تمرکز بر کیفیت مهندسی</h3>
          <p>
            در کنار ارزش کسب و کار، کیفیت فنی و قابلیت استفاده برای کاربران نیز
            در اولویت است. این نگاه باعث می‌شود نرم‌افزارها هم از نظر عملکرد و
            هم از نظر تجربه استفاده، مناسب باشند.
          </p>
        </article>

        <article class="reason-card">
          <span class="index">06</span>
          <h3>نگاه بلندمدت به همکاری</h3>
          <p>
            همکاری با دومان سامانه بیشتر از یک پروژه‌ی فنی کوتاه‌مدت است. تمرکز
            بر رشد محصول و هماهنگی با نیازهای آینده، پایه‌ای برای همکاری‌های
            مستمر و سازگار می‌سازد.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="fit">
    <div class="container fit-grid">
      <div>
        <SectionHeading
          title="برای چه سازمان‌هایی مناسب است؟"
          description="دومان سامانه برای سازمان‌هایی مناسب است که نرم‌افزار به یک ابزار عملی برای مدیریت فرایندها، کنترل عملکرد و تصمیم‌گیری تبدیل می‌شود."
        />
      </div>
      <div class="fit-list">
        <ul>
          <li>سازمان‌هایی با فرایندهای پیچیده و نیاز به نظم بیشتر</li>
          <li>کسب و کارهایی که به توسعه مستمر نرم‌افزار وابسته‌اند</li>
          <li>واحدهای فناوری و خدماتی که به راهکارهای سازمانی نیاز دارند</li>
          <li>
            شرکت‌هایی که به جای پروژه‌های کوتاه‌مدت، به مسیر بلندمدت می‌اندیشند
          </li>
        </ul>
      </div>
    </div>
  </section>

  <CTA
    title="اگر به دنبال یک شریک فنی و محصول‌محور هستید، با ما صحبت کنید."
    text="دومان سامانه می‌تواند در کنار سازمان شما، راهکارهای مناسب برای فرایندهای عملیاتی و نیازهای دیجیتال را طراحی و توسعه دهد."
    primaryHref="/contact/demo/"
    primaryLabel="درخواست دمو"
    secondaryHref="/products/"
    secondaryLabel="مشاهده محصولات"
    compact
  />
</BaseLayout>

<style>
  .whyus-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--hero-corporate-background);
    color: var(--color-white);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin-block-end: var(--space-md);
    font-size: var(--font-size-h1);
    line-height: 1.2;
  }

  .hero-copy {
    max-width: 38rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .text-link {
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(-0.25rem);
  }

  .hero-panel {
    padding: var(--space-lg);
    border: 0.0625rem solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-md);
  }

  .panel-label {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-panel ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-on-dark);
    line-height: 2;
  }

  .summary,
  .reasons,
  .fit {
    padding-block: var(--space-xl);
  }

  .summary-copy {
    display: grid;
    gap: var(--space-md);
    color: var(--color-muted);
    font-size: 1.125rem;
    line-height: 2;
  }

  .summary-copy a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .reason-grid {
    display: grid;
    gap: var(--space-md);
  }

  .reason-card {
    padding: var(--space-md);
    background: var(--color-paper);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .index {
    display: inline-block;
    margin-block-end: 0.75rem;
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: 800;
  }

  .reason-card h3 {
    margin-block-end: 0.75rem;
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  .reason-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 2;
  }

  .fit-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .fit-list ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-primary);
    line-height: 2;
  }

  @media (min-width: 48rem) {
    .hero-grid,
    .fit-grid {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }

    .reason-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
