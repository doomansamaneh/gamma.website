---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/common/SectionHeading.astro";
import CTA from "../../../components/common/CTA.astro";
---

<BaseLayout
  title="درباره ما | دومان سامانه"
  description="درباره دومان سامانه، ریشه‌های شرکت، رشد محصولات و شیوه‌ای که در توسعه نرم‌افزارهای سازمانی به‌کار می‌گیرد."
>
  <section class="about-hero">
    <div class="container hero-grid">
      <div>
        <!-- <p class="eyebrow">دومان سامانه</p> -->

        <h1>تجربه، توسعه و ساخت نرم‌افزار برای کسب و کارها و سازمان‌ها</h1>

        <p class="hero-copy">
          دومان سامانه یک شرکت نرم‌افزاری محصول‌محور است که فعالیت خود را با
          اجرای پروژه‌های نرم‌افزاری و توسعه راهکارهای سازمانی آغاز کرد و امروز
          مجموعه‌ای از محصولات تخصصی را در حوزه‌های مدیریت خدمات، مدیریت دارایی،
          حسابداری و فناوری نرم‌افزار توسعه می‌دهد.
        </p>

        <div class="actions">
          <a class="button button--accent" href="/products/">
            مشاهده محصولات
          </a>

          <a class="text-link" href="/contact/">
            تماس با ما <span aria-hidden="true">←</span>
          </a>
        </div>
      </div>

      <div class="hero-panel" aria-label="مسیر توسعه دومان سامانه">
        <div class="panel-label">مسیر ما</div>

        <ul>
          <li>تجربه</li>
          <li>توسعه</li>
          <li>محصول</li>
          <li>پلتفرم</li>
        </ul>

        <div class="panel-products">
          <span>Gamma Help Desk</span>
          <span>ZED EAM</span>
          <span>Landa</span>
          <span>Gamma.Kernel</span>
        </div>
      </div>
    </div>
  </section>

  <section class="company-intro">
    <div class="container intro-grid_">
      <div>
        <SectionHeading
          eyebrow="شرکت"
          title="ما که هستیم؟"
          description="دومان سامانه حاصل سال‌ها تجربه در طراحی، توسعه و پشتیبانی نرم‌افزارهای مورد استفاده در سازمان‌هاست."
        />
      </div>

      <div class="intro-copy">
        <p>
          دومان سامانه فعالیت خود را با طراحی، توسعه و بهبود سیستم‌های
          نرم‌افزاری برای سازمان‌ها آغاز کرد. این تجربه به ما آموخت که نرم‌افزار
          سازمانی فقط مجموعه‌ای از قابلیت‌ها نیست؛ بلکه باید پایدار، قابل توسعه،
          قابل اعتماد و متناسب با فرآیندهای واقعی کسب و کار باشد.
        </p>

        <p>
          به‌تدریج این تجربه از اجرای پروژه‌های نرم‌افزاری به سمت توسعه محصولات
          مستقل حرکت کرد. امروز این مسیر در قالب محصولاتی مانند Gamma Help Desk،
          ZED EAM، Landa و Gamma.Kernel ادامه دارد؛ محصولاتی که هرکدام بخشی از
          نیازهای واقعی کسب و کارها و سازمان‌ها را هدف قرار می‌دهند.
        </p>
      </div>
    </div>
  </section>

  <section class="story">
    <div class="container">
      <SectionHeading
        title="داستان ما"
        description="از یک ایده‌ی فنی تا مجموعه‌ای از محصولاتی که امروز در اختیار سازمان‌ها قرار می‌گیرد."
      />

      <div class="timeline">
        <article class="timeline-item">
          <span class="year">۱۳۸۶</span>
          <div>
            <h3>آغاز فعالیت</h3>
            <p>
              دومان سامانه فعالیت خود را با تحلیل، طراحی و توسعه نرم‌افزارهای
              سازمانی آغاز کرد و مسیر توسعه محصول را بر پایه نیازهای واقعی کسب و
              کار بنا نهاد.
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <span class="year">۱۳۸۹</span>
          <div>
            <h3>نخستین همکاری‌های مهم</h3>
            <p>
              یکی از مهم‌ترین گام‌ها، استقرار اولیه سیستم گاما در بانک رفاه بود؛
              تجربه‌ای که نشان داد نرم‌افزارهای سازمانی باید هم از نظر فرآیند و
              هم از نظر عملکرد، با ساختار واقعی سازمان‌ها هماهنگ باشند.
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <span class="year">دهه ۹۰</span>
          <div>
            <h3>گسترش قابلیت‌ها</h3>
            <p>
              با گذشت زمان، گاما از سیستم درخواست و مدیریت خدمات به یک راهکار
              فراگیرتر با قابلیت‌های مدیریت دارایی، موجودی قطعات و عملیات مرتبط
              توسعه پیدا کرد.
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <span class="year">امروز</span>
          <div>
            <h3>سبد محصولات چندگانه</h3>
            <p>
              امروز دومان سامانه با محصولاتی مانند GammaItsm، ZED EAM، Landa و
              Gamma.Kernel، در حوزه‌های مختلف نرم‌افزارهای سازمانی و فناوری فعال
              است و هر کدام با تمرکز خاصی توسعه یافته‌اند.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="portfolio">
    <div class="container">
      <SectionHeading
        title="از یک محصول تا سبدی متنوع"
        description="تجربه‌ی ساخت و بهبود سیستم‌های عملی، پایه‌ای برای شکل‌گیری راهکارهای تخصصی امروز شد."
      />

      <div class="portfolio-grid">
        <article class="portfolio-card">
          <span class="card-tag">GammaItsm</span>
          <h3>مدیریت خدمات و عملیات فناوری</h3>
          <p>
            یک محصول سازمانی برای مدیریت درخواست‌ها، خدمات، مشکلات، تغییرات و
            فرآیندهای ITIL.
          </p>
        </article>

        <article class="portfolio-card">
          <span class="card-tag">ZED EAM</span>
          <h3>مدیریت دارایی‌های سازمانی</h3>
          <p>
            راهکاری برای دید بهتر بر دارایی‌ها، نگهداری، ردیابی و بهره‌برداری از
            منابع فیزیکی و فناوری.
          </p>
        </article>

        <article class="portfolio-card">
          <span class="card-tag">Landa</span>
          <h3>نرم‌افزار حسابداری و کسب و کار</h3>
          <p>
            پلتفرمی برای کسب و کارهای کوچک و متوسط که به ابزارهای ساده و کاربردی
            برای عملیات مالی و مدیریتی نیاز دارند.
          </p>
        </article>

        <article class="portfolio-card">
          <span class="card-tag">Gamma.Kernel</span>
          <h3>فناوری پایه و توسعه نرم‌افزار</h3>
          <p>
            بخشی از تمرکز فنی دومان سامانه بر توسعه زیرساخت‌ها و پروژه‌های
            فناوری باز و کتابخانه‌های نرم‌افزاری است.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="approach">
    <div class="container">
      <SectionHeading
        title="چگونه کار می‌کنیم؟"
        description="در دومان سامانه، توسعه نرم‌افزار به عنوان یک فرایند مستمر و وابسته به نیاز واقع سازمان‌ها دیده می‌شود."
      />

      <div class="feature-grid">
        <article class="feature-item">
          <h3>درک مسئله</h3>
          <p>
            از نیازهای عملیاتی و روندهای سازمانی شروع می‌کنیم و با شناخت دقیق،
            مسئله را تعریف می‌کنیم.
          </p>
        </article>
        <article class="feature-item">
          <h3>طراحی مناسب</h3>
          <p>
            فرآیندها، نقش‌ها و جریان‌های کاری را به‌صورت شفاف و اجرایی مدل‌سازی
            می‌کنیم.
          </p>
        </article>
        <article class="feature-item">
          <h3>توسعه مستمر</h3>
          <p>
            محصولات ما با دید بلندمدت ساخته می‌شوند و در مسیر رشد سازمان‌ها
            به‌روزرسانی می‌شوند.
          </p>
        </article>
        <article class="feature-item">
          <h3>کاربرد عملی</h3>
          <p>
            همواره تمرکز بر استفاده واقعی کاربران و ارزش کسب‌شده برای سازمان‌ها
            در اولویت است.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="container values-grid_">
      <div>
        <SectionHeading
          title="ماموریت و چشم‌انداز"
          description="مرکز ثقل فعالیت ما، توسعه نرم‌افزارهایی است که در عمل برای سازمان‌ها کاربرد دارند."
        />
      </div>
      <div class="value-cards">
        <article class="value-card">
          <h3>ماموریت</h3>
          <p>
            طراحی و توسعه راهکارهای نرم‌افزاری برای سازمان‌هایی که به دنبال
            عملکرد بهتر، کنترل بیشتر و بهره‌وری بالاتر هستند.
          </p>
        </article>
        <article class="value-card">
          <h3>چشم‌انداز</h3>
          <p>
            رشد به عنوان یک شرکت فناور با محصولات قابل‌اعتماد و تیمی فنی که به
            توسعه مستمر در حوزه کسب و کار و فناوری باور دارد.
          </p>
        </article>
      </div>
    </div>
  </section>

  <CTA
    title="برای آشنایی بیشتر با محصولات و راهکارهای دومان سامانه، با ما صحبت کنید."
    text="اگر به دنبال راه‌حل‌هایی برای نیازهای سازمانی، خدمات فناوری یا توسعه محصول هستید، تیم ما آماده همکاری است."
    primaryHref="/contact/demo/"
    primaryLabel="درخواست دمو"
    secondaryHref="/products/"
    secondaryLabel="مشاهده محصولات"
    compact
  />
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--hero-corporate-background);
    color: var(--color-white);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin-block-end: var(--space-md);
    font-size: var(--font-size-h1);
    line-height: 1.2;
  }

  .hero-copy {
    max-width: 38rem;
    margin-block-end: var(--space-lg);
    color: var(--color-text-on-dark);
    font-size: 1.125rem;
  }

  .panel-products {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .panel-products span {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .panel-products span:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .text-link {
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(-0.25rem);
  }

  .hero-panel {
    padding: var(--space-lg);
    border: 0.0625rem solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-md);
  }

  .panel-label {
    margin-block-end: var(--space-sm);
    color: var(--color-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-panel ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-on-dark);
    line-height: 2;
  }

  .company-intro,
  .story,
  .portfolio,
  .approach,
  .values {
    padding-block: var(--space-md);
  }

  .intro-grid,
  .values-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 1.25rem;
    color: var(--color-muted);
    font-size: 1.125rem;
    line-height: 2;
  }

  .intro-copy p {
    margin: 0;
  }

  .timeline {
    display: grid;
    gap: var(--space-md);
  }

  .timeline-item {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--color-surface);
    border-inline-start: 0.25rem solid var(--color-primary);
  }

  .year {
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: 800;
  }

  .timeline-item h3,
  .portfolio-card h3,
  .feature-item h3,
  .value-card h3 {
    margin-block-end: 0.5rem;
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  .timeline-item p,
  .portfolio-card p,
  .feature-item p,
  .value-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 2;
  }

  .portfolio-grid,
  .feature-grid {
    display: grid;
    gap: var(--space-md);
  }

  .portfolio-card,
  .feature-item,
  .value-card {
    padding: var(--space-md);
    background: var(--color-paper);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .card-tag {
    display: inline-block;
    margin-block-end: 0.75rem;
    color: var(--color-accent-dark);
    font-size: var(--font-size-small);
    font-weight: 800;
  }

  .value-cards {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .hero-grid,
    .intro-grid,
    .values-grid {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }

    .timeline-item {
      grid-template-columns: 8rem 1fr;
      align-items: start;
    }

    .portfolio-grid,
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
